#!/usr/bin/env bash
# check-migration-drift — fail-closed deploy gate for Supabase schema drift (#1095)
#
# Compares repo migration version prefixes (supabase/migrations/*.sql) against
# the linked project's applied set (supabase_migrations.schema_migrations via
# the Supabase Management API). Blocks deploys when the repo has pending
# table/column/function/unique-index migrations that prod lacks — the #1001
# failure class (code shipped reading columns whose migration never applied).
#
# Usage:
#   bash .github/scripts/check-migration-drift
#
# Env:
#   SUPABASE_ACCESS_TOKEN  (required) — repo secret; Bearer token for the
#                          Management API (the same token-based path
#                          supabase-deploy uses since #883)
#   DRIFT_API_URL          (optional) — default https://api.supabase.com
#   DRIFT_PROJECT_REF      (optional) — default ybetwichurajbfswfeqa
#   DRIFT_CURL             (optional) — curl command override (test seam)
#   DRIFT_MIGRATIONS_DIR   (optional) — migrations dir (test seam; default
#                          <repo>/supabase/migrations)
#   DRIFT_BASE_SHA         (optional) — not used by this script (see
#                          check-migration-append-only)
#
# Exit codes (mirrors verify-cutover convention):
#   0 — clean, or only warn-class drift (index-only) / remote-ahead
#   1 — repo-ahead BLOCKING drift (table/column/function/unique-index)
#   2 — could not determine state (missing token, API error, parse failure,
#       or a duplicate prefix whose files could not be enumerated — the report
#       would otherwise name a remedy with no operand)
#
# Fail-closed by contract: any error exits 2 with an actionable message. A
# missing secret must fail the deploy, not silently skip the gate.
set -euo pipefail
# Byte-deterministic collation: the version set-diff (sort/comm) and the
# out-of-order ordering comparison below both sort raw version strings. The
# Supabase CLI sequences migration files by filename, so the lexical (= byte)
# order here matches the order `supabase db push` would apply them in.
export LC_ALL=C

REPO_ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")/../.." && pwd)"
API_URL="${DRIFT_API_URL:-https://api.supabase.com}"
PROJECT_REF="${DRIFT_PROJECT_REF:-ybetwichurajbfswfeqa}"
MIGRATIONS_DIR="${DRIFT_MIGRATIONS_DIR:-$REPO_ROOT/supabase/migrations}"
CURL="${DRIFT_CURL:-curl}"

# ── 1. Preconditions (fail-closed) ────────────────────────────────────────
if [ -z "${SUPABASE_ACCESS_TOKEN:-}" ] && [ -z "${DRIFT_TOKEN:-}" ]; then
  echo "check-migration-drift: SUPABASE_ACCESS_TOKEN not set — cannot verify migration state (exit 2)" >&2
  exit 2
fi
TOKEN="${DRIFT_TOKEN:-$SUPABASE_ACCESS_TOKEN}"

if [ ! -d "$MIGRATIONS_DIR" ]; then
  echo "check-migration-drift: migrations dir not found: $MIGRATIONS_DIR (exit 2)" >&2
  exit 2
fi

# ── 2. Local version set (CLI key rule: everything before first _) ────────
# Matches the Supabase CLI's migrateFilePattern ^([0-9]+)_(.*)\.sql$.
# -n + p drops non-conforming files (the CLI skips them too); they are
# reported separately below since they'd be applied by NOBODY.
# Duplicate detection BEFORE dedup: two files sharing a version prefix are the
# 0012x2/0015x2 class that ABORTS `supabase db push` entirely (#1001 root cause).
# sort -u would collapse them here, masking the pending state (the
# 20260813000005 incident, #1235) — so detect and report them explicitly.
LOCAL_ALL_VERSIONS="$(
  ls "$MIGRATIONS_DIR"/*.sql 2>/dev/null \
    | sed -nE 's#.*/([0-9]+)_.*#\1#p'
)"
DUP_LOCAL_VERSIONS="$(
  printf '%s\n' "$LOCAL_ALL_VERSIONS" \
    | sort \
    | uniq -d
)"
LOCAL_VERSIONS="$(printf '%s\n' "$LOCAL_ALL_VERSIONS" | sort -u)"
NON_CONFORMING="$(
  ls "$MIGRATIONS_DIR"/*.sql 2>/dev/null \
    | sed -nE 's#.*/([^0-9][^/]*\.sql|[0-9]+[^_/]*\.sql)$#\1#p' \
    | sort -u
)"

# ── 3. Remote version set (Management API, fail-closed) ───────────────────
QUERY='{"query":"SELECT version FROM supabase_migrations.schema_migrations ORDER BY version"}'
API_RESPONSE="$("$CURL" -s -w '\n%{http_code}' -X POST \
  "$API_URL/v1/projects/$PROJECT_REF/database/query" \
  -H "Authorization: Bearer $TOKEN" \
  -H "Content-Type: application/json" \
  -d "$QUERY" 2>&1 || true)"
HTTP_CODE="$(printf '%s' "$API_RESPONSE" | tail -n1)"
API_BODY="$(printf '%s' "$API_RESPONSE" | sed '$d')"

if [ "$HTTP_CODE" != "200" ] && [ "$HTTP_CODE" != "201" ]; then
  echo "check-migration-drift: Management API returned HTTP $HTTP_CODE — cannot determine migration state (exit 2)" >&2
  printf '%s\n' "${API_BODY:0:400}" >&2
  echo "" >&2
  exit 2
fi

REMOTE_VERSIONS="$(
  printf '%s' "$API_BODY" \
    | jq -e 'type == "array"' >/dev/null 2>&1 \
    && printf '%s' "$API_BODY" | jq -r '.[].version' 2>/dev/null | sort -u \
    || { echo "check-migration-drift: API response was not a JSON array — cannot determine migration state (exit 2)" >&2; exit 2; }
)"
# jq exit propagation: if the type-assert or extraction failed, we must exit 2.
# BUT an empty remote set (fresh project / zero applied migrations) is a
# legitimate state — every repo migration is repo-ahead (exit 1, not 2).
if [ -z "$REMOTE_VERSIONS" ] && ! printf '%s' "$API_BODY" | jq -e 'type == "array"' >/dev/null 2>&1; then
  echo "check-migration-drift: could not extract remote migration versions (exit 2)" >&2
  exit 2
fi

# ── 4. Diff ───────────────────────────────────────────────────────────────
REPO_AHEAD="$(comm -23 <(printf '%s\n' "$LOCAL_VERSIONS") <(printf '%s\n' "$REMOTE_VERSIONS"))"
REMOTE_AHEAD="$(comm -13 <(printf '%s\n' "$LOCAL_VERSIONS") <(printf '%s\n' "$REMOTE_VERSIONS"))"

# ── 5. DDL classification (block-first precedence) ────────────────────────
# For each repo-ahead migration, classify by content:
#   block-class — table/column/function/trigger/unique-index/primary-key/
#                 exclude/DO-block/unparseable → BLOCK the deploy
#   warn-class  — plain non-unique CREATE INDEX only → warn (app can't read
#                 an index; a pending index is not a correctness dependency)
# Comment-stripped + case-insensitive (SQL keywords are case-insensitive).
BLOCKING=""
WARN_ONLY=""
for v in $REPO_AHEAD; do
  f="$(ls "$MIGRATIONS_DIR"/${v}_*.sql 2>/dev/null | head -n1 || true)"
  # A repo-ahead version with no resolvable file cannot be classified — block
  # it (fail-closed) rather than dropping it, so the BLOCKING count always
  # accounts for every repo-ahead version and the completeness note cannot lie.
  if [ -z "$f" ]; then
    BLOCKING="$BLOCKING $v"
    continue
  fi
  # strip -- and /* */ comments (line-scoped; multi-line /* */ is a known
  # limitation — over-blocks fail-closed, never under-blocks), then test block
  # patterns first
  if grep -iE "create unique index|primary key|add constraint .*unique|exclude using|create table|alter table|create or replace function|create trigger|do \$\$|create policy|create type|create view" "$f" \
      | sed -E 's/--.*$//; s!/\*.*\*/!!g' \
      | grep -iE "create unique index|primary key|add constraint .*unique|exclude using|create table|alter table|create or replace function|create trigger|do \$\$|create policy|create type|create view" >/dev/null; then
    BLOCKING="$BLOCKING $v"
  elif grep -iE "create index" "$f" | sed -E 's/--.*$//' | grep -iE "create index" >/dev/null; then
    WARN_ONLY="$WARN_ONLY $v"
  else
    BLOCKING="$BLOCKING $v"
  fi
done

# ── 6. Report + exit ──────────────────────────────────────────────────────
# Newest version prod has already applied — the ordering reference. String
# comparison (not `[ -lt ]`, which parses leading zeros as octal and is wrong
# for the variable-width prefixes this repo allows). An empty remote set (fresh
# project) means nothing is applied yet, so no repo-ahead version is out of
# order. A blocking version that sorts BEFORE this reference cannot be applied
# as-is: `supabase db push --include-all` applies the whole repo-pending set in
# filename order, so it would land on top of a later migration (#4278).
REMOTE_MAX="$(printf '%s\n' "$REMOTE_VERSIONS" | sort | tail -n1)"
BLOCK_SAFE=""
BLOCK_OOO=""
for v in $BLOCKING; do
  if [ -n "$REMOTE_MAX" ] && [[ "$v" < "$REMOTE_MAX" ]]; then
    BLOCK_OOO="$BLOCK_OOO $v"
  else
    BLOCK_SAFE="$BLOCK_SAFE $v"
  fi
done
REPO_AHEAD_N="$(printf '%s' "$REPO_AHEAD" | wc -w | tr -d ' ')"
BLOCKING_N="$(printf '%s' "$BLOCKING" | wc -w | tr -d ' ')"

echo "check-migration-drift: repo migrations vs prod (project $PROJECT_REF)"
if [ -n "$REMOTE_AHEAD" ]; then
  echo "  remote-ahead (WARN, safe direction — repo code can't depend on objects the repo doesn't know): $REMOTE_AHEAD"
fi
if [ -n "$NON_CONFORMING" ]; then
  echo "  non-conforming migration filenames (applied by NOBODY — rename to ^[0-9]+_ pattern): $NON_CONFORMING" >&2
fi
# Warn-class is repo-ahead but not blocking, so it is absent from the BLOCKING
# list below — yet `supabase db push --include-all` still pushes it. Report it
# before any exit so a short blocking list is never read as the whole job.
if [ -n "$WARN_ONLY" ]; then
  echo "  warn-only repo-ahead migrations (index-only, no data-correctness dependency): not order-checked — --include-all still applies them in filename order: $WARN_ONLY"
fi
# Say what repo-ahead does NOT establish, before ANY exit prescribes an action.
# ⛔ TWO STATEMENTS, TWO DIFFERENT AUDIENCES — do not merge them again.
# (1) The DIAGNOSIS is about repo-ahead, so it prints only when there IS
#     repo-ahead. Printing it on a duplicate-prefix exit whose version is
#     already recorded (#1235 shape, zero repo-ahead) tells the reader
#     "Bookkeeping drift … produces exactly this report" about a report that
#     contains no repo-ahead section and whose version IS recorded — the
#     opposite of bookkeeping drift — inviting the "repair the version" misread
#     that leaves the duplicate in place and the next `db push` aborting
#     (review finding, #9613).
# (2) The OWNER BOUND is about every remedy below that mutates prod, so it
#     prints on both red exits (`$BLOCKING` and `$DUP_LOCAL_VERSIONS`) and on
#     neither green one — a warn-only (index-only) repo-ahead run EXITS 0, and
#     attaching a red-diagnosis note to a green report is the same imprecision
#     this change removes (measured: the warn-only fixture printed the note
#     above "OK (no blocking drift)").
if [ -n "$REPO_AHEAD" ] && { [ -n "$BLOCKING" ] || [ -n "$DUP_LOCAL_VERSIONS" ]; }; then
  echo "  note: 'repo-ahead' means prod has no schema_migrations ROW — NOT that prod lacks"
  echo "        the objects."
fi
# The SENTENCE BELOW names the report it explains, so it prints only when THAT
# report is the one on screen: repo-ahead with NO duplicate prefix. `$BLOCKING`
# alone is not enough — a duplicate prefix whose files are block-class (ALTER
# TABLE/DO block/…) is a `$BLOCKING` member too, and that branch exits BEFORE any
# repo-ahead list is printed, so the sentence would claim bookkeeping drift
# "produces exactly this report" about a report it cannot produce, re-opening the
# misread this note exists to close: record the version, instead of renaming the
# colliding file (#9613 review rounds 5 and 6).
if [ -n "$BLOCKING" ] && [ -z "$DUP_LOCAL_VERSIONS" ]; then
  echo "        Bookkeeping drift (DDL applied outside 'supabase db push',"
  echo "        so the version was never recorded) produces exactly this report (#9613)."
fi
if [ -n "$BLOCKING" ] || [ -n "$DUP_LOCAL_VERSIONS" ]; then
  echo "  ⛔ OWNER-ONLY for any remedy below that runs DDL DIRECTLY, or 'migration repair':"
  echo "     a lane must not run prod DDL or repair, and no auto-dispatch exists (#2240)."
  # ... and the sanctioned-lane line only where a dispatch line is actually printed.
  # The all-out-of-order state (BLOCK_SAFE empty) deliberately prints NO apply
  # command — its whole point is "do NOT apply these as-is" (#4278) — so naming
  # supabase-deploy there both referenced nothing "(below)" and re-offered the
  # action the gate refuses (#9613 review round 7).
  if [ -n "$DUP_LOCAL_VERSIONS" ] || [ -n "$BLOCK_SAFE" ]; then
    echo "     Dispatching supabase-deploy IS the lane-sanctioned path (runbook §8.6)."
  fi
fi

if [ -n "$DUP_LOCAL_VERSIONS" ]; then
  echo "  BLOCKING duplicate migration version prefixes (abort \`supabase db push\` AND mask drift state — see #1235):"
  for v in $DUP_LOCAL_VERSIONS; do
    files=""
    n_files=0
    # ⛔ NUL-SAFE ENUMERATION: a filename may contain a space (accepted by the
    # CLI pattern ^[0-9]+_(.*)\.sql$) and, pathologically, a newline/quote.
    # `xargs`, `basename` and unquoted globbing split those into a broken command
    # (rounds 7-8); a raw echo also rendered a newline name across two lines
    # (round 9), so every printed name goes through %q.
    # `find -L`: `DRIFT_MIGRATIONS_DIR` (a test seam) may be a symlink; without
    # dereferencing, the listing came out EMPTY while detection still saw the
    # duplicate — a report with no operand and a remedy pointing at nothing
    # (round-9 finding).
    while IFS= read -r -d '' p; do
      n_files=$((n_files + 1))
      printf -v q '%q' "${p##*/}"
      files="${files:+$files }$q"
    done < <(find -L "$MIGRATIONS_DIR" -maxdepth 1 -name "${v}_*.sql" -print0 2>/dev/null | sort -z)
    # ⛔ FAIL CLOSED: `sort -z` is not POSIX, and a process substitution's failure
    # does not propagate under `pipefail`. If enumeration yields nothing for a
    # prefix that WAS detected, the report cannot be trusted (it would print a
    # remedy with no operand) — refuse rather than print it (round-9 finding).
    if [ "$n_files" -eq 0 ]; then
      echo "check-migration-drift: could not enumerate files at duplicate prefix $v — refusing to print a remedy (exit 2)" >&2
      exit 2
    fi
    echo "    - $v  [$files]"
  done
  # ⛔ THE OPERANDS ARE THE ACTUAL FILES, NEVER `${v}_b.sql` (review rounds 5-7).
  # The printed remedy was `git mv ${v}_a.sql ${v}_b.sql`, which renames one
  # duplicate ONTO the other — "fatal: destination exists" (rc 128) — and its
  # replacement `${v}_b.sql → <next-free>_b.sql` was runnable only for filenames
  # literally shaped `_a`/`_b` (the test fixture's shape). Every duplicate in this
  # repo's history is DESCRIPTIVELY named (0011, 0012, 0015, 20261022000001 today
  # — measured across all 149 commits touching supabase/migrations: the max ever
  # seen at one prefix is TWO files), so a hardcoded `_b` aborts with
  # "fatal: bad source". Print the real name of every file but the first, per
  # prefix, with the migrations path so the command runs from the repo root.
  # ⛔ THE GUIDANCE MUST MATCH THE OPERAND LIST IT DESCRIBES. A prefix holding N
  # files gets N-1 `(a)` lines, so "run exactly ONE line per prefix" was wrong for
  # N>=3: following it left a live duplicate, the next `db push` aborted on it and
  # the gate was red again (#1235) — the failure this block exists to prevent.
  # `(b)` is an alternative only at two files (the only arity it is printed for).
  echo "  Rename operand(s) — at each prefix above keep ONE file. A prefix holding N"
  echo "  files gets N-1 (a) lines: run EVERY (a) line for that prefix. Where the prefix"
  echo "  holds two files, (b) is the other choice — run (b) INSTEAD of (a) when prod"
  echo "  already has the second file's DDL ('supabase db diff --linked')."
  echo "  Operands are shell-quoted; replace NEXTFREE<n> with a free NUMERIC prefix"
  echo "  (^[0-9]+_) — ONE per operand — and run from the repo root:"
  dup_n=0
  for v in $DUP_LOCAL_VERSIONS; do
    names=()
    while IFS= read -r -d '' p; do
      names+=("${p##*/}")
    done < <(find -L "$MIGRATIONS_DIR" -maxdepth 1 -name "${v}_*.sql" -print0 2>/dev/null | sort -z)
    n_pref=${#names[@]}
    [ "$n_pref" -ge 2 ] || continue
    # (a) the default: keep the FIRST listed file, move the rest.
    i=1
    while [ "$i" -lt "$n_pref" ]; do
      dup_n=$((dup_n + 1))
      name="${names[$i]}"
      slug="${name#${v}_}"
      printf '    (a) git mv %q %q\n' "supabase/migrations/$name" \
        "supabase/migrations/NEXTFREE${dup_n}_$slug"
      i=$((i + 1))
    done
    # (b) the inverted choice, only when the prefix holds exactly two files: if
    # prod already has the SECOND file's DDL, the first is the one to move.
    # Printing only (a) handed the reader a command that performs the outcome the
    # note above forbids, with no line for the other choice (round-9 finding).
    if [ "$n_pref" -eq 2 ]; then
      dup_n=$((dup_n + 1))
      name="${names[0]}"
      slug="${name#${v}_}"
      printf '    (b) git mv %q %q\n' "supabase/migrations/$name" \
        "supabase/migrations/NEXTFREE${dup_n}_$slug"
    fi
  done
  # ⛔ THE GATE CANNOT SEE WHICH FILE'S DDL PROD ALREADY HAS. When the colliding
  # version IS recorded, "keep the first listed one" can keep the file that never
  # applied and move the one that did: the moved file's DDL re-runs (this repo's
  # migrations are idempotent, so it passes silently), the kept file's DDL is
  # NEVER applied, and the next run is green because the version is recorded —
  # the silent #1001 loss this gate exists to prevent. Same limit the OUT OF
  # ORDER block states; it belongs here too (round-8 review finding).
  # Gated on prod having ANY applied history, NOT on `-z "$BLOCK_OOO"`: an
  # unrelated out-of-order version suppressed this warning in exactly the state it
  # describes (a duplicate whose version IS recorded — round-9 finding), and
  # `supabase migration list --linked` cannot answer "which file" (it lists
  # VERSIONS; only a schema diff can tell the two files' DDL apart).
  if [ -n "$REMOTE_MAX" ]; then
    echo "  ⚠️ Which file to KEEP is a prod question this gate cannot answer: run"
    echo "     'supabase db diff --linked' and keep the one whose objects prod already has,"
    echo "     then run that prefix's operand lines above — every (a) line, or (b) instead"
    echo "     of (a) when the prefix holds two files."
  fi
  echo "    Repeat until ONE file remains at each prefix above — a prefix that still"
  echo "    collides is re-listed by the next run."
  if [ -n "$BLOCK_OOO" ]; then
    # The same refusal applies here: once the rename is done the deploy still
    # runs `--include-all` over the WHOLE repo-pending set, so a repo-ahead
    # version older than prod's newest applied would be applied out of order
    # (#4278). Name it before the apply step, and require the rename target to
    # sort after REMOTE_MAX so the renamed file is not itself out of order.
    echo "  OUT OF ORDER after the rename (older than prod's newest applied version $REMOTE_MAX) — resolve these FIRST:$BLOCK_OOO"
    echo '    The deploy runs `supabase db push --include-all`, which applies the whole repo-pending set.'
    echo "  Remediation (in this order):"
    echo "    1. rename every operand printed above for each prefix — every (a) line, or"
    echo "       (b) instead of (a) when the prefix holds two files — to free prefixes that"
    echo "       sort AFTER $REMOTE_MAX;"
    echo "    2. resolve each OUT OF ORDER version above (never applied -> forward migration;"
    echo "       already applied but unrecorded -> supabase migration repair --linked"
    echo "       --status applied <version> — OWNER ACTION, a lane must not run prod DDL"
    echo "       or repair, #2240);"
    echo "    3. then apply via supabase-deploy dispatch."
  else
    echo "  Remediation: pure-prefix rename — move the operand(s) printed above to a free"
    if [ -n "$REMOTE_MAX" ]; then
      echo "    prefix that sorts AFTER $REMOTE_MAX (content unchanged: an earlier prefix"
      echo "    would be applied out of order by --include-all, #4278), then apply via"
      echo "    supabase-deploy dispatch."
    else
      echo "    prefix (content unchanged), then apply via supabase-deploy dispatch."
    fi
  fi
  exit 1
fi
if [ -n "$BLOCKING" ]; then
  # ⛔ THE HEADING STATES ONLY WHAT WAS MEASURED. Repo-ahead is a set difference
  # of version STRINGS against `supabase_migrations.schema_migrations`: it proves
  # prod has no ROW for these versions, and it proves NOTHING about whether the
  # objects exist. It used to read "(pending in repo, NOT applied to prod)", and
  # #9613 measured that claim FALSE in a live instance: prod served
  # `blog_posts.author_image_url` — a column
  # `20261021000001` adds — from the live blog (`/blog/state-of-agentic-memory-2026`,
  # rendered per request, reading project ybetwichurajbfswfeqa) while this gate
  # reported that same version as "NOT applied to prod". A reader who believes the
  # old heading runs DDL that is already in place; a reader who knows better has
  # no remedy here at all, because this branch withheld the DDL-free one.
  echo "  BLOCKING repo-ahead migrations (repo has them; prod's supabase_migrations.schema_migrations has NO row):"
  for v in $BLOCKING; do echo "    - $v"; done
  # Say whether this list is the whole repo-pending set or a filtered subset:
  # the heading alone reads as "the work", but `--include-all` also pushes the
  # warn-class members reported above, which are not listed here (#4278).
  if [ "$BLOCKING_N" = "$REPO_AHEAD_N" ]; then
    echo "  note: BLOCKING list above is the COMPLETE repo-ahead set — $BLOCKING_N of $REPO_AHEAD_N repo-ahead pending"
  else
    echo "  note: BLOCKING list above is a FILTERED subset of repo-ahead — $BLOCKING_N of $REPO_AHEAD_N repo-ahead pending; non-blocking members are not listed but are still pushed by --include-all"
  fi

  if [ -n "$BLOCK_OOO" ]; then
    echo "  OUT OF ORDER (sort before prod's newest applied version $REMOTE_MAX) — do NOT apply these as-is:"
    for v in $BLOCK_OOO; do echo "    - $v"; done
    echo "    Applying one now lands it ON TOP of its successor, which is the state"
    echo "    this gate just refused. Decide per version FROM PROD — the gate cannot"
    echo "    tell 'never applied' from 'applied but not recorded':"
    echo "      (a) never applied: re-land its DDL as a FORWARD migration with the next"
    echo "          free prefix, so it sorts after $REMOTE_MAX, and drop/rename the"
    echo "          original file so it is no longer repo-ahead;"
    echo "      (b) already in prod with no schema_migrations row: record it WITHOUT"
    echo "          running DDL — supabase migration repair --linked --status applied <version>"
    echo "          (OWNER ACTION — a lane must not run prod DDL or repair, #2240)"
    echo "    A blanket repair hides real drift (#1001) — verify in prod first."
  fi

  if [ -n "$BLOCK_SAFE" ]; then
    if [ -n "$REMOTE_MAX" ]; then
      echo "  PENDING AFTER $REMOTE_MAX (safe to append):$BLOCK_SAFE"
    else
      echo "  PENDING (nothing applied yet — safe to append):$BLOCK_SAFE"
    fi
    if [ -n "$BLOCK_OOO" ]; then
      # One ORDERED remediation. `--include-all` pushes the whole repo-pending
      # set, so the apply step is only correct after the OOO versions above are
      # resolved — printing it as a separate standing instruction would hand the
      # reader the very action the OOO block refuses.
      echo "  Remediation (in this order):"
      echo "    1. resolve each OUT OF ORDER version above (a or b);"
      echo "    2. then dispatch the deploy for the pending set above —"
      echo "       gh workflow run supabase-deploy.yml --ref main"
      echo '    `supabase db push --include-all` applies the WHOLE repo-pending set in'
      echo "    filename order, so step 2 before step 1 would apply the out-of-order"
      echo "    versions too."
    else
      # ONE decision, per version, made FROM PROD — this gate cannot make it.
      # Both outcomes are printed as peers: the apply path re-runs DDL, so it is
      # wrong for the bookkeeping case, and the repair path records a version
      # without running DDL, so it is wrong (and hides real drift, #1001) for the
      # ordinary case. Naming only one of them is how a red stays red.
      echo "  Remediation — decide PER VERSION, from prod (this gate sees versions, not schema):"
      echo "    (a) the objects are ABSENT — apply migrations first:"
      echo "        gh workflow run supabase-deploy.yml --ref main"
      echo "        # or manually: supabase db push --linked --include-all (whole pending set, filename order)"
      echo "    (b) the objects are PRESENT and only the version is unrecorded (bookkeeping"
      echo "        drift, #9613): record it WITHOUT running DDL —"
      echo "        supabase migration repair --linked --status applied <version>"
      echo "        (OWNER ACTION — a lane must not run prod DDL or repair, #2240)"
      echo "        Verify in prod first: 'supabase db diff --linked' (the objects) and"
      echo "        'supabase migration list --linked' — version ROWS only, so it cannot"
      echo "        tell you whether the objects exist. A blanket repair hides"
      echo "        real drift (#1001) — repair only a version whose objects you observed."
    fi
  fi
  exit 1
fi
echo "check-migration-drift: OK (no blocking drift)"
exit 0
