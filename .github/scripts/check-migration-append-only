#!/usr/bin/env bash
# check-migration-append-only — PR CI invariant checks for Supabase migrations (#1095)
#
# Two modes (first arg):
#   prefix — reject duplicate migration version prefixes AND non-conforming
#            filenames (files not matching the Supabase CLI's ^[0-9]+_ pattern
#            are applied by NOBODY — the CLI skips them).
#   diff   — reject edits/renames/deletions of migration files present in the
#            PR's base tree (migrations are append-only: a change to an
#            applied migration must be a NEW timestamp file). Same-PR-added
#            files (status A against the base) are allowed — the author can
#            fix their own new migration before merge.
#
#            EXCEPTION (#1235, duplicate-prefix repair; scoped by #2240): a
#            FORWARD PREFIX RENAME (git status R*) of a base-tree migration is
#            allowed when BOTH its old and new versions are PROVABLY UNAPPLIED
#            (absent from the remote applied set, queried via the Supabase
#            Management API) AND its destination sorts strictly AFTER the
#            newest applied version (REMOTE_MAX) — the canonical fix for the
#            0012x2/0015x2 class, and the very remedy the drift gate prescribes
#            for an out-of-order repo-ahead migration (#4278/#2240). The
#            version's PROD STATE is the authority, so the content MAY also
#            change in the same rename: a version with no schema_migrations row
#            has never run anywhere, so editing it cannot diverge prod. Gating
#            on byte-identity instead REPRODUCED the contradiction this check
#            exists to avoid — the gate's own remedy ("re-land its DDL as a
#            FORWARD migration") corrects the file's self-referencing header,
#            and a byte-identity requirement rejected exactly that. The forward
#            bound is what keeps the lagging applied-set API from being the
#            sole authority for "never applied": a prefix after REMOTE_MAX
#            cannot have run before prod's newest migration. Fail-closed:
#            without a token the remote set cannot be verified, so the strict
#            block stands (fork PRs keep today's behavior). Non-rename
#            statuses — edits (M/T) and deletions (D) — carry no destination
#            version, so they have no such bound and are NEVER exempt (#2240
#            scope (c)+(a), never (b)); neither is a change to an APPLIED
#            version (#1001).
#
# The check logic lives in this SHARED script (not inline YAML) so the
# hermetic pytest suite exercises the shipped logic, not a Python copy.
#
# Usage:
#   bash .github/scripts/check-migration-append-only prefix
#   bash .github/scripts/check-migration-append-only diff   # needs DRIFT_BASE_SHA
#
# Env:
#   DRIFT_REPO            (optional) — repo root (default: this script's repo)
#   DRIFT_BASE_SHA        (diff mode, required) — base commit to diff against
#   SUPABASE_ACCESS_TOKEN (optional, diff mode) — enables the #1235 unapplied-
#                         rename exception via the Management API. Absent →
#                         fail-closed (strict block, fork-safe).
#   DRIFT_TOKEN / DRIFT_CURL / DRIFT_API_URL / DRIFT_PROJECT_REF — test seams
#                         (mirror check-migration-drift).
#
# Exit codes:
#   0 — invariants hold
#   1 — violation found (print the offending file(s))
#   2 — usage/environment error
set -euo pipefail

# Byte-deterministic, locale-independent ordering for the version comparison in
# diff mode — mirrors check-migration-drift (the authority on REMOTE_MAX).
export LC_ALL=C

REPO_ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")/../.." && pwd)"
REPO="${DRIFT_REPO:-$REPO_ROOT}"
MIG_DIR="$REPO/supabase/migrations"
MODE="${1:-}"

case "$MODE" in
  prefix)
    ;;
  diff)
    if [ -z "${DRIFT_BASE_SHA:-}" ]; then
      echo "check-migration-append-only: DRIFT_BASE_SHA required in diff mode (exit 2)" >&2
      exit 2
    fi
    ;;
  *)
    echo "check-migration-append-only: usage: $0 <prefix|diff> (exit 2)" >&2
    exit 2
    ;;
esac

if [ ! -d "$MIG_DIR" ]; then
  echo "check-migration-append-only: migrations dir not found: $MIG_DIR (exit 2)" >&2
  exit 2
fi

if [ "$MODE" = "prefix" ]; then
  # 1. Non-conforming filenames — the CLI's migrateFilePattern is ^([0-9]+)_(.*)\.sql$.
  #    Anything else is silently skipped by `db push` = applied by NOBODY.
  NON_CONFORMING="$(
    ls "$MIG_DIR"/*.sql 2>/dev/null \
      | sed -nE 's#.*/([^0-9][^/]*\.sql)$#\1#p; s#.*/([0-9]+[^_/]*\.sql)$#\1#p' \
      | sort -u
  )"
  if [ -n "$NON_CONFORMING" ]; then
    echo "::error::Non-conforming migration filenames (CLI skips these — applied by NOBODY; rename to <N>_name.sql):"
    printf '%s\n' "$NON_CONFORMING" | sed 's/^/  /'
    exit 1
  fi

  # 2. Duplicate version prefixes (the 0012x2/0015x2 bug that aborted db push).
  DUPES="$(
    ls "$MIG_DIR"/*.sql 2>/dev/null \
      | sed -nE 's#.*/([0-9]+)_.*#\1#p' \
      | sort \
      | uniq -d
  )"
  if [ -n "$DUPES" ]; then
    echo "::error::Duplicate migration version prefixes (Supabase CLI keys by prefix — duplicate prefixes abort db push):"
    printf '%s\n' "$DUPES" | sed 's/^/  /'
    exit 1
  fi

  echo "check-migration-append-only: prefix invariants OK"
  exit 0
fi

# diff mode — append-only enforcement
# Read --name-status output line-by-line (tabs preserved) so filenames survive.
# Format: "M\tpath" / "R100\told\tnew" / "D\tpath" / "A\tpath"
STATUS_OUTPUT="$(
  git -C "$REPO" diff --find-renames=20% "$DRIFT_BASE_SHA"...HEAD \
    --name-status -- supabase/migrations/ 2>&1
)" || {
  echo "check-migration-append-only: git diff failed (bad DRIFT_BASE_SHA?) (exit 2)" >&2
  exit 2
}
VIOLATIONS=""
ADDED=""
while IFS= read -r line; do
  [ -z "$line" ] && continue
  status="${line%%$'\t'*}"
  case "$status" in
    M|D|R*|T)
      VIOLATIONS="$VIOLATIONS
$line"
      ;;
    A)
      # An ADDED file is normally the whole point of a migration PR, so it is not
      # a violation in itself — but placing a file at a version prod has ALREADY
      # applied IS the #1001 divergence: prod skips it, so the repo's content for
      # that version never ran and the two disagree about what it means. Added
      # lines are therefore checked against the applied set too, and admitted
      # only when their version is unapplied.
      ADDED="$ADDED
$line"
      ;;
  esac
done <<EOF
$STATUS_OUTPUT
EOF

if [ -n "$VIOLATIONS" ] || [ -n "$ADDED" ]; then
  # ── #1235/#2240 exception: a change to a PROVABLY UNAPPLIED version ─────────
  # The test is the migration version's PROD STATE, not the git status. A version
  # with no `supabase_migrations.schema_migrations` row has never run anywhere,
  # so renumbering, re-landing, editing or removing it cannot diverge prod —
  # which is exactly the remedy `check-migration-drift` prescribes for an
  # out-of-order repo-ahead migration. An APPLIED version is never exempt (#1001).
  # Fail-closed: the remote set is only reachable with a token; without one
  # (fork PRs) the strict block below stands.
  EXEMPT_RENAMES=""
  if [ -n "${DRIFT_TOKEN:-}${SUPABASE_ACCESS_TOKEN:-}" ]; then
    API_URL="${DRIFT_API_URL:-https://api.supabase.com}"
    PROJECT_REF="${DRIFT_PROJECT_REF:-ybetwichurajbfswfeqa}"
    CURL="${DRIFT_CURL:-curl}"
    TOKEN="${DRIFT_TOKEN:-$SUPABASE_ACCESS_TOKEN}"
    QUERY='{"query":"SELECT version FROM supabase_migrations.schema_migrations ORDER BY version"}'
    API_RESPONSE="$("$CURL" -s -w '\n%{http_code}' -X POST \
      "$API_URL/v1/projects/$PROJECT_REF/database/query" \
      -H "Authorization: Bearer $TOKEN" \
      -H "Content-Type: application/json" \
      -d "$QUERY" 2>&1 || true)"
    HTTP_CODE="$(printf '%s' "$API_RESPONSE" | tail -n1)"
    API_BODY="$(printf '%s' "$API_RESPONSE" | sed '$d')"
    # The applied set is only TRUSTWORTHY when the body is a non-empty JSON array
    # in which EVERY element carries a version, so its shape is validated FIRST
    # and REMOTE_OK gates the whole exemption below (fail closed). This matters
    # more under #2240 than before: the exemption now admits M/D/T as well as
    # R*, so a malformed 200 (a gateway HTML page, a renamed API field, a missing
    # jq) would produce an EMPTY set that reads as "nothing is applied" and
    # exempt EVERY violation — silently disabling the guard for edits to APPLIED
    # migrations, the #1001 P0 class. An empty reading is not trusted either:
    # this project's schema_migrations always has rows.
    REMOTE_OK=0
    if [ "$HTTP_CODE" = "200" ] || [ "$HTTP_CODE" = "201" ]; then
      if printf '%s' "$API_BODY" | jq -e '
            type == "array" and length > 0
            and all(.[];
              if type == "object" then
                has("version") and (.version != null)
                and ((.version | type) == "string" or (.version | type) == "number")
              else false end)' >/dev/null 2>&1; then
        # Normalise PER ELEMENT, never with a stream-wide `tr -d '[:space:]'`:
        # that deletes the NEWLINE between versions and merges them into one
        # token, so `grep -qxF` stops matching ANY version and the guard exempts
        # everything as soon as prod has two or more migrations. A
        # single-element fixture cannot see that, so the tests pin a
        # multi-element applied set explicitly.
        REMOTE_APPLIED="$(printf '%s' "$API_BODY" \
          | jq -r '.[] | .version | tostring | gsub("\\s";"")' 2>/dev/null \
          | sort -u)"
        if [ -n "$REMOTE_APPLIED" ]; then
          REMOTE_OK=1
        fi
      fi
    fi
    if [ "$REMOTE_OK" = "1" ]; then
      # Evaluate each violation line. The version that owns the change is the
      # BASE-TREE file's version: for "R<sim>\told\tnew" that is the OLD path;
      # for "M\tpath" / "D\tpath" / "T\tpath" the path itself.
      #
      # #2240 — WHAT IS EXEMPT, AND WHY. This guard's authority is prod
      # divergence (#1001: a change to an APPLIED migration diverged repo from
      # prod). A version with NO schema_migrations row has never run anywhere, so
      # re-landing it cannot diverge prod — and the drift gate's prescribed
      # remedy is exactly a FORWARD re-land ("re-land its DDL as a FORWARD
      # migration ... so it sorts after $REMOTE_MAX"). The exemption therefore
      # admits ONLY a git-detected PREFIX RENAME (R*) whose destination sorts
      # strictly AFTER $REMOTE_MAX with BOTH endpoints unapplied:
      #
      #   * The forward bound is CONTENT-INDEPENDENT. The applied-set API
      #     documents a multi-day lag, so "absent from REMOTE_APPLIED" alone
      #     cannot prove a version was never applied; a prefix after the newest
      #     applied version cannot have run before it.
      #   * M/T/D carry NO destination version, hence no such bound, so they are
      #     never exempt — an edit or deletion of a merely-unapplied migration is
      #     reported as a violation, not silently allowed (#2240 scope (c)+(a),
      #     never (b)). Byte-identity is NOT required on the rename itself: the
      #     remedy corrects the file's self-referencing header.
      # The exempted line is still printed, so every exempted change stays
      # visible in the job log.
      REMOTE_MAX="$(printf '%s\n' "$REMOTE_APPLIED" | sort | tail -n1)"
      KEEP=""
      while IFS= read -r line; do
        [ -z "$line" ] && continue
        status="${line%%$'\t'*}"
        rest="${line#*$'\t'}"
        old_path="$rest"
        new_ver=""
        case "$status" in
          R*)
            old_path="${rest%%$'\t'*}"
            new_ver="$(basename "${rest#*$'\t'}" | sed -nE 's#^([0-9]+)_.*#\1#p')"
            ;;
          A)
            # An ADDED file with no numeric prefix is not a migration the CLI can
            # apply (its basename does not match ^[0-9]+_), so it can neither be
            # applied nor diverge prod — diff mode must not invent a violation
            # for it (prefix mode still reports non-conforming *.sql). Only a
            # prefix-bearing addition is evaluated below.
            if ! printf '%s' "$(basename "$rest")" | grep -qE '^[0-9]+_'; then
              continue
            fi
            ;;
          *)
            # M / T / D — an edit or a deletion of a base-tree file. No
            # destination version exists, so there is no content-independent
            # ordering bound to make it safe, and the applied-set API lags prod.
            # Only a FORWARD PREFIX RENAME (R*) carries that bound, so every
            # other status falls through to KEEP and is reported, never dropped.
            KEEP="$KEEP
$line"
            continue
            ;;
        esac
        old_ver="$(basename "$old_path" | sed -nE 's#^([0-9]+)_.*#\1#p')"
        # Both endpoints must be provably UNapplied: the old version must have no
        # prod row (its DDL has never run), and on a rename the NEW version must
        # not have one either — otherwise the repo gains a file at a version prod
        # already ran with DIFFERENT content, which is the divergence this guard
        # exists to prevent. Fail closed on a non-conforming filename too: an
        # empty pattern would match an empty REMOTE_APPLIED line.
        if [ -n "$old_ver" ] \
           && ! printf '%s\n' "$REMOTE_APPLIED" | grep -qxF "$old_ver" \
           && { [ -z "$new_ver" ] || ! printf '%s\n' "$REMOTE_APPLIED" | grep -qxF "$new_ver"; }; then
          # An added file at an UNAPPLIED version is simply a new migration:
          # there is no exception to announce, so drop it silently rather than
          # reporting it as one.
          case "$status" in A) continue;; esac
          # #2240 (a): the destination must sort strictly AFTER REMOTE_MAX (the
          # newest applied version — the same ordering reference
          # check-migration-drift uses). This is the content-independent bound
          # against the applied-set API's documented lag; a backward or equal
          # prefix is a violation.
          if [[ "$new_ver" > "$REMOTE_MAX" ]]; then
            EXEMPT_RENAMES="$EXEMPT_RENAMES
$line"
            continue
          fi
        fi
        KEEP="$KEEP
$line"
      done <<EOF
$VIOLATIONS
$ADDED
EOF
      VIOLATIONS="$KEEP"
    else
      echo "::warning::append-only: cannot evaluate the #1235/#2240 unapplied-version exception — the Management API returned HTTP $HTTP_CODE and/or a body that is not a NON-EMPTY JSON array of objects carrying a version (this project's schema_migrations always has rows, so an empty reading cannot be trusted). Enforcing the strict block." >&2
    fi
  fi

  if [ -n "$VIOLATIONS" ]; then
    echo "::error::Migrations are append-only (#1095): a change to an already-merged migration must be a NEW timestamp file (do not edit/rename/delete an applied migration):"
    printf '%s\n' "$VIOLATIONS" | sed '/^$/d' | sed 's/^/  /'
    echo "::error::Historical violations of this rule caused the #1001 P0 (applied-migration edits diverged repo from prod). Use: supabase migration repair --linked --status applied <version> for repair."
    exit 1
  fi
  if [ -n "$EXEMPT_RENAMES" ]; then
    echo "::notice::Append-only exception (#1235/#2240): change to a provably-unapplied migration version allowed (this version has no row in supabase_migrations.schema_migrations):"
    printf '%s\n' "$EXEMPT_RENAMES" | sed '/^$/d' | sed 's/^/  /'
  fi
fi

echo "check-migration-append-only: append-only invariants OK"
exit 0
