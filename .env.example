# Tortoise — required environment variables
# Copy this file to .env and fill in values:
#   cp .env.example .env

# Boolean variables — which vocabulary applies (#4097, #4128). Three shapes, and
# they are NOT interchangeable:
#
# 1. PROTECTIVE switches (`*_DISABLED`, `TORTOISE_ALLOW_*`, `TORTOISE_TRUST_*`)
#    require the EXACT value "1". "true", "yes", "on", "TRUE" and a padded
#    " 1 " do NOT enable them — a typo can never silently relax a safety guard
#    (rate limiting, abuse detection, path containment, header trust, the
#    production-write interlock). This is a recorded decision: see the
#    `OVERRIDES (#4128)` entries in tests/test_env_truthy.py::_KNOWN_NARROW_READS,
#    which pin each one and its reason. Use "1".
# 2. Ordinary on/off flags accept the ONE truthy set {"1","true","yes","on"}
#    (case-insensitive, surrounding whitespace ignored) and read
#    {"0","false","no","off"} as OFF; unset/blank/garbage falls back to the
#    documented default (tortoise/env_truthy.py).
# 3. KEY / URI / PATH variables are read by PRESENCE: any non-empty value counts
#    as set, so X=0 means X IS set — never write "0" to mean "off" for those.

# FalkorDB connection URI — LOCAL deployments only.
# Best practice: a self-hosted/local instance is intentionally local — keep its
# DB target local. Do NOT point local tooling at the hosted (cloud) instance;
# the hosted product resolves its DB via the FALKORDB_CLOUD_URI secret on
# Fly/GitHub Actions, never from a local .env (see docs/infra-runbook.md).
# Supported schemes: docker:// (local), redis:// / rediss:// (hosted API accepts
# cloud URIs). File mode (testing only): /path/to/tortoise.db (embedded redislite)
# Default local target — canonical host URI (#942): compose publishes
# 127.0.0.1:6379 (loopback) and the sidecar runs with --requirepass falkordb.
# (Historical: this repo used a passwordless legacy port until #942 — the
# premise-labs partial copy carried an even older URI form, #761.)
TORTOISE_DB_URI=docker://:falkordb@localhost:6379/tortoise

# Embedded (FalkorDBLite) DB target — SINGLE-WRITER, EVAL ONLY (#942): used
# when TORTOISE_DB_URI is UNSET (single-agent local graphs, `tortoise init
# --path`). Concurrent writers (multiple agents) LOSE DATA on this engine.
# Default: ~/.tortoise/tortoise.db. `serve --http` prints the resolved path.
# TORTOISE_DB_PATH=~/.tortoise/tortoise.db
#
# Embedded durability (#915, #2879): AOF (the append-only journal, replayed on
# restart) is OFF by default. Set to 1 to enable it, so a `kill -9` of the
# embedded process loses at most the last ~1s of writes. It is left opt-in
# because enabling it roughly doubles embedded open+close time in CI
# (17s vs 8.6s, #915). Only meaningful with TORTOISE_DB_PATH; with
# TORTOISE_DB_URI the FalkorDB server owns its own AOF.
# TORTOISE_EMBEDDED_AOF=1
#
# NOTE for test runs: pytest imports tortoise.mcp_server at module scope; with a
# URI set here, the import attempts a live connection (and fails loud if
# unreachable). Run pytest with the URI unset / without .env (CI has no .env).
# Inline comments (' #') after values are stripped; a bare '#' inside a value
# (e.g. in a password) is preserved.

# Escape hatch: let the MCP server start with no TORTOISE_DB_URI (test only —
# reads/writes an empty embedded graph). Unset in normal operation.
# TORTOISE_ALLOW_EMBEDDED=1

# FalkorDB connection details (used by some CLI tools). Port must match the
# compose-published host port (127.0.0.1:6379). Legacy CLI path — the
# canonical TORTOISE_DB_URI above is preferred.
FALKORDB_HOST=localhost
FALKORDB_PORT=6379
FALKORDB_PASSWORD=falkordb

# ── #2850 liveness/readiness decouple (hosted API) ──────────────────────
# The hosted API answers /health from IN-MEMORY state and serves a dedicated
# liveness port (GET /healthz: 200 when the event loop is ticking, 503 when
# it is stalled) from its own thread, so Fly's checks can never be queued
# behind stalled DB work.
#
# FalkorDB client socket timeouts (seconds). The connect timeout is the one a
# stalled DB charges on EVERY call; the read timeout also bounds legitimate
# long commands (big GRAPH.QUERY replies, backup dumps, vecf32 restore
# chunks), so it is deliberately left generous. Non-positive/non-numeric
# values fall back to the default rather than disabling the bound.
# TORTOISE_FALKORDB_CONNECT_TIMEOUT_S=2      # default 2 (was a hardcoded 5)
# TORTOISE_FALKORDB_SOCKET_TIMEOUT_S=10      # default 10 (unchanged)
#
# #3813 — the restore backup/swap's GRAPH.COPY is a long SERVER-SIDE operation
# (FalkorDB forks a child that encodes the whole graph; the caller is blocked
# for the entire copy), so it runs over the restore's OWN read bound instead
# of the ordinary one above. Explicit and finite (never "block forever"); the
# default (120) sits above the ordinary 60s ceiling, and the value is clamped
# to [60, 3600] — where exactly 60 gives no restore headroom.
# TORTOISE_RESTORE_SWAP_TIMEOUT_S=120         # default 120, clamped [60, 3600]
#
# #4233 — after that read bound expires the restore does NOT immediately
# report a failure: a client read timeout does not cancel the server-side
# GRAPH.COPY, so the destination is polled for the copy's OUTCOME for this
# long before a timeout is reported. Defaults to the read bound, so each
# COPY ATTEMPT's client-side budget is read bound + settle (default 2 x 120s);
# a restore into a NON-EMPTY live graph issues the pre-restore safety copy AND
# the swap (a drill restores into a fresh target, so one copy), so a nominal
# restore is up to twice that (a wedged copy can retry, up to 3 attempts per
# copy). It is NOT a disable switch (empty/non-positive falls back to the read
# bound) and a positive value is clamped to [0.05, 3600].
# TORTOISE_RESTORE_SWAP_SETTLE_S=120          # default = the read bound
#
# How often the background refresher re-probes the DB for /health's `db`
# field (seconds). Keep below monitoring.PROBE_STALE_AFTER (30s).
# TORTOISE_HEALTH_PROBE_INTERVAL=10
#
# The dedicated liveness listener. 0.0.0.0:9090 is the DEPLOYMENT CONTRACT
# (a non-routing top-level Fly check points at it) — override for tests/
# self-host only. A non-integer or out-of-range port falls back to the default
# with an ERROR log (it never aborts boot).
# TORTOISE_HEALTHZ_PORT=9090
# TORTOISE_HEALTHZ_BIND=0.0.0.0
# Make a bind failure FATAL instead of a logged degradation (deploy-time
# contract enforcement). Truthy spellings: 1/true/yes/on.
# TORTOISE_HEALTHZ_REQUIRED=1
#
# Loop-stall self-kill: OPT-IN and DISABLED by default. The /healthz listener
# always reports staleness; this knob additionally exits (os._exit) a process
# whose event loop stopped ticking so the platform restarts it. Leave it unset
# (or 0) unless you have offloaded every synchronous on-loop call: this app
# still runs 60s-timeout LLM extraction and per-turn synchronous DB queries on
# the loop, so an age-only kill can restart-loop a merely busy machine. When
# enabled it also requires 3 consecutive stale windows AND no request in
# flight, and values below ~180s are clamped up to a safe floor (which must
# exceed monitoring.LOOP_STALE_AFTER, or the process would die before /healthz
# could report). 0/negative/non-numeric disables it.
# TORTOISE_LOOP_STALL_EXIT_S=0

# API key for the HOSTED/cloud product (https://api.premiselabs.co).
# The hosted REST/MCP server authenticates per-request via the
# `Authorization: Bearer <tt_key>` header — it never reads this env var.
# The CLI/SDK *client* reads TORTOISE_API_KEY to sign its hosted requests
# (e.g. `tortoise create-point` against api.premiselabs.co), and `tortoise
# serve --http --auth static` accepts it as the single shared key.
# ⛔ This is the ONLY name ANY code path reads for the hosted credential: the
# MCP HTTP client (tortoise/mcp_client.py::_api_key), the hosted SDK
# (tortoise/sdk.py), the CLI (tortoise/__main__.py) and `serve --http --auth
# static` (tortoise/auth.py::require_auth) all resolve TORTOISE_API_KEY and
# nothing else. A shell profile MAY deliberately give its MCP Bearer header a
# different variable (e.g. TORTOISE_MCP_API_KEY) — a policy choice, not a
# defect — but that name is then read by NOTHING: the committed .mcp.json still
# expands ${TORTOISE_API_KEY} from process.env, so an unaliased profile sends
# an empty Bearer and the server answers 401 (#5153). A separately-named MCP
# credential must therefore be aliased:
#   export TORTOISE_MCP_API_KEY=<key>                 # the MCP Bearer header
#   export TORTOISE_API_KEY="$TORTOISE_MCP_API_KEY"   # + every path above
# Capturing is per-surface, not uniform (#3615): the consent-gated in-repo
# capture paths fail closed on explicit TORTOISE_CAPTURE=1 consent
# (tortoise/capture_consent.py),
# but the Pi reflect-hook extension (agent-infra/extensions/reflect-hook.ts)
# starts hosted capture on credential presence and never reads TORTOISE_CAPTURE
# — exporting this name on a Pi host ships session transcripts. Open
# dependency: agent-infra#1117.
# ⚠️ Do NOT set it in this repo-root .env: a repo-root .env is auto-loaded
# for editable installs, so it leaks into EVERY local command — and local
# stdio MCP cannot carry auth tokens, so setting it disables local stdio
# (all tools reject). Export it in the shell/CI where you actually run
# hosted client commands or `serve --http --auth static`.
#   - Self-hosted stdio dev mode: leave UNSET.
#   - Self-hosted authenticated MCP: `tortoise serve --http` (+ `tortoise key create`).
# ⚠️ `serve --http --auth static` ALSO requires TORTOISE_SECRET_PEPPER (below) —
#   set it first (e.g. `openssl rand -hex 32`) or the auth import fails on startup.
# TORTOISE_API_KEY=tt_your_key_here

# POST /v1/sessions extraction (#822): LLM-default. The regex extraction
# loop was removed as a product path — capture runs the M2 LLM extractor
# when a provider key is configured (OPENROUTER/DEEPSEEK/OPENAI/GEMINI_API_KEY)
# and 503s when none is (fail-closed; no fallback). HOSTED: at least one of
# these MUST be set on the deployment (Fly) — see docs/infra-runbook.md §4.6
# for provider choice + cost bounds. A key is only ever sent to the provider
# that issued it; when multiple are set, the first configured wins
# (openrouter > deepseek > openai > gemini).
#
# ⛔ KEY SOURCE — the keys are split by surface (#4860). Do not reuse one key
#    across surfaces:
#      production → GitHub secret → Fly (`fly secrets`)
#      evals      → this repo-root .env   ← what eval/measurement runs must use
#      blog       → Cloudflare Pages project env (see docs/HANDOFF-*-blog-*.md)
#      fleet      → ~/pi-keys.env on the workstation (agent lanes only)
#    This file is the EVALS home: the OpenRouter key here is the evals key
#    (not the one the ask-lane pilot happened to start with), and the
#    neighbouring DEEPSEEK entry is the evals DeepSeek key.
#
# ⚠️ AN AMBIENT KEY IS WHAT A RUN USES, NOT THIS FILE. Eval/measurement
#    entry points read provider keys straight from the process env and do not
#    load this file (the repo's only `.env` loader, `mcp_server._load_dotenv`,
#    is not imported by them — and where it does run it only fills keys that
#    are ABSENT, never overriding an explicitly set var). So a shell that
#    exported OPENROUTER_API_KEY/DEEPSEEK_API_KEY is what gets billed. That is
#    exactly what happened on 2026-09-23 (#4860): the sealed write-path run
#    billed an EXHAUSTED fleet OpenRouter key (403 on all 7 sessions) while a
#    healthy evals key sat here, and the run output named no key. For any
#    eval/measurement run use the wrapper, which strips the ambient provider
#    keys, loads this file with override, and prints the source + fingerprint
#    of every key it set:
#      tools/run-with-eval-keys.sh <command> [args...]
#    (the never-override rule is deliberate for non-provider vars such as
#    TORTOISE_DB_URI; the wrapper preserves it there and overrides only the
#    provider keys.)
#    The evals home holds the full managed set — OPENROUTER/DEEPSEEK/OPENAI/
#    GEMINI/VENICE (the launcher's managed-key set; GEMINI_API_KEY is set under the
#    MCP block below) — VENICE is read by the ask + longmem lanes
#    (`tortoise/model_adapters.py`), so set it here too if those lanes run in
#    this checkout.
# OPENROUTER_API_KEY=
# DEEPSEEK_API_KEY=
# VENICE_API_KEY=
# OPENAI_API_KEY=
# TYPESAFE_API_KEY=
#   The TypeSafe typed-decision capability (Jev) — the model behind the fleet's
#   classification/triage gates. Real endpoint: https://api.typesafe.ai/v1/systemone,
#   model `jev-latest` — the vendor ALIAS, by owner ruling 2026-10-27 ("let's use jev
#   latest"). The fleet's confidence thresholds were calibrated on jev-1.13.0, and the
#   alias resolved to jev-1.14.0 in the 2026-10-26/27 measurements — so the voting model
#   now moves when the vendor ships, with no change on our side. That is a deliberate
#   departure from the vendor's own recommendation (send a version ID, not an alias, when
#   thresholds are tuned); it is recorded, with the reason, on agent-infra#2915.
#   The response echoes the concrete version that answered — record it; that echo is what
#   makes a shifted verdict visible instead of inferred.
#   ⚠️ INDEPENDENTLY of the alias, the thresholds are owed a FIRST real calibration against
#   this API: they were measured on the lookalike host, never on api.typesafe.ai. The echo
#   read jev-1.14.0 at the time of writing, so that debt is current, not pending a future
#   release. agent-infra#2918 tracks it (turn-classify's MIN_CONFIDENCE is part of it).
#   Mint keys at https://console.typesafe.ai/keys.
#   ⛔ The fleet billed against `jevtypesafeai.com` until 2026-10-26 — a LOOKALIKE host,
#   not the vendor's API (tortoise#7864 paid it). Do not reintroduce that host.
#   ⚠️ The three deployed JEV callers under ~/.pi/agent/scripts/ — turn-classify.py,
#   ask-owner.py, lane-actions.py — are DERIVED from the agent-infra
#   checkout by pi-bootstrap/setup.sh, so running it from an unmigrated checkout
#   reinstalls the lookalike caller (measured 2026-10-26). That HOST leg is merged
#   (agent-infra#2859, 9205ab47a), so fast-forwarding the checkout is sufficient for it.
#   ⚠️ THE MODEL CONSTANT rides the same derivation for the TWO THAT CARRY THEIR OWN —
#   turn-classify.py and ask-owner.py — so a bootstrap from a checkout that still holds
#   the pin reverts them (observed 2026-10-27 12:52). lane-actions.py carries no constant
#   of its own: it sends `LV.JEV_MODEL` from state/lane-verdict.py (see below).
#   ⛔ NOT SO FOR ~/.pi/agent/state/lane-verdict.py — setup.sh never creates or copies into
#   `state/` (measured in that script), so a bootstrap neither sets nor reverts it. That file
#   is HAND-MAINTAINED: if it holds the pin, edit it (the sweep), no branch can help.
#   ✅ THE SOURCE IS NOW THE ALIAS TOO: agent-infra#2914 MERGED 2026-10-27 21:16Z, so
#   agent-infra `main` sends `jev-latest` — `scripts/turn-classify.py:164` and
#   `scripts/ask-owner.py:92` at be723d336. Fast-forward the checkout and re-bootstrap and both
#   DERIVED copies follow with no hand-edit. The third file, `state/lane-verdict.py`, is
#   hand-maintained either way and no branch delivers it (a box without it has nothing to assert).
#   Assert EVERY caller, BOTH constants, after any bootstrap:
#   grep -rn 'JEV_URL =' ~/.pi/agent/scripts/turn-classify.py \
#       ~/.pi/agent/scripts/ask-owner.py ~/.pi/agent/state/lane-verdict.py
#   -> every line must name api.typesafe.ai
#   grep -rn 'JEV_MODEL =' ~/.pi/agent/scripts/turn-classify.py \
#       ~/.pi/agent/scripts/ask-owner.py ~/.pi/agent/state/lane-verdict.py
#   -> every line must read jev-latest (the alias, by the ruling above); a pin in the two
#      ~/.pi/agent/scripts copies means they were bootstrapped from a checkout that PREDATES
#      the merge — fast-forward and re-bootstrap; a pin in lane-verdict.py means hand-edit it,
#      nothing derives it
#   ⛔ THE 0600 STORE ~/.pi/agent/jev-config.json IS THE HOME, and uncommenting the
#   line above is NOT inert: `tortoise/mcp_server.py::_load_dotenv` exports it into
#   the process env (a later child inherits it), and every Jev caller resolves
#   $TYPESAFE_API_KEY -> $JEV_API_KEY -> the store — i.e. a value here silently
#   OUTRANKS the store, so a stale one keeps being used while the store looks
#   right. The line stays declared so the NAME is documented. A Jev call that
#   fails (unset / any error) WITHHOLDS — it can never become a false CLEAN.
#   → THE ONE IN-REPO READER: `tortoise/s2_decision_seam.py` (the S2.2/S2.3 typed-
#   decision seam, #5087 — internal, OFF unless TORTOISE_S2_DECISION_SEAM is set).
#   It resolves $TYPESAFE_API_KEY -> $JEV_API_KEY -> the 0600 store -> this repo-root
#   `.env` (the fleet's order, with the file LAST), posts to
#   https://api.typesafe.ai/v1/systemone, and on any key/network/schema failure
#   degrades in the direction its own failure policy declares — a VET failure can
#   never become a discard. See `docs/architecture/S2-DECISION-SEAM.md`.
#   TORTOISE_SESSION_LLM_MODEL — model for the configured provider, e.g.
#   deepseek:deepseek-flash / openrouter:deepseek/deepseek-chat / openai:gpt-4o-mini
#   (defaults per provider: deepseek-flash, deepseek/deepseek-chat, gpt-4o-mini,
#   gemini-2.0-flash). TEST ONLY: TORTOISE_SESSION_LLM_MOCK=1 swaps in the
#   offline MockModel extractor (no network).
# TORTOISE_SESSION_LLM_MODEL=
# ── Session-auth JWKS knobs (tortoise/session_auth.py, #1460) ──────────────
# TORTOISE_JWKS_TTL — JWKS cache TTL seconds (default 300)
# TORTOISE_JWKS_TIMEOUT — HARD TOTAL seconds for ONE JWKS fetch (default 4).
#   ⚠ It is a TOTAL, not httpx's per-phase timeout (which the code applied
#   pre-#3284: connect+read alone could reach ~10s, and the request path could
#   pay two of them). Values below the phase sum + margin (4.0s = 3.5s phases
#   + 0.5s margin) are clamped up and logged, so a phase timeout fires first
#   and no fetch worker is stranded.
#   One request pays at most 2 × this (TTL refresh + kid-miss refetch).
# TORTOISE_JWKS_COOLDOWN — JWKS failure/miss refetch cooldown seconds
#   (default 30; bounds unauthenticated forged-kid fetch amplification;
#   jittered +50% on miss so a poller can't deterministically starve key
#   rotation)

# ── MCP auth-plane 503 back-off (tortoise/mcp_auth.py, #3144 / #3812) ───────
# TORTOISE_MCP_AUTH_RETRY_AFTER — seconds advertised in the `Retry-After`
#   header on the MCP auth-plane 503 (`OrgResolutionMiddleware`: the control
#   plane / registry was unreachable while resolving the bearer token).
#   Integer seconds (RFC 7231 §7.1.3), default 5, CLAMPED to 1..3600 so a
#   misconfiguration can never advertise a zero-second busy-retry or an absurd
#   window. An MCP client connects eagerly at startup (Pi's mcp-client: a 15s
#   budget, no retry), so without this header a recoverable dependency outage
#   is indistinguishable from a hard outage and the session loses every
#   Tortoise tool.

# ── Health-probe knobs (tortoise/monitoring.py, #3143) ─────────────────────
# The deep DB probe is two phases with different cost profiles: the projection
# cold-start (connect + _ensure_indexes — ~28 round trips, and an O(graph)
# index build when one is missing) and the O(1) `RETURN 1` reachability query.
# PROBE_TIMEOUT (1.5s, not env-tunable) bounds the reachability query for the
# platform liveness gate — a stopped DB must fail fast (#1384). The on-demand
# MCP tool `tortoise_health` additionally bounds the cold-start with this
# allowance, so a large but reachable graph is not reported degraded/0.
# Raise it only if a legitimate cold-start on your graph exceeds 20s. Accepted
# range [1.5, 300]; values below it are rejected because they would leave the
# cold-start less time than the platform liveness gate's own budget, so only a
# misconfiguration would ask for one. 1.5 is the FLOOR, not a safe value for a
# large graph — a cold-start over 1.5s still times out. The cold-start
# allowance is ON TOP of the 1.5s reachability-query budget. Unset (or blank,
# the shipped default) silently uses 20s; non-numeric, non-finite and
# out-of-range values fall back to 20s with a warning — never a crash. Read at
# call time, so this .env value is honoured by the MCP server.
#
# ⚠️ Shared-slot hazard — NOT a function of this knob: every probe submits to
# the SINGLE process-lifetime probe slot (`_PROBE_WORKER`, #3062), which stays
# occupied for the DURATION OF ITS BLOCKING CALLABLE, not for the caller's
# allowance (a probe the caller abandons keeps running — CPython #87185). So a
# cold-start that runs long holds the slot even with this knob at its floor, and
# RAISING this knob does NOT widen that hold. While the slot is occupied a
# concurrent hosted `_HEALTH_PROBE` / `/health/ready` submission times out at
# its own 1.5s bound and `/health/ready` can answer 503
# (hosted_api.py:2608-2626). Measured with PROBE_TIMEOUT=1.5 over a 2.0s
# cold-start, the slot was released ~2.0s after submission in BOTH shapes —
# platform (no allowance) and MCP (setup_timeout=20) — the same hold; post-#3143
# it is if anything SHORTER when setup overruns, since the query is never
# submitted. It is a false-FAIL, not a false-PASS — the DB is reachable and a
# later call answers ok. The slot-starved residual is tracked in #3683.
# TORTOISE_PROBE_SETUP_TIMEOUT — projection cold-start allowance seconds
#   (default 20). Spent by the on-demand MCP tortoise_health tool AND the
#   selfhost /health background refresher — the refresher's request path reads
#   an in-memory snapshot, so the allowance costs the gate no latency. A
#   REQUEST-PATH liveness probe keeps the tight 1.5s bound: the standalone
#   serve_health /health handler and hosted /health/ready always do, and the
#   hosted /health coordinator does (its probe reuses one cached connection;
#   extending it there is the hosted health lineage's call, #3070/#3062).
#   See the shared-slot warning above, #3683.
# TORTOISE_PROBE_SETUP_TIMEOUT=

# Optional frontmatter-metadata validator (#1362) — warn-only, default OFF.
# When TORTOISE_VALIDATE_FRONTMATTER=1, session/corpus files with missing or
# malformed required metadata (sessionId/topics/summary/eventId/doc_status/agent/
# message_count for sessions; title/doc_status/topics/summary/sessionId for
# documents) are WARNED on at ingest/index time (logging), never hard-failed.
# Also checks the hosted POST /v1/sessions request shape (session_id +
# non-empty conversation).
# TORTOISE_VALIDATE_FRONTMATTER=0

# Postgres connection for audit_events (optional — falls back to JSONL if unset)
# Install with: pip install tortoise-graph[postgres]
# TORTOISE_AUDIT_DSN=postgresql://user:pass@localhost:5432/tortoise_audit
#
# HOSTED (post-#669 flip, #771): TORTOISE_AUDIT_DSN must be set on Fly to the
# Supabase Postgres pooler connection string — audit rows land in the
# existing `audit_events` table (migration 0002; actor_user_id is TEXT via
# migration 0006, so non-UUID actors like 'service-bootstrap' / 'anon-*'
# insert fine). The pooler DSN already uses the postgresql:// prefix the
# logger requires. Session pooler (port 5432) is recommended:
#   postgresql://postgres.<project-ref>:<urlencoded-password>@aws-0-<region>.pooler.supabase.com:5432/postgres
# Add ?sslmode=require (psycopg2 needs it for Supabase's TLS-only
# connection). No code change was needed in tortoise/audit_events.py — the
# logger's DSN validation, INSERT column list, and schema DDL already match
# migrations 0002/0006 (see docs/plans/2026-08-08-669-plan.md Task 9).
#
# TORTOISE_AUDIT_FALLBACK_DIR relocates the Tier-2 JSONL audit fallback off
# `$HOME` (default: `$HOME/.tortoise/audit_fallback.jsonl`). Set it for
# containers, CI, or per-test isolation. Resolution is LAZY — the value in
# effect when a fallback WRITE happens is the one used — so importing
# tortoise.hosted_api (which builds a module-level AuditLogger) writes nothing
# here. A whitespace-only value is ignored, i.e. treated as unset, and a
# value that does not resolve to an ABSOLUTE path is refused (the audit event
# is dropped and counted), so a CI misconfiguration cannot silently redirect
# the fallback into the process CWD.
# TORTOISE_AUDIT_FALLBACK_DIR=/var/lib/tortoise

# The RECORD's own Postgres DSN — ARMS the record write path (#9187, epic #7879).
# Default: unset ⇒ the record is NOT ARMED, and the write seam
# (`tortoise/record_writer.py`) returns a named `not-armed` outcome having
# executed zero statements and opened zero connections. Default-off is a
# DECISION, not a gap: docs/architecture/STORAGE-ARCHITECTURE.md §2.0 keeps the
# cache fully populated while the one-write-path sequence lands, so capture is
# byte-identical for every deployment that has not armed the record.
#
# Presence IS the arming signal (a DSN, not a boolean flag — a second "enabled"
# key would be a second thing to get out of step). It must start with
# postgresql:// or postgres://; anything else RAISES rather than reading as
# unarmed, because silently treating a typo as "not configured" is the failure
# the seam exists to prevent. The record carries its own append-only migration
# history (`supabase/migrations/20261012*_record_*.sql` + forward record
# migrations), so this is NOT the control plane and not the audit DSN.
#
# ARMED BUT UNREACHABLE IS A FAILED WRITE, not a skipped one: §3/§17.1 make the
# record the truth, so a capture that reports success while the record is down
# would claim a durability that did not happen.
#
# SET A CONNECT TIMEOUT: the seam sets one of its own (`10 s`,
# `record_writer.CONNECT_TIMEOUT_SECONDS`), because libpq's default is
# `connect_timeout=0` — wait forever — and the door opens one connection PER
# RECORD on the caller's thread after the journal append committed. A host that
# drops packets (or a stalled DNS lookup) would otherwise HANG the write instead
# of failing it, which on the capture path is the difference between a degraded
# capture and a wedged one. A `connect_timeout` in the DSN WINS over that
# default (the operator's explicit bound is not replaced), so
# `?connect_timeout=5` tightens it per deployment with no code change. (The
# sibling TORTOISE_AUDIT_DSN has the same shape and the same advice.)
#
# AND THE TIMEOUT IS PAID AT MOST ONCE PER CAPTURE, not once per record: a
# connect that FAILS trips a breaker (`record_writer.LIVE_WRITE_BREAKER_SECONDS`,
# `60 s`) so the rest of that capture is refused locally and counted
# `circuit_open` instead of each record paying the connect timeout again — 25
# records against a blackholed host used to spend ~4 minutes inside one
# `capture_session`. The first SUCCESSFUL write closes the breaker, so a healed
# record recovers on its own, with no restart. Both signals are on
# `monitoring.metrics()["record_write_failures"]`.
#
# THE SCHEMA: the record's own migrations (`supabase/migrations/20261012*_record_
# *.sql` plus the forward record migrations) are SHIPPED IN THE PACKAGE —
# `tortoise/record_migrations/`, mapped in `pyproject.toml`. The seam PARSES the
# schema it writes to (`record_projection.table_columns()`), so a wheel that did
# not carry them failed every armed write. A repo checkout reads
# `supabase/migrations` (the source of truth); an installed package reads its own
# copy. Nothing to configure.
# The driver is optional: pip install tortoise-graph[postgres]
# TORTOISE_RECORD_DSN=postgresql://user:pass@localhost:5432/tortoise_record?connect_timeout=5
#
# THE RECORD'S BACKUP uses a SEPARATE connection, and a DIFFERENT ROLE (#9801).
# The app path connects as `tortoise_record_app` (NOBYPASSRLS — that is what makes
# row-level security the tenancy boundary, R6), and a backup under that role sees
# ZERO rows: every `*_app_tenant` policy reads `app.current_org_id`, which the
# backup never sets, so the counts come back empty and `pg_dump` (whose
# `row_security = off` default is an ERROR for a NOBYPASSRLS role) cannot read the
# tables at all. R6 names the database-level backup as one of three legitimate
# bypass purposes, so arm this with the table owner / `postgres`, or
# `service_role`, on the DIRECT connection. Unset, `record-backup` falls back to
# TORTOISE_RECORD_DSN — and when THAT names the app role, it REFUSES with a
# message naming the role (a record DSN that already bypasses RLS is accepted).
# TORTOISE_RECORD_BACKUP_DSN=postgresql://postgres:pass@db.<project-ref>.supabase.co:5432/postgres
# TORTOISE_RECORD_SCRATCH_DSN=postgresql://postgres:pass@db.<scratch-ref>.supabase.co:5432/postgres
#
# THE RECORD'S TENANT — the pair that lets an ARMED write proceed (#9078 scope
# decision 3). An armed write with no tenant in scope is REFUSED and counted
# (`no_tenant`) rather than filed under a guessed one (#9192), so arming only
# the DSN leaves every write refused. This pair is the SINGLE-TENANT arming
# surface: set both for a deployment that serves ONE graph. The values are the
# org/graph the record's own tables are keyed by (the same ids the control
# plane uses), not arbitrary labels. A HALF-configured pair (one set, one
# empty/unset) is NOT a tenant — it is refused rather than completed, because a
# half pair is how rows land under the wrong graph.
#
# ⚠️ THE PAIR ONLY COUNTS WHEN THE DEPLOYMENT DECLARES ITSELF SINGLE-TENANT
# (`TORTOISE_RECORD_SINGLE_TENANT` below, #9192). Env is process-global — one
# value for every tenant the process serves — so on a multi-tenant process the
# pair is not a weaker tenant, it is a WRONG one: it files tenant A's rows under
# tenant B's organisation with no error (the row is well-formed and the FK only
# checks that the graph exists). Undeclared ⇒ MULTI-TENANT (the fail-closed
# default) ⇒ the pair is IGNORED and the write is refused `no_tenant`, counted
# and warned. A scope always WINS over the pair: wrap the write path in
# `tortoise.record_writer.use_record_tenant(org_id, graph_id)`, which is
# per-request and nests — that is the ONLY correct arming for a process that
# serves more than one tenant. Where that scope is installed: the MCP lane's
# tenant mode ON THE CONTROL-PLANE lane (`auth_mode=tenant` with a Supabase
# control plane — the hosted deployment), from the resolution it already does
# (`mcp_auth.OrgResolutionMiddleware`). It is NOT installed on a self-host
# registry deployment (its `graph_id` is a Falkor node id, not a
# `public.graphs.id`, so the record's tables cannot key on it) nor on
# `--auth static`/`none`, stdio, or the hosted REST lane (#9188) — all of those
# arm by the pair + declaration below, or refuse. Ask `record_tenant()` — not
# `current_record_tenant()` — what an armed write would be filed under.
# TORTOISE_RECORD_ORG_ID=
# TORTOISE_RECORD_GRAPH_ID=
#
# DECLARE A SINGLE-TENANT RECORD DEPLOYMENT (#9192). Set to 1 ONLY where this
# process serves exactly one graph (embedded CLI/SDK, one self-hosted instance,
# stdio MCP): it is what makes the `TORTOISE_RECORD_ORG_ID`/`_GRAPH_ID` pair
# above a valid answer. Absent = multi-tenant = the pair is ignored. A typo
# reads as ABSENT (refused rows, not misfiled rows).
# TORTOISE_RECORD_SINGLE_TENANT=1
#
# #669 flip window (P3-4): set to 1 during the flip ONLY. The registry is
# deleted at the flip, so the backup sweep's team universe legitimately
# drops to 0 — this suppresses the spurious ENUM_DELTA incident the #596
# watcher would otherwise file. Remove it after post-flip verification.
# TORTOISE_SUPPRESS_ENUM_DELTA=1

# Secret pepper for API key hashing (PBKDF2 input, #67/#7395)
# PRODUCTION: REQUIRED — set a stable random value (e.g. openssl rand -hex 32).
# Required for `serve --http --auth static` with TORTOISE_API_KEY — the auth
# import fails at startup without it.
# Dev mode (no TORTOISE_API_KEY): optional — falls back to a dev-only pepper
# constant so imports/tests work without it.
# TORTOISE_SECRET_PEPPER=

# GitHub connector issue-routing config (#1395) — optional override of the
# packaged default (tortoise/config/routing.yaml, shipped in the wheel).
# Point this at your own repo→team mapping YAML (same shape as the packaged
# default); missing/unreadable/invalid files fall back to the packaged default.
# TORTOISE_ROUTING_CONFIG=/path/to/my-routing.yaml

# Self-host custom pack directory (#1930, epic #1891 WF-2) — optional override
# of the packaged catalog (tortoise/packs/). Resolution order:
#   TORTOISE_PACKS_DIR (set+valid) → packaged default → repo root (dev).
# A set-but-missing / empty (zero manifests) / all-broken dir logs a WARNING
# and falls back to the default catalog — NEVER a silent empty registry.
# Use an ABSOLUTE path (relative paths resolve against the daemon's CWD;
# `~` is expanded). Self-host container pattern: bind-mount + point at it, e.g.
#   volumes: ["${PWD}/packs:/packs"]
#   environment: ["TORTOISE_PACKS_DIR=/packs"]
# TORTOISE_PACKS_DIR=/etc/tortoise/packs
# MCP server API keys — exported into the shell environment Pi launches from
# (Pi does not auto-load .env; see docs/environment-variables.md). These are
# referenced by .mcp.json via ${VAR} interpolation:
#   exa  → EXA_API_KEY          (exa-mcp-server)
#   brave-search → BRAVE_API_KEY (@brave/brave-search-mcp-server)
#   gemini → GEMINI_API_KEY      (@houtini/gemini-mcp, requires a valid key at
#                                 startup — an unset/placeholder key makes the
#                                 server exit, see issue #240)
# Get a key at https://aistudio.google.com/apikey
# GEMINI_API_KEY=


# ── Control plane (#669) — which store answers auth + registry reads ──────
# The backup/DR sweep resolves its TEAM LIST through this lane, so it is the
# knob behind the `source` field on every sweep result and /status last_sweep
# (#2823: a sweep reading the wrong lane enumerates 0 teams and looks like an
# empty deployment — `"source": "registry"` on a Supabase deployment's sweep
# result is a misconfigured lane, not an empty one).
# TORTOISE_CONTROL_PLANE=      # registry (selfhost; also the default when
#                              # unset with no Supabase creds) | supabase
# SUPABASE_URL=                # https://<project-ref>.supabase.co (supabase lane)
# SUPABASE_SERVICE_ROLE_KEY=   # service-role key (or SUPABASE_SERVICE_KEY);
#                              # TORTOISE_CONTROL_PLANE=supabase with either one
#                              # missing FAILS CLOSED (500/503 — never a silent
#                              # fallback to the registry; supabase_control.py)

# Hosted backup pipeline (#305) — AES-256-GCM + Cloudflare R2
# Install with: pip install tortoise[backups]
# Backup keys live in a MANAGED secret store (#2318): default provider is the
# environment (Fly/GH secrets). Rotation keeps a dual-key overlap window — see
# docs/ops/registry-backup-dr.md §Rotation. A versioned FILE store is available
# for selfhost/tests (BACKUP_KEY_STORE=file + BACKUP_KEY_STORE_PATH).
# BACKUP_KEY_STORE=env     # env (default) | file — a cloud KMS is the documented
#                          # extension seam (not implemented: no credentials here)
# BACKUP_KEY_STORE_PATH=   # file-store path (file provider; default ~/.tortoise/backup-keys.json)
# TORTOISE_BACKUP_KEY=  # base64 32-byte key: python -c "import base64,secrets; print(base64.b64encode(secrets.token_bytes(32)).decode())"
# TORTOISE_BACKUP_KEY_PREVIOUS=   # RETAINED key during a rotation overlap window
#                                 # (#2318) — old archives stay decryptable in-app.
#                                 # Set by the rotation tool; unset after the overlap.
# R2_ACCOUNT_ID=
# R2_ACCESS_KEY_ID=
# R2_SECRET_ACCESS_KEY=
# R2_BUCKET=tortoise-backups

# ── Backup sweep / DR alerting (#596) ───────────────────────────────
# BACKUP_SWEEP_ENABLED=        # true only when ALL required secrets below are set
# TELEGRAM_BOT_TOKEN=          # required when enabled (human alert channel)
# TELEGRAM_CHAT_ID=            # required when enabled
# ── Availability watchdog escalation (#3887) ────────────────────────
# The watchdog pages a human for a SUSTAINED availability incident over the
# SAME Telegram channel above (TELEGRAM_BOT_TOKEN + TELEGRAM_CHAT_ID). These
# knobs are documented here for local/drill runs. In CI, ESCALATION_CHAT_ID and
# ESCALATE_ENABLED are wired (STEP-level, in
# .github/workflows/availability-watchdog.yml): ESCALATE_ENABLED comes from the
# repository variable of the same name, so the kill switch needs no workflow
# edit (unset = enabled). The ESCALATE_SUSTAINED_MINUTES / ESCALATE_MIN_RUNS
# thresholds are script DEFAULTS — the workflow does not set them, so overriding
# them in CI means adding them to that step's `env:`.
# ESCALATION_CHAT_ID=          # optional: a different recipient for SUSTAINED
#                              # incidents (defaults to TELEGRAM_CHAT_ID)
# ESCALATE_ENABLED=1           # 0 = operator kill switch (no sustained page)
# ESCALATE_SUSTAINED_MINUTES=  # default 3 x SUSTAINED_DOWN_MINUTES (=30)
# ESCALATE_MIN_RUNS=           # default SUSTAINED_MIN_RUNS + 1 (=3)
# ── Availability pager liveness (#4573) ─────────────────────────────
# The watchdog writes a rolling heartbeat (its own GitHub issue) and a SEPARATE
# workflow/checker (availability-liveness.yml) alarms if it goes stale. The
# heartbeat is NOT part of the Telegram leg; the alert is a GitHub issue +
# failed run. In CI, HEARTBEAT_ENABLED and HEARTBEAT_MAX_AGE_MIN are wired
# (STEP-level): both come from the repository variable of the same name, so no
# workflow edit is needed.
# HEARTBEAT_ENABLED=1          # 0 = operator kill switch (no heartbeat recorded;
#                              # the liveness check then alerts BY DESIGN — a
#                              # silence is never an all-clear)
# HEARTBEAT_MAX_AGE_MIN=90     # staleness bound for the checker. Default 90 =
#                              # 3 x the MEASURED p95 inter-arrival (~28.6 min).
#                              # Must be a plain integer; anything else (2h,
#                              # -1, 0.5) falls back to the default. Below the
#                              # measured p95 (~29) it will false-fire.
# HEARTBEAT_EMIT=1             # INTERNAL: exactly one probe step per job emits
#                              # (the workflow sets 0 on the second step)
# DR_ISSUES_PAT=           # fine-grained PAT, issues:write, daniel-ospina/tortoise
# BACKUP_ALERT_ASSIGNEE=       # GitHub handle that receives DR alerts (required when enabled)
# GH_REPO=daniel-ospina/tortoise
# REGISTRY_STREAM_KEY=         # base64 32-byte AES-256-GCM key for sweep backup
#                              # archives (#661). REQUIRED when enabled — fail-closed missing.
#                              # THIS KEY MUST NEVER BE A GITHUB SECRET. Set out-of-band
#                              # on Fly: fly secrets set REGISTRY_STREAM_KEY=... --app tortoise-y4mjjq
#                              # Generate: python -c "import base64,secrets; print(base64.b64encode(secrets.token_bytes(32)).decode())"
# REGISTRY_STREAM_KEY_PREVIOUS=  # retained sweep key during a rotation overlap
#                                # window (#2318) — also Fly-only, never in GH.
#                                # Set by tools/rotate-backup-keys.py; unset after
#                                # the overlap (fly secrets unset ..._PREVIOUS).
# BACKUP_STALE_THRESHOLD_MIN=90
# BACKUP_WATCHER_POLL_SECONDS=600
# BACKUP_DRIVER_DOWN_THRESHOLD_MIN=240
# BACKUP_WATCHER_GRACE_MIN=120
# BACKUP_SIZE_GUARD_MAX_NODES=100000
# BACKUP_RETENTION_HOURLY=24
# BACKUP_RETENTION_DAILY=7
# BACKUP_RETENTION_WEEKLY=4
# BACKUP_SIMULATE_ENABLED=     # staging only; gates /simulate-stale|recover
# BACKUP_WATCHER_DISABLED=     # test/debug escape hatch; do not set in prod

# ── Team-account restore window (#302, #4179) ───────────────────
# Grace before a soft-deleted team account is hard-purged, derived from
# tortoise/retention.py RESTORE_WINDOW_HOURS (the single authority); the
# canonical doc is docs/retention-and-deletion.md.
# TORTOISE_TEAM_DELETE_GRACE_HOURS=168   # 7 days; see docs/retention-and-deletion.md
#   An org's STORED grace_hours (promised when it was deleted) always wins:
#   this env var is only the fallback for rows with no stored value, so
#   changing it can neither purge an org early nor defer it past its promise.
#
# ── User-account restore window (#4029, #4179) ──────────────────
# Grace before a self-service-deleted personal account is erased (DELETE
# /v1/user/account). The window's single authority is tortoise/retention.py
# RESTORE_WINDOW_HOURS; this env var is ONLY the fallback for a ledger row
# that carries no stored grace_hours, so changing it can neither erase an
# account early nor defer it past its stored promise. Canonical doc:
# docs/retention-and-deletion.md.
# TORTOISE_USER_ACCOUNT_DELETE_GRACE_HOURS=168   # 7 days; see docs/retention-and-deletion.md

# ── Backup immutability + geo mirror (#2319) ───────────────────────
# R2 bucket-lock rule scoped to the backups/ prefix (Cloudflare console /
# Wrangler / REST API — NOT S3 Object Lock; R2's S3 seam cannot read or set
# it). The repo-side surface is the config contract + drift bounds below;
# exact provisioning + verification live in docs/ops/registry-backup-dr.md §#2319.
# BACKUP_LOCK_ENABLED=         # operator sets TRUE only AFTER the rule exists
# BACKUP_LOCK_DAYS=3           # 1..6 (default 3) — must stay < the #2304 trash
#                              # grace (7d), per docs/retention-and-deletion.md,
#                              # so purge erasure is never blocked
# CF_API_TOKEN=                # OPTIONAL: R2-scoped Cloudflare API token (Account
#                              # > R2 > Edit). Without it /v1/internal/backups/
#                              # verify-lock + /status lock report unverifiable and
#                              # the runbook (console/wrangler) is the verify path.
#                              # Operator-set out-of-band on Fly (never a GH secret).
# BACKUP_MIRROR_ENABLED=       # second-store (region/account-separated) copy of
#                              # every accepted archive; required-when-enabled creds below
# R2_MIRROR_ACCOUNT_ID=        # second store's Cloudflare account id (its own
# R2_MIRROR_ACCESS_KEY_ID=     # region/blast radius) — DO NOT reuse the primary R2_*
# R2_MIRROR_SECRET_ACCESS_KEY=
# R2_MIRROR_BUCKET=
# R2_MIRROR_ENDPOINT=          # optional override; default derives from the account id
#                              # (https://{id}.r2.cloudflarestorage.com). Mirror creds
#                              # are Fly-only, out-of-band (like REGISTRY_STREAM_KEY).

# ── Waitlist form (#373) — Supabase edge function secrets ─────────────────
# NOT Python-runtime vars — set these on the edge function via:
#   supabase secrets set --project-ref ybetwichurajbfswfeqa RESEND_API_KEY=... \
#     RESEND_FROM_EMAIL=... TURNSTILE_SECRET_KEY=...
# TURNSTILE_SITE_KEY (public) goes in website/index.html.
# RESEND_API_KEY=re_...
# RESEND_FROM_EMAIL=Premise Labs <noreply@premiselabs.co>
# TURNSTILE_SECRET_KEY=          # verify captcha tokens server-side (when set, tokens are REQUIRED)
# TURNSTILE_SITE_KEY=            # paste into index.html TURNSTILE_SITE_KEY constant (public)

# ── Signup CAPTCHA (#308) — Cloudflare Turnstile (hosted API) ────────────
# Hosted API (/v1/register, /v1/signup/email): when TURNSTILE_SECRET_KEY is
# set, requests must carry a valid widget token (cf-turnstile-response),
# else 400. Unset → fail-open: signup works without tokens and a warning is
# logged (dev/selfhost mode). The PUBLIC site key is pasted into the
# TURNSTILE_SITE_KEY constants in website/signup.html + website/index.html
# (static pages, no build step — same human step as SUPABASE_ANON_KEY).
# TURNSTILE_SECRET_KEY=
# TURNSTILE_SITE_KEY=

# ── GoTrue auth captcha (#885) — [auth.captcha] in supabase/config.toml ──
# SAME TURNSTILE_SECRET_KEY, DIFFERENT mechanism from the #308 app-level
# check: the GoTrue [auth.captcha] block gates the /auth/v1 email-sending
# endpoints and FAILS CLOSED — GoTrue refuses to boot while enabled with an
# empty secret (no silent fail-open). Config.toml governs local + selfhost
# only; the hosted project is dashboard-managed (Dashboard → Auth → Security
# → CAPTCHA). Local dev: set a Turnstile TEST secret here or flip
# enabled = false in supabase/config.toml.
# TURNSTILE_SECRET_KEY=   # shared with #308 — see above
# TURNSTILE_SITE_KEY=     # client-side widget only; GoTrue never reads it

# ── GoTrue external auth + optional providers (#4030) — [auth.external.*],
#    [auth.sms.twilio] and [experimental] in supabase/config.toml ──────────
# The COMMITTED local-stack config resolves every name below by `env(NAME)`
# substitution, so each is required by a file in this repo. `github` and
# `google` are the ENABLED providers — a local `supabase start` reads those
# four values; `apple`, `twilio` and the `[experimental]` S3 keys belong to
# DISABLED / experimental blocks, so a default local stack never reads them,
# and they are declared here because the config names them and a block you
# flip ON must not need a name you cannot find
# (tests/test_env_contract_covers_supabase_config.py holds this).
# Config.toml governs LOCAL + selfhost only; the hosted project's providers
# are dashboard-managed (Dashboard → Auth → Providers). Use a Supabase
# test/selfhost OAuth app locally — never the production client secret.
# SUPABASE_AUTH_EXTERNAL_GITHUB_CLIENT_ID=
# SUPABASE_AUTH_EXTERNAL_GITHUB_SECRET=
# SUPABASE_AUTH_EXTERNAL_GOOGLE_CLIENT_ID=
# SUPABASE_AUTH_EXTERNAL_GOOGLE_SECRET=
# SUPABASE_AUTH_EXTERNAL_APPLE_SECRET=      # [auth.external.apple] enabled = false
# SUPABASE_AUTH_SMS_TWILIO_AUTH_TOKEN=      # [auth.sms.twilio] enabled = false
# S3_HOST=                                  # [experimental] only (OrioleDB/S3)
# S3_REGION=
# S3_ACCESS_KEY=
# S3_SECRET_KEY=

# ── Stripe billing (#310) ────────────────────────────────────────────────
# ⛔ The OPERATOR'S local copies are deliberately NOT here (#4030): the live
# restricted key, the webhook secret and the price catalog were moved off the
# workstation's plaintext .env to the macOS Keychain (relocated 2026-09-19,
# workflow-safe — the deploy leg reads the GitHub secrets and the workflow
# never reads .env). Retrieval commands + the full posture:
# docs/infra-runbook.md §2.1.
# Live Stripe secret key (sk_live_...) — REQUIRED for billing endpoints;
# missing → billing endpoints answer 503, boot unaffected (lazy config).
# STRIPE_SECRET_KEY=
# Webhook endpoint secret (whsec_...) for POST /webhooks/stripe HMAC verify.
# STRIPE_WEBHOOK_SECRET=
# Price catalog JSON — 8 ids (4 tiers × monthly/annual), validated against
# product/pricing.json (annual = −20%):
#   {"free":{"monthly":"price_...","annual":"price_..."},
#    "solo":{"monthly":"price_...","annual":"price_..."},
#    "pro":{"monthly":"price_...","annual":"price_..."},
#    "team":{"monthly":"price_...","annual":"price_..."}}
# Entries may be {"id": "price_...", "amount_usd": N} to also validate the
# annual discount numerically.
# STRIPE_PRICE_IDS=
# Redirect URLs embedded into the Checkout Session (env-driven, Task 5).
# BILLING_SUCCESS_URL=https://app.premiselabs.co/team?session_id={CHECKOUT_SESSION_ID}
# BILLING_CANCEL_URL=https://app.premiselabs.co/team?checkout=cancelled
# Dashboard host (#1135): billing redirect DEFAULTS derive from this single
# env var (same convention as the CLI claim flow in tortoise/__main__.py).
# TORTOISE_DASHBOARD_URL=https://app.premiselabs.co

# ── Billing notifications (#310, best-effort — never block the webhook) ────
# Resend API key (sending-only, premiselabs.co domain) + ops inbox receiving
# billing_upgrade/downgrade/payment_failed/cancel emails.
# RESEND_API_KEY=
# BILLING_NOTIFY_TO=ops@premiselabs.co
# Sender identity (#1136): RESEND_FROM_EMAIL — the single managed sender
# identity shared with the transactional invite sender (see below); default
# noreply@premiselabs.co. BILLING_FROM_EMAIL overrides it when a distinct
# billing sender is desired (e.g. billing@premiselabs.co).
# RESEND_FROM_EMAIL=Premise Labs <noreply@premiselabs.co>
# BILLING_FROM_EMAIL=billing@premiselabs.co

# ── Transactional email (#307 invites, #1138 send budget) ──────────────────
# Resend invite sender for team invitations (#307). Same RESEND_API_KEY as
# billing (one Resend account — see #1138 budget).
# RESEND_FROM_EMAIL=Premise Labs <noreply@premiselabs.co>
# EMAIL_LINK_BASE_URL=https://tortoise.premiselabs.co
# Send budget (#1138): in-process guard so bulk invite blasts hard-stop with a
# warning instead of silently hitting Resend rate/budget 429s. Defaults are the
# Resend free tier (100 emails/day, 3,000/month). Estimate only — resets on
# process restart, so it bounds a single process's burst, not absolute usage.
# Scope: EVERY Resend send taken on this budget is counted — the invite, OTP
# and onboarding paths in email_notify.py, plus billing (notify.py). Abuse
# alerts are Telegram-only (#3639) and never touch Resend. Caveat: the counter
# is per-process, so N replicas × cap (e.g. 2 replicas × 100/day = up to
# 200/day toward Resend's 100/day free tier) — leave headroom or scale the cap.
# RESEND_SEND_BUDGET_DAILY=100
# RESEND_SEND_BUDGET_MONTHLY=3000

# ── Abuse prevention (#308) ──────────────────────────────────────────────
# CAPTCHA (Cloudflare Turnstile) for signup — reuses the waitlist pattern.
# TURNSTILE_SECRET_KEY is a Fly secret (server-side siteverify; fail-open
# ONLY while unset). The SITE KEY is a hand-edited literal in
# website/signup.html + website/index.html (static site — no env injection);
# the widget stays hidden until a key is provisioned.
# TURNSTILE_SECRET_KEY=
# TURNSTILE_SITE_KEY=
# Appeal link shown in 403 SUSPENDED / -32006 responses and notifications.
# ABUSE_APPEAL_EMAIL=support@premiselabs.co
# TORTOISE_ABUSE_APPEAL_URL=https://tortoise.premiselabs.co/docs.html#appeal
# Rule threshold overrides (defaults: 500 points/1h, 10 keys/24h, 100 reads/5min).
# TORTOISE_ABUSE_POINT_THRESHOLD=500
# TORTOISE_ABUSE_POINT_WINDOW_S=3600
# TORTOISE_ABUSE_KEY_THRESHOLD=10
# TORTOISE_ABUSE_KEY_WINDOW_S=86400
# TORTOISE_ABUSE_READ_THRESHOLD=100
# TORTOISE_ABUSE_READ_WINDOW_S=300
# #10156 calibration: a read-velocity breach now ALSO needs the scope's own
# recent rate, so a key whose normal traffic is heavy (an agent doing 130
# reads/5min is ordinary) stops re-alerting every window. `*_BASELINE_FACTOR`
# is how far above its own baseline a scope must go (3 = 3x);
# `*_BASELINE_SAMPLES` is how many COMPLETED windows the baseline averages
# (6 = ~30min at the default window). The absolute threshold above is a FLOOR,
# not a ceiling — it is deliberately NOT raised, because a detector turned down
# to silence is not a fixed detector. A factor of 0 disables the calibration
# (the floor alone decides: the pre-#10156 rule).
# TORTOISE_ABUSE_READ_BASELINE_FACTOR=3
# TORTOISE_ABUSE_READ_BASELINE_SAMPLES=6
# #10156: comma-separated id allowlists for first-party/test traffic. An exempt
# ORG never alerts; an exempt KEY only skips the per-key scope, so a genuinely
# unusual ORG total still surfaces. Read once, at tracker construction.
# TORTOISE_ABUSE_EXEMPT_KEY_IDS=
# TORTOISE_ABUSE_EXEMPT_ORG_IDS=
# #1081 agent-signup abuse protection:
# TORTOISE_SIGNUP_IP_LIMIT=2              # anonymous signups per IP per window (agent path only)
# TORTOISE_SIGNUP_IP_WINDOW_S=86400       # rolling window (s); 3rd signup within → 429
# TORTOISE_ABUSE_SIGNUP_THRESHOLD=2       # R8: successful mints per IP per window → ops notify
# TORTOISE_ABUSE_SIGNUP_WINDOW_S=86400    # R8 window (s); notify dedup once per window
# A non-positive `*_WINDOW_S` value (zero OR negative) is invalid — it would
# disable the limiter instead of tightening it — so it falls back to the
# knob's default and logs one warning per distinct setting.
# TORTOISE_TRUST_FLY_CLIENT_IP=1          # trust Fly-Client-IP (#1081) for per-IP limiters ONLY behind the Fly proxy
#                                         #   (set in fly.toml [env]; fail-closed default — a
#                                         #   non-proxy ingress must never self-set its per-IP key)
#                                         #   Also gates Fly-Forwarded-Proto (#985) for redirect Location
#                                         #   schemes (preferred over X-Forwarded-Proto — non-overridable).
# TORTOISE_TRUST_X_FORWARDED_PROTO=1      # trust X-Forwarded-Proto (#985) for redirect Location schemes —
#                                         #   self-hoster behind nginx/Caddy ONLY (Fly uses Fly-Forwarded-Proto,
#                                         #   gated by TORTOISE_TRUST_FLY_CLIENT_IP). Fail-closed default.
# Kill-switch: disables all abuse rules/hooks (tests/local).
# TORTOISE_ABUSE_DISABLED=1
# Future: IPINFO_TOKEN for IP→country resolution beyond the CF-IPCountry header.
# Ops note: run abuse_cleanup (migration 0015 RPC, default 90d retention)
# periodically — no in-product scheduler.

# ── Epic #900 index surface (T-DOCS, #1034) ─────────────────────────────
# The unified local-corpus index path (`tortoise index directory <dir>`).
# All seven vars below are honored on that path; only TORTOISE_DB_URI was
# documented before this block.

# TORTOISE_DB_URI — Docker URI (e.g. docker://:falkordb@localhost:6379/tortoise)
#   for a durable multi-writer graph, or leave UNSET to use the embedded
#   single-writer store at TORTOISE_DB_PATH (eval only — two processes on one
#   embedded file is the #6761 crash class; concurrent writers need the
#   server-mode graph, integration-tested to 5 writers).

# TORTOISE_INGEST_BASE_DIR — the SECURITY SANDBOX for the index path: every
#   corpus dir / progress file / resolved symlink target must stay under it.
#   NOT the corpus selector — see TORTOISE_SESSION_CORPUS. A typo here is a
#   pre-walk error, never a silent fallback.
# TORTOISE_INGEST_BASE_DIR=

# TORTOISE_EVENT_LOG_BASE_DIR — #4240: base dir for the hosted lane's
#   per-graph JSONL REBUILD journal ({dir}/{graph}/events.jsonl). Unset = the
#   hosted lane journals nothing and `rebuild_all` cannot reconstruct its
#   live-only aboutObject edges; set = the hosted data SDKs are built with an
#   `event_log_path` so the derived graph is `replay(journal)`. This is a
#   DOMAIN EVENT LOG, never the durability mechanism — see
#   docs/durability-posture.md.
# TORTOISE_EVENT_LOG_BASE_DIR=

# TORTOISE_SESSION_CORPUS — the session-end hook's sweep-corpus selector
#   (default ~/.tortoise/docs/conversations). The hook passes it POSITIONALLY
#   to `tortoise index directory`. Setting this to the real 4,190-file user
#   corpus while TORTOISE_DB_URI points at a test graph sweeps the whole
#   corpus into the wrong DB — the base-dir-vs-corpus confusion hazard.
# TORTOISE_SESSION_CORPUS=

# TORTOISE_MAX_FILE_MB — the two-layer size guard (float MB, default 50).
#   Files at or over the limit are rejected BEFORE any read (never OOM);
#   a 0/negative value is a fail-closed error.
# TORTOISE_MAX_FILE_MB=50

# TORTOISE_EMBEDDING_REPAIR_BACKOFF_HOURS — across-run bound on embedding-
#   repair retries after an outage (float hours, default 24). A failed repair
#   records a marker and suppresses re-attempts within the window, so a
#   persistent embedding outage cannot become a ~35h-per-run retry storm.
# TORTOISE_EMBEDDING_REPAIR_BACKOFF_HOURS=24

# TORTOISE_EMBEDDER_WARMUP — engine-init embedder warm-up (#2952), default
#   "1" (on). A non-blocking, best-effort, once-per-process daemon load
#   started by TortoiseSDK._get_proj so a load failure is surfaced once at
#   init rather than disguised by the 60s per-query negative cache. Set to
#   "0"/"false"/"no"/"off" to disable (e.g. very memory-constrained hosts).
#   The flag also skips the HOSTED lifespan cold-start pre-warm
#   (tortoise.hosted_api._lifespan), not just the SDK engine-init warm-up:
#   one opt-out covers both background embedder loads. Retrieval still
#   degrades gracefully to keyword-only with a declared single-leg marker.
#   Tests disable it (see tests/conftest.py).
# TORTOISE_EMBEDDER_WARMUP=1

# TORTOISE_EMBEDDING_MODEL_REQUIRED — the fail-loud embedder contract
#   (#4861), default OFF. Truthy: 1 / true / yes / on. When truthy, a process
#   that cannot load the embedder RAISES EmbedderUnavailableError instead of
#   getting None, so an armed process can never be handed a keyword-only
#   (FTS-only) result it cannot tell apart from the product's hybrid
#   retrieval. The raise is scoped to the READ path: point creation, semantic
#   dedup, pairwise similarity and cross-lens matching keep their documented
#   deterministic TF-IDF degrade (#399/#880). Unset/blank/0/false/no/off
#   restores the historical None return and the keyword-only degrade. Arm it
#   in embedder-provisioning jobs (#4869), never in a process expected to run
#   degraded.
# TORTOISE_EMBEDDING_MODEL_REQUIRED=0

# TORTOISE_INDEX_NO_NETWORK — TEST-ONLY. Forces extract_metadata=False-
#   equivalent omission at the NEW-PATH call boundary (LLM tier AND session
#   embeddings short-circuited; embedding excluded from completeness).
#   NEVER honored inside the shared _session_embedding — the frozen legacy
#   ingest path still embeds under this var. An accidentally-set value
#   disables LLM/embeddings with warnings only.
# TORTOISE_INDEX_NO_NETWORK=1

# TORTOISE_CAPTURE — EXPLICIT consent for session capture (#3615). Capture is
#   a DATA-SHARING act, not an authentication act: on the consent-gated paths
#   below, exporting TORTOISE_API_KEY for the MCP `Authorization: Bearer`
#   header does NOT enable it. Default OFF
#   (unset/blank/any other value ⇒ no transcript leaves the machine through any
#   of the consent-gated paths below). Truthy:
#   1 / true / yes / on. Applies to every transcript upload regardless of
#   endpoint (hosted or self-hosted), to the Claude Code `session-end.sh` hook
#   and the `tortoise session drain` its SessionStart counterpart runs in the
#   background, to `tortoise session capture` / `tortoise sessions import`, and
#   to the SDK's client transmission (`TortoiseSDK.commit_session` →
#   `_post_commit`, #3662). NOTE: that list is deliberately NOT exhaustive — at
#   least four further capture seams exist and none reads this variable:
#   the ambient INDEXER sweep is not gated and DOES egress — the Claude Code
#   `session-end.sh` hook runs `tortoise index directory <corpus> --metadata`
#   unconditionally (outside its `TORTOISE_CAPTURE` branch), and
#   `tortoise/session_indexer.py` posts conversation-derived text to an
#   OpenAI-compatible endpoint whenever `OPENAI_API_KEY` is set (the one other
#   suppression is the test-only `TORTOISE_INDEX_NO_NETWORK`, which forces
#   metadata extraction off at the SDK boundary) — so the
#   "no transcript leaves the machine" guarantee above does NOT hold on that
#   path (tracked with the other ungated seams, #3662);
#   the hosted MCP tool `tortoise_session_capture` runs SERVER-side, so the
#   client host cannot gate it (it carries the server policy
#   `session_recording`, default-ON per #1927; the owner ruling on #3662
#   (Option 1) treats the explicit tool invocation as the agreement and the
#   tool description carries the disclosure — a deliberate departure from the
#   per-session-opt-in default, `OVERRIDES:` marker on #3662);
#   `TortoiseSDK.capture_session` is not gated — it writes the `TORTOISE_DB_URI`
#   backend AND sends each turn to the configured BYOK extractor provider
#   (BYOK is the documented default), so it is not egress-free;
#   and the Pi capture extension
#   (`tortoise/pi-hooks/tortoise-capture.ts`, installed by `tortoise capture
#   install`) is an in-repo seam that reads no `TORTOISE_CAPTURE` —
#   installing it IS its own opt-in. The agent-infra `reflect-hook` keys
#   capture on credential presence instead of this variable
#   (agent-infra#1117, open).
# TORTOISE_CAPTURE=1

# TORTOISE_INDEX_CHILD_STDERR — debug-redirect for the backgrounded hook
#   sweep / CLI child: captures the child's FULL output (stdout+stderr) to
#   this file, TRUNCATE-ON-OPEN. Fail-safe: relative targets and targets
#   whose parent dir is missing/unwritable are rejected; a NONEXISTENT target
#   FILE is valid (the child creates it). Set it proactively if you want to
#   monitor the every-session-close sweep — the hook always exits 0 and a
#   failing sweep is invisible by default.
# TORTOISE_INDEX_CHILD_STDERR=

# TORTOISE_INDEX_READY_FILE — TEST-SYNCHRONISATION ONLY. `tortoise index github`
#   writes this file (contents: "ready") once its projection is fully built and
#   just before the index loop, so a test or supervisor can signal the process
#   at a deterministic point. Unset in normal runs: no file is written and
#   nothing else changes. Exists because signalling DURING construction lands
#   while an in-flight server command still holds an embedded connection, and
#   redislite's last-client cleanup guard then declines to shut the embedded
#   server down (it is orphaned; see #2947, #3055).
# TORTOISE_INDEX_READY_FILE=

# ── #318 multi-tenant pack isolation (hosted) ─────────────────────────────
# TORTOISE_STARTER_PACKS — comma-separated starter pack NAMESPACES activated
#   per tenant at provisioning (idempotent PackInstall records in the tenant
#   graph; shared catalog stays read-only). Unknown names are skipped with a
#   logged warning — never a provisioning failure. Unset/empty → built-in
#   default set (dev,marketing,product-strategy,pm — catalog namespaces; the
#   project-management pack dir declares namespace `pm`). Additive-only:
#   removing a pack here does NOT uninstall existing installs.
# TORTOISE_STARTER_PACKS=dev,marketing,product-strategy,pm

# ── #1348 RRF candidate-pool floor ─────────────────────────────────────────
# TORTOISE_POOL_FLOOR — per-strategy candidate depth floor for RRF fusion in
#   tortoise_fts_query (str_limit only; the RETURNED limit is unchanged —
#   truncation precedes EP decoration, so a deeper pool has zero decoration
#   cost). ENV-ONLY OPT-IN: unset → historical limit*2 (NO baked default — the
#   #1348 depth finding was CEILING-CAPPED: delta(20,50)=0.14 pts < 1.0, so a
#   quality rationale for default-50 does NOT hold at corpus ~2000). Quality/
#   latency tradeoff: deeper pools let items ranked 21-50 contribute RRF scores
#   (ordering may shift; retrieval latency up to ~2.5x at limit=10, upper-bound
#   until measured on Docker). Precedence: pool_size kwarg > this env > limit*2.
# TORTOISE_POOL_FLOOR=50

# ── #8487 valid-time selection (read-path ordering) ────────────────────────
# TORTOISE_VALID_TIME_RERANK — the operator KILL SWITCH for the read-path
#   valid-time selection (#8487): on a PREFER-LATEST question ("… now", "is
#   still", "currently") ``tortoise_fts_query`` demotes Point claims that had
#   ENDED or had NOT YET started at the asked instant, BEFORE the ``limit`` cut.
#   Default ON (unset/empty → ON). Set ``0`` to restore the pre-#8487 pure
#   relevance order. The ordering instant is the ``query_date`` the caller
#   passes (the ask lane passes its own ``question_date``); with no
#   ``query_date`` it is the wall-clock date, so a read is reproducible across
#   a ``validTo`` boundary only when a date is pinned.
# TORTOISE_VALID_TIME_RERANK=0

# ── #8488 BM25 lexical arm (read-path lexical SCORER) ─────────────────────
# TORTOISE_BM25_LEXICAL — swaps the LEXICAL scorer of ``tortoise_fts_query``
#   for the in-process Okapi BM25 arm (``tortoise/bm25.py``, idf + term-
#   frequency saturation + length normalisation) instead of the graph's
#   fulltext scorer, on the EMBEDDED lane only (``BM25_ENTITY_TYPES``: point,
#   document, source). DEFAULT **ON** since the owner ruling of 2026-10-28
#   (#8488): the variable is now an OPT-OUT.
#
#   ⛔ TURNING IT OFF: ``TORTOISE_BM25_LEXICAL=0`` (or ``false`` / ``no`` /
#   ``off``) restores the graph-side scorer and the pre-change bytes. An unset,
#   blank or GARBAGE value keeps the DEFAULT — resolved through
#   ``env_flag`` (``tortoise.env_truthy``), so a typo never silently changes
#   which scorer a read uses. The default moved once the arm's own tie was
#   fixed (#10121: it ranked its corpus newest-first and dropped the newest
#   match at ``limit``); the benchmark (#8486) is STILL pending, so this is a
#   mechanism-level default, not a measured quality claim.
#
#   Posture when ON: the graph-side leg still runs in the chain (so the
#   fallback costs no latency and the lexical slot is metered once); the arm
#   only REPLACES that slot's rows when it finds something — an empty or
#   failed arm leaves the shipped rows exactly as they were; it stands down on
#   the #4028 relevance-floor answer, when a later lexical pass
#   (``search_keys_prf`` / ``entity_key_expansion``) would overwrite the slot,
#   and on any family outside ``BM25_ENTITY_TYPES``. ``TORTOISE_FUSION_WEIGHTS``
#   is bounded for the lexical leg (``LEXICAL_WEIGHT_MAX``, #7704/#1657) —
#   dropping the clamp is what lets a lexical also-ran outrank the dense
#   leg's best hit.
#
#   ⛔ COST, NOT YET MEASURED: the arm pulls up to ``DEFAULT_BM25_CORPUS_CAP``
#   (20 000) rows — INCLUDING ``content`` and ``search_keys`` — into Python and
#   tokenises them on the caller's thread, outside ``degradation_chain``'s
#   deadline. A corpus WIDER than the cap makes the leg DECLINE rather than
#   swap the shipped whole-label rows for a window over the oldest ids — so a
#   store that large keeps the shipped scorer. The decline is recorded in the
#   leg trace as ``declined=True`` (with ``degraded=False`` and no
#   ``mechanism``): the decline itself impairs nothing — the shipped lexical leg
#   answered over the whole label and the rows are returned — so it must not
#   read as an IMPAIRED memory, and BM25 produced no rows so it claims no
#   ``mechanism``. A declined arm therefore stays distinguishable from a clean
#   empty arm on ``declined`` alone (a clean empty arm ran its scorer and found
#   nothing). Other legs report themselves: a failed vector leg is still
#   ``degraded`` on its own entry, which this change does not touch.
#   If the cost matters on your corpus, opt out with ``=0`` until #8486 lands.
# TORTOISE_BM25_LEXICAL=1

# ── #1765 identity surface (login methods + recovery banner) ──────────────
# TORTOISE_LINK_INTENT_SECRET — HMAC secret for link-intent refs (add-OAuth).
#   FAIL-CLOSED: link-intent returns 503 when unset. Rotate → outstanding
#   intents invalidate within the 120s TTL (cheap). Fly secret: set it.
# TORTOISE_LINK_INTENT_SECRET=
# TORTOISE_REAUTH_WINDOW_SECONDS — re-auth freshness window for link-intent /
#   unlink / change-email (default 900). Interval semantics:
#   now() - last_sign_in_at <= <seconds>; NULL last_sign_in_at → fail-closed deny.
# TORTOISE_REAUTH_WINDOW_SECONDS=900
# TORTOISE_MANUAL_LINKING_ENABLED — set to 1 once the hosted Supabase
#   "Enable Manual Linking" toggle is ON (ops runbook). Fail-closed: unset/0
#   → link-intent 503 + the banner's promise-free variant.
# TORTOISE_MANUAL_LINKING_ENABLED=0
# TORTOISE_ACL_LAYER — the DECLARED posture of the per-graph ACL layer (#10093,
#   implementing the owner decision recorded on #8617):
#     strict (DEFAULT, unset) — this deployment declares the layer provisionable
#       here: a reachable server that FAILS THE RECIPE (a non-permission failure
#       — bad rule, syntax error) fails the graph mint and the graph is rolled
#       back. A PERMISSION REFUSAL is NOT that: a credential the server refuses
#       is recorded as `denied` and never rolls a mint back, even under `strict`
#       (`AclLayerDenied` is deliberately not an `AclLayerError`, so no rollback
#       arm can catch it — the owner ruling on #8617 is explicit that a mint must
#       not be rolled back for a user we are not allowed to create).
#       Self-hosted / docker / test lanes want `strict` and need no configuration.
#     best_effort — attempt it, record a refusal once per process, never fail a
#       mint for it.
#     off — the graph MINT does not attempt it at all (no connection built); the
#       absence is reported as `absent_by_design` with a reason. This is the
#       HOSTED value: FalkorDB Cloud grants `+ACL` to no credential the app may
#       hold, so the layer is unprovisionable there (fly.toml [env],
#       docs/infra-runbook.md §2). Graph DELETION is the exception and still
#       issues a best-effort `ACL DELUSER` — a user created under an earlier
#       posture must still be revoked — which a `+ACL`-less credential will
#       refuse; that refusal is logged and is never fatal to the delete.
#   Fail-closed: an unrecognised value warns and resolves to `strict`, never to
#   `off` — a typo must not silently disarm the layer. An empty value behaves as
#   unset (it resolves to the default silently); unset it anyway so the intent
#   stays explicit.
# TORTOISE_ACL_LAYER=strict
# Per-user in-memory rate buckets (per-process — single-worker deployment;
# document multi-worker drift):
# TORTOISE_LINK_RATE_LIMIT=10
# TORTOISE_UNLINK_RATE_LIMIT=10
# TORTOISE_RESEND_RATE_LIMIT=5

# ── Ask lane — EVAL-ONLY (#1987 / #3849) ────────────────────────────
# The ask lane is NOT a product surface: there is no /v1/ask route, no
# SDK ask() method and no ask tool in the MCP surface. It survives as the
# eval-only entry point tortoise/ask_lane.py, driven by the LongMemEval
# A/B assembly arm and tools/ask_spotcheck.py. The READER still ships
# (tortoise/reader.py — the eval re-exports it; the 500-Q benchmark
# measures it directly).
# TORTOISE_ASK_MODEL=deepseek/deepseek-v4-flash   # ask-lane model (default
#                                                 # deepseek/deepseek-v4-flash;
#                                                 # mirrors TORTOISE_EXTRACT_MODEL;
#                                                 # a strong reader e.g.
#                                                 # qwen/qwen3.8-max is servable
#                                                 # via OpenRouter, #2069)
#
# # #2069 — ask-lane spec format (family-prefixed form ONLY):
# #   - 'qwen/qwen3.8-max' / 'deepseek/deepseek-v4-flash' / … → the provider
# #     is AUTO-derived from the family prefix (qwen/, upstage/, anthropic/
# #     → OpenRouter-only — requires OPENROUTER_API_KEY; deepseek/ → the
# #     deepseek-direct/openrouter/venice pool as today).
# #   - bare MODELS registry keys (qwen3.8-max, solar-pro4, claude-opus-5)
# #     normalize to their family-prefixed spec; a bare non-deepseek id
# #     absent from that map → build-time ValueError (fail-loud).
# #   - the eval's colon-form 'provider:model' (e.g.
# #     'openrouter:qwen/qwen3.8-max', the TORTOISE_LME_READER_MODEL format)
# #     is REJECTED on the ask lane → ValueError naming the family-prefixed
# #     form (use TORTOISE_LME_READER_MODEL for the eval lane).
# #   - an empty intersection (e.g. a qwen spec with no OPENROUTER_API_KEY)
# #     fails at build time naming the missing key — never a silent misbuild.
#
# # TORTOISE_ASK_PROVIDER=auto   # ask-lane provider override (default auto =
# #                              # family-derived). Valid: auto |
# #                              # deepseek-direct | openrouter | venice.
# #                              # Explicit value without its key → ValueError
# #                              # (fail-closed, mirrors TORTOISE_EXTRACTOR_PROVIDER);
# #                              # an explicit provider that cannot serve the
# #                              # spec's family (e.g. venice + qwen) → ValueError.
#
# # TORTOISE_ASK_CONNECTED_ASSEMBLY=0             # #2165: pre-routed connected-assembly read path (what/when/why) —
#                                                 # default OFF: flag-off byte-identical legacy point-only retrieval.
#                                                 # ON: private pre-retrieval shape router (current-state/ordering/
#                                                 # compare/interval/date-lookup) fires a pool-REPLACING branch that
#                                                 # renders Object state + dated timeline + EP/provenance evidence for
#                                                 # the single reader call. Master flag: also gates the eval v2-lane
#                                                 # assembly arm (tools/longmem_eval). ask_env_bool semantics.

# ── #2070 retrieval optimisation loop knobs (ask lane only). A1/A5 are
# #    default-ON ask-lane quality levers (set =0 to return to the search
# #    lane's behaviour); A4 defaults OFF until its delta is measured
# #    (#4593); the A7 rerank GATE defaults OFF. The A6 CAP knobs
# #    are not gates — they carry the #4105 measured window
# #    (200/200/16000/derived) and are ask-lane-specific, no longer the
# #    historical shared 40/8000 defaults. The parsed numeric/bool knobs are
# #    env-revertible — a typo never flips one (unset/blank/garbage →
# #    default). The knobs that are NOT covered by that revert rule:
# #    TORTOISE_ASK_SHAPE_DB_URI (a substrate selector — fails LOUD on a
# #    malformed value), TORTOISE_ASK_RERANK_MODEL (taken verbatim; a bad id
# #    degrades at load), and TORTOISE_JSON_MODE (blank/garbage reads as
# #    false). ──
# TORTOISE_ASK_NUMERIC_TOKENS=1      # A1: keep all-digit tokens (money/
#                                    # quantity) in the ask lane's sparse
#                                    # query (SAME-VALUE money questions).
#                                    # Default 1 (ON) for the ask lane; the
#                                    # search lane never passes it.
# TORTOISE_ASK_SEARCH_KEYS_PRF=1     # A4: additive search_keys pseudo-
#                                    # relevance-feedback expansion (bounded
#                                    # second FTS pass; original tokens keep
#                                    # their slots). Default 0 (OFF) until its
#                                    # delta is measured (#4593).
# TORTOISE_ASK_EVIDENCE_BOOST=1      # A5: evidence-mark boost before
#                                    # assembly (stored has_answer marks;
#                                    # product graphs currently have none —
#                                    # zero marks = no-op, byte-identical
#                                    # order). Default 1 (ON).
# TORTOISE_ASK_EVIDENCE_BOOST_ANSWER_STRING=2.0   # A5 multipliers (≥1.0)
# TORTOISE_ASK_EVIDENCE_BOOST_VERBATIM=1.5
# TORTOISE_ASK_EVIDENCE_BOOST_SOURCE=1.15
# TORTOISE_ASK_FUSION_WEIGHTS=       # A3: per-strategy RRF weights override
#                                    # (JSON dict). Default: shared global
#                                    # (TORTOISE_FUSION_WEIGHTS → {"vector":1.5}).
# TORTOISE_ASK_FUSION_K=60           # A3: RRF damping constant (Cormack k).
# TORTOISE_ASK_RETRIEVAL_LIMIT=200   # A6: retrieval-window limit (the
#                                    # result_ids[:limit] cut) — threaded IN
#                                    # TANDEM with the item cap AND the pool;
#                                    # limit >= item_cap, pool >= limit.
# TORTOISE_ASK_CONTEXT_ITEM_CAP=200  # A6: assembled-context item cap.
# TORTOISE_ASK_CONTEXT_TOKEN_CAP=16000 # A6: assembled-context token budget.
# TORTOISE_ASK_CONTEXT_BYTE_CAP=     # A6: assembled-context BYTE ceiling.
#                                    # Unset = DERIVED: max(32768, token_cap*8)
#                                    # so a token raise is never neutralised
#                                    # by a fixed 32 KiB ceiling.
# TORTOISE_ASK_POOL_SIZE=400         # A6: retrieval pool depth; >= limit and,
#                                    # while it fits the 10000 engine bound,
#                                    # >= the SDK's limit*2 candidate floor
#                                    # (env only RAISES the resolved pool).
# TORTOISE_ASK_SHAPE_DB_URI=         # tools/ask_shape_rate.py: docker://…
#                                    # base URI for the D3 instrument's scratch
#                                    # shape-rate graph (unset/blank = embedded
#                                    # lane). Substrate selector, not a
#                                    # measurement knob; any password in the
#                                    # URI is NEVER echoed into the receipt,
#                                    # and a malformed value is refused LOUDLY
#                                    # (it does not fall back to embedded).
# TORTOISE_ASK_RERANK=0              # A7: eval-lane cross-encoder rerank
#                                    # (gated phase 2, default OFF). Truthy-
#                                    # only; needs the embeddings extra.
# TORTOISE_ASK_RERANK_MODEL=cross-encoder/ms-marco-MiniLM-L6-v2
#                                    # (used VERBATIM when set — a bad id is
#                                    # not reverted to the default; it fails
#                                    # at load and degrades the A7 pass)
# TORTOISE_ASK_RERANK_CAP=2          # per-session cap for MMR diversity
# TORTOISE_ASK_RERANK_LAMBDA=0.7     # MMR lambda
# TORTOISE_JSON_MODE=1   # JSON-mode toggle (default 1). The ASK lane pins
#                        # json_mode=False STRUCTURALLY (retrieved memory can
#                        # mention "json" — response_format must never fire on
#                        # a free-text answer); this knob governs the
#                        # extraction lane only. Self-host knob.
#
# ── #1789 S4 delta contract (extraction lane, DEFAULT-ON). S4 (the gap
# #    reviewer) emits ONLY gap additions + full-item corrections; unchanged
# #    S2 items are omitted and preserved by the deterministic E4 merge
# #    (merges-not-replaces). This removes the "re-emit tax" (S4 re-emitting
# #    the complete embed list ≈ 1.4-2× S2 output). REVERT: set the value to a
# #    falsy spelling — the LEGACY complete-list template then renders
# #    byte-identically. FAIL-OPEN ASYMMETRY: any value outside the truthy/
# #    falsy spellings (1/0, true/false, yes/no, on/off) resolves to the
# #    DEFAULT (delta). INLINE COMMENTS ARE NOT STRIPPED, so
# #    `TORTOISE_S4_DELTA=0  # revert` SILENTLY SELECTS DELTA — put comments
# #    on their own line. Observability: `stats.s4_delta` (effective flag),
# #    `stats.s4_delta_empty` (delta ran, found nothing), and
# #    `stats.s4_delta_reemit_suspect` (a delta run whose S4 output was mostly
# #    verbatim re-emissions — the model did not honor the contract).
# TORTOISE_S4_DELTA=0    # unset = DELTA (default-on); 0 = legacy complete-
#                        # list contract (revert trigger)

# ── #3665 cohort cost cap (lane B7) — the pre-spend CEILING on the hosted
# #    capture path. The gate is OFF while TORTOISE_COHORT_COST_CAP_USD is
# #    ABSENT (the default). A present value that is not a positive number
# #    FAILS CLOSED (500) — including 0 or a negative — never a silent disarm.
# #    To turn the cap off, REMOVE the variable. THE TWO VARIABLES GO TOGETHER:
# #    setting CAP_USD without SINCE (or with a SINCE that is not ISO-8601, or
# #    has no UTC offset) FAILS CLOSED (500) on every non-replay capture — a
# #    self-inflicted capture outage. Set both or neither. The cap reads
# #    MEASURED spend from the durable per-period ledger (metering_records:
# #    ask_cost_usd + capture_cost_usd) over the orgs whose
# #    organizations.created_at is after SINCE — a cohort (bounded to 500 orgs;
# #    larger fails closed). ARM ORDER MATTERS: apply BOTH migrations, IN THIS
# #    ORDER — 20260917000001 (the capture_cost_usd column and its increment
# #    RPC), then 20260918000001 (organizations.current_period_start /
# #    current_period_end — the anchor read selects them for EVERY org, so the
# #    cap is unresolvable without this one) — BEFORE setting the cap.
# #    Bounding caveats: refusing at admission bounds REQUESTS, not dollars —
# #    captures already in flight still spend (≤ TORTOISE_CAPTURE_IN_FLIGHT ×
# #    one extraction); and a capture whose provider reported no cost is
# #    recorded as $0.00, so an unmeasured capture under-reads the ceiling.
# TORTOISE_COHORT_COST_CAP_USD=25.0  # the ceiling, USD, per billing period
# TORTOISE_COHORT_COST_SINCE=2026-08-01T00:00:00+00:00  # cohort start (ISO-8601);
#                                    # orgs created after this instant are in it

# ── #4493 fixed/shared SaaS cost ALLOCATION (showback, NOT a measurement).
# #    One override per declared monthly line, in INTEGER CENTS. Unset → the
# #    declared default (fly_base has a dated list-price estimate; the other
# #    four default to 0, meaning "this line must be configured by an operator",
# #    NOT "the cost is zero"). A present value supplies an operator's real
# #    invoice figure and is stamped with the env var as its source, the
# #    observation date as as_of, and is_estimate=False. A PRESENT but
# #    unusable value (non-integer, negative, empty/whitespace, or above
# #    100000000 cents/month) FAILS CLOSED: the line reports `unavailable`, and
# #    no share is published for it — it is never silently replaced by the
# #    default. The writer runs on the hourly retention loop; the figure is an
# #    ALLOCATION (a policy applied to a stated total), never a measured cost.
# #    See docs/ops/cost-allocation.md.
# TORTOISE_COST_FLY_BASE_CENTS=2140       # even basis; monthly, cents
# TORTOISE_COST_FALKORDB_BASE_CENTS=0     # even basis; monthly, cents
# TORTOISE_COST_SUPABASE_BASE_CENTS=0     # even basis; monthly, cents
# TORTOISE_COST_POSTHOG_CENTS=0           # proportional (measured write-ops)
# TORTOISE_COST_SENTRY_CENTS=0            # proportional (measured write-ops)
