# Tortoise Self-Host — Docker image (#338 D2/T4.1)
# Thin single-tenant daemon: MCP Streamable HTTP at /mcp + /health.
# NO Supabase, NO hosted machinery. DB: external FalkorDB via TORTOISE_DB_URI
# (recommended, see docker-compose.yml) or embedded FalkorDBLite (eval only —
# NOT durable; see docs/license-notes.md §4 and the 2026-08-05 incident #101).
#
# Modeled on Dockerfile.hosted (bookworm variant avoids Docker Hub anonymous
# rate limits; build pattern + python-ci job structure).
FROM python:3.12-slim-bookworm

WORKDIR /app

RUN apt-get update && apt-get install -y --no-install-recommends \
    curl build-essential \
    && rm -rf /var/lib/apt/lists/*

COPY requirements.txt .
RUN pip install --no-cache-dir -r requirements.txt

COPY tortoise/ tortoise/
# #1929 (G1 fix): the expansion-pack catalog must ship in the image — the
# editable install at /app resolves `default_packs_dir()`'s repo-root leg to
# /app/packs. The sample transcript ships too (documented mine-conversation
# example + `tortoise demo` work in-container, CWD /app).
COPY packs/ packs/
COPY tests/sample_transcript.txt tests/
COPY pyproject.toml .
# --no-deps on the editable install: dependencies come from the lock-pinned
# requirements.txt above; extras resolve here once, at build time (#494).
# `[backups]` is REQUIRED, not optional (#8610 review): a declared off-box
# target arms the driver, whose `_default_storage()` builds
# `hosted_backup.R2Storage` — which imports `boto3`, shipped only by this
# extra (Dockerfile.hosted installs it too, line 86). Without it the
# RECOMMENDED `docker compose up -d` path validates a target and then fails
# every run at the first upload instead of producing an archive.
RUN pip install --no-cache-dir '.[embeddings]' '.[backups]' \
    && pip install --no-cache-dir -e . --no-deps

# NOTE: unlike Dockerfile.hosted (which bakes the embedding model at build
# time because Fly's sandbox blocks runtime network), self-host runs on the
# operator's own Docker — the model downloads on first use, on demand.
ENV HF_HOME=/app/model
ENV SENTENCE_TRANSFORMERS_HOME=/app/model

EXPOSE 8000

# Embedded-eval DB path (code-review P1, #338): the engine resolves
# TORTOISE_DB_PATH (via config.resolve_db_path) — make /data exist and point
# the default there so the documented `docker run` eval path works and
# /health/ready matches the engine's real DB.
#
# #8497: /data is also the self-host journal's root. The dir is created here (a
# `docker run` without a mount has it on the ephemeral layer, so
# `ensure_selfhost_event_log` will NOT arm a journal there — it gates on /data
# being a real MOUNT); `docker-compose.yml` mounts the named volume and sets
# TORTOISE_EVENT_LOG_BASE_DIR explicitly.
RUN mkdir -p /data/events
ENV TORTOISE_DB_PATH=/data/tortoise.db

CMD ["uvicorn", "tortoise.selfhost:app", "--host", "0.0.0.0", "--port", "8000", "--timeout-graceful-shutdown", "5"]
