sets — 30d is the DEFAULT (market decision), the\n// select exposes Custom + Never, and the mint payload is days-only.\ntest('#2426: create form defaults to the 30d preset with Custom + Never options', () => {\n  assert.match(mainJsx, /newKeyExpiryPreset,\\s*setNewKeyExpiryPreset\\]\\s*=\\s*React\\.useState\\('30'\\)/,\n    'the expiry preset state must DEFAULT to 30d (market default — never None)')\n  assert.match(mainJsx, /\\{ id: 'custom', label: 'Custom date…' \\}/, 'Custom preset option')\n  assert.match(mainJsx, /\\{ id: 'never', label: 'No expiration' \\}/, 'Never preset option')\n  assert.match(mainJsx, /newKeyExpiryPreset === 'custom' && \\(/, 'Custom reveals the date input')\n  assert.match(mainJsx, /type=\"date\"/, 'Custom date input renders')\n})\n\ntest('#2426: mintKey sends expires_in DAYS only — never the expires_at body param', () => {\n  assert.match(mainJsx, /if \\(expiresInDays != null && !Number\\.isNaN\\(expiresInDays\\)\\) payload\\.expires_in = expiresInDays/,\n    'mintKey must translate the preset to expires_in days')\n  // The days-only path is deliberate (avoids the server's mutually-exclusive\n  // dual-param validation entirely) — the create/rotate callers compute days.\n  assert.match(mainJsx, /const days = newKeyExpiryPreset === 'never' \\? null/, 'Never → no param')\n  assert.match(mainJsx, /expiryDaysFromDate\\(newKeyExpiryDate\\)/, 'Custom → computed days')\n  // No expiry-param mint body: every mintKey POST body is the payload object.\n  assert.match(mainJsx, /body: JSON\\.stringify\\(payload\\),/, 'mintKey body is the shared payload')\n  // Never mints must keep the legacy byte-identical shape — never a body that\n  // the server would read as an expiry request.\n  const mintKeySlice = mainJsx.slice(mainJsx.indexOf('async function mintKey'))\n  assert.ok(!/JSON\\.stringify\\(\\{\\s*(name\\??[^}]*expires_at|expires_at)/.test(mintKeySlice),\n    'mintKey must never JSON-stringify an expires_at body key')\n})\n\ntest('#2426: Custom dates are clamped to the 1-366-day window (server 422 parity)', () => {\n  assert.match(mainJsx, /KEY_MAX_EXPIRY_DAYS = 366/, '366-day ceiling constant')\n  assert.match(mainJsx, /Math\\.ceil\\(\\(t - Date\\.now\\(\\)\\) \\/ _MS_PER_DAY\\)/, 'date → whole-days conversion')\n  assert.match(mainJsx, /return \\(days >= 1 && days <= KEY_MAX_EXPIRY_DAYS\\) \\? days : null/, '1-366 clamp')\n})\n\n// 2. Keys-table columns (Name | Prefix | Created | Last used | Expires |\n// Status) + fmtExpiry states.\ntest('#2476/#2426: the keys table is Name | Prefix | Created | Last used | Expires | Status', () => {\n  const header = mainJsx.match(/<th scope=\"col\">Name<\\/th>.*<\\/thead>/s)\n  assert.ok(header, 'keys-table thead found')\n  const cols = header[0].match(/<th scope=\"col\">([^<]*)<\\/th>/g) || []\n  const names = cols.map((c) => c.replace(/<[^>]+>/g, ''))\n  assert.ok(names.indexOf('Created') !== -1 && names.indexOf('Last used') !== -1\n    && names.indexOf('Expires') !== -1 && names.indexOf('Status') !== -1,\n    `Expected Created | Last used | Expires | Status columns, got: ${names}`)\n  assert.ok(names.indexOf('Created') < names.indexOf('Last used'), 'Last used after Created')\n  assert.ok(names.indexOf('Last used') < names.indexOf('Expires'), 'Expires after Last used')\n  assert.ok(names.indexOf('Expires') < names.indexOf('Status'), 'Expires before Status')\n  assert.match(mainJsx, /colSpan=\"7\"/, 'empty-state colSpan widened for the 7th column')\n})\n\ntest('#2476: the Last-used cell renders formatRelativeTime output and a plain-text Never', () => {\n  // The cell must feed formatRelativeTime (memory-sources util parity) and\n  // fall back to PLAIN 'Never' (no span.dim — #2426: the status cell's dim\n  // identifies 'disabled'; a Never-in-dim cell double-matched e2e strict\n  // mode). Clock: Date.now() per render (the App-level `now` only ticks on\n  // the Overview skeleton and would freeze on the keys tab).\n  assert.match(mainJsx, /const rel = formatRelativeTime\\(lu, Date\\.now\\(\\)\\)/, 'cell uses formatRelativeTime')\n  assert.match(mainJsx, /if \\(!rel\\) return 'Never'/, \"never-used rows render plain 'Never'\")\n  assert.match(mainJsx, /title=\\{`Last used \\$\\{fmtTime\\(lu\\)\\}`\\}/, 'used rows carry the absolute-date title tooltip')\n  // Structural dim-exclusion guard (#2426): the whole Last-used cell body\n  // (from the lu binding to the closing td) must never wrap the Never fallback\n  // (or the label) in a span.dim. Slice-based so the guard cannot rot into a\n  // vacuous never-matching regex.\n  const cellStart = mainJsx.indexOf('const lu = k.last_used_at')\n  assert.ok(cellStart !== -1, 'Last-used cell lu binding found')\n  const cellBody = mainJsx.slice(cellStart, mainJsx.indexOf('})()}</td>', cellStart))\n  assert.ok(cellBody.includes(\"return 'Never'\"), 'plain-text Never branch inside the cell')\n  assert.ok(!cellBody.includes('className=\"dim\"'),\n    'the Last-used Never must never sit in a span.dim cell (#2426)')\n})\n\ntest('#2426: fmtExpiry renders Never / amber in-N-days / terminal expired', () => {\n  assert.match(mainJsx, /function fmtExpiry\\(iso, now = Date\\.now\\(\\)\\)/, 'fmtExpiry helper exists')\n  assert.match(mainJsx, /if \\(!iso\\) return \\{ text: 'Never', cls: '' \\}/, 'Never when null')\n  assert.match(mainJsx, /text: 'expired', cls: 'expired'/, 'terminal expired state')\n  assert.match(mainJsx, /days <= KEY_SOON_DAYS/, 'expiring-soon threshold')\n  assert.match(mainJsx, /\\$\\{dateText\\} · in \\$\\{days\\} day/, 'amber in-N-days label')\n  // Tombstone: an expired row is still RENDERED (no filter hides it).\n  assert.match(mainJsx, /const ex = fmtExpiry\\(k\\.expires_at\\)/, 'Expires cell renders from the row')\n})\n\ntest('#2426: CSS states for expiring (amber) and expired (terminal red) exist', () => {\n  assert.match(indexCss, /\\.expiring \\{ color: #fbbf24; \\}/, 'amber .expiring rule')\n  assert.match(indexCss, /\\.expired \\{ color: var\\(--red\\); \\}/, 'terminal .expired rule')\n})\n\n// 3. Show-once card + rotate carry-over.\ntest('#2426: the show-once key card states the expiry (server echo / never)', () => {\n  assert.match(mainJsx, /setNewKeyExpiresAt\\(\\(mk && mk\\.expires_at\\) \\|\\| null\\)/,\n    'create captures the server expiry echo into the modal card')\n  // #2735: rotate's reveal moved to its OWN `rotatedKey` state (so the create\n  // modal's dismiss cannot destroy an unread replacement) — the expiry echo\n  // must ride it, or a rotated key silently reads 'never expires'.\n  // #4342: the plaintext is derived ONCE and a plaintext-less mint is REFUSED\n  // before the latch (the pre-fix `|| ''` expression latched an empty reveal).\n  // Scoped to regenerateKey's body — createKey derives the same local name.\n  // Both pins are kept so neither the refusal NOR the expiry echo can be\n  // dropped silently.\n  const rotStart = mainJsx.indexOf('async function regenerateKey(')\n  assert.notEqual(rotStart, -1, 'regenerateKey must exist')\n  const rotBody = mainJsx.slice(rotStart, mainJsx.indexOf('\\n  async function ', rotStart + 1))\n  assert.match(rotBody, /const plaintext = revealableMintPlaintext\\(mk\\)/,\n    'rotate derives the replacement plaintext through the shareable non-blank-string predicate')\n  assert.match(rotBody, /if \\(!plaintext\\) \\{/, 'rotate must refuse a plaintext-less mint')\n  // #4429: the latch moved ABOVE the team-identity guard — the rotate is\n  // destructive server-side, so its response is the only delivery of the\n  // replacement's plaintext and a switch across the RTT must not drop it.\n  // #8249: the refusal missed that move (its copy names this team's row, which\n  // was read as \"it may not render elsewhere\" — but scoping where it renders\n  // is the record key, not the guard), so it stayed after the guard and a\n  // switch dropped it.\n  // #8255: the catch's ambiguous-failure disclosure missed it too — the guard\n  // was the catch's FIRST statement, so a switch across the RTT of a failed\n  // rotate returned before the re-read and the user was told nothing at all.\n  //\n  // The pins below are anchored on the CONTENT each latch writes rather than on\n  // a bare `setRotateOutcomes((prev) =>` (regenerateKey now has several,\n  // including the #8255 clear hooks), and \"precedes the guard\" is asserted\n  // against the 2xx path's own guard — the FIRST one in the function — so a\n  // latch that drifts back below it reddens.\n  const firstGuard = rotBody.indexOf('if (orgIdRef.current !== _teamAtCall) return')\n  assert.notEqual(firstGuard, -1, 'regenerateKey must keep the stale-team guard')\n  const beforeGuard = rotBody.slice(0, firstGuard)\n  assert.ok(beforeGuard.includes('[_teamAtCall]: { plaintext, expiresAt: (mk && mk.expires_at) || null, warning }'),\n    'the outcome latch must precede the team-identity guard (#4429)')\n  assert.ok(rotBody.indexOf('if (plaintext) {') < rotBody.indexOf('[_teamAtCall]: { plaintext, expiresAt:'),\n    'the REVEAL latch is gated on a revealable plaintext — a plaintext-less rotate latches no reveal (#4342); since #8249 it latches the refusal instead')\n  // #8249/#8255: BOTH later latches precede the SAME guard — the guard scopes\n  // WHERE an outcome renders, it must not decide WHETHER the user is told. The\n  // plaintext-less refusal and the ambiguous-failure notice are the two branches\n  // that had no retained home: both used to be written after the guard (the\n  // refusal into the transient `error` slot), so a team switch across the rotate\n  // RTT dropped the only notice that the rotate destroyed a key or left one in\n  // an unknown state.\n  assert.ok(beforeGuard.includes(\"refusal: revealRefusalFor('replacement key\"),\n    'the refusal latch must precede the team-identity guard too (#8249)')\n  assert.match(rotBody, /refusal: revealRefusalFor\\('replacement key\\\\u2019s value'\\)/,\n    '#8249: the plaintext-less branch latches the refusal on the per-team record, not in the error slot'\n    + ' — and routes the prefix through the shared revealRefusalFor contract (#4370) instead of hardcoding it')\n  // #8249 (review P1): the refusal record is also the reveal's home, so the\n  // latch must MERGE the prior reveal (plaintext + expiry) and partial-state\n  // warning forward — a plaintext-less response delivers no secret and must\n  // not overwrite a live unread one minted by an earlier rotate on the team.\n  assert.match(rotBody, /plaintext: prior\\.plaintext \\|\\| ''/,\n    'the plaintext-less latch must carry a prior same-team reveal forward, never blank it')\n  assert.match(rotBody, /expiresAt: prior\\.expiresAt \\|\\| null/,\n    'the prior reveal expiry rides with the carried-forward plaintext')\n  assert.match(rotBody, /warning: \\(mk && mk\\.warning\\) \\? String\\(mk\\.warning\\) : \\(prior\\.warning \\|\\| ''\\)/,\n    'a prior partial-state warning survives a warning-less plaintext-less response too')\n  assert.doesNotMatch(rotBody, /setError\\(`The server did not return the replacement key/,\n    '#8249: the refusal must not ride the un-keyed, transient `error` slot — that is what a switch dropped')\n  // #8255: the catch's ambiguous-failure disclosure was the last one with no\n  // retained home. Its latch must precede the SAME guard (#8249's ruling: the\n  // guard scopes WHERE an outcome renders, never WHETHER the user is told), or a\n  // switch across the RTT of a failed rotate leaves the destructive one-shot call\n  // with an unknown outcome and no notice at all.\n  const catchAt = rotBody.indexOf('} catch (e) {')\n  assert.notEqual(catchAt, -1, 'regenerateKey must keep its catch')\n  const catchBeforeGuard = rotBody.slice(\n    catchAt, rotBody.indexOf('if (orgIdRef.current !== _teamAtCall) return', catchAt))\n  assert.ok(catchBeforeGuard.includes('ambiguous: `The rotate request failed'),\n    'the ambiguous-failure latch must precede the catch\\u2019s team-identity guard too (#8255)')\n  assert.match(rotBody, /ambiguous: `The rotate request failed\\$\\{why \\? ` \\(\\$\\{why\\}\\)` : ''\\}, and its outcome could not be confirmed/,\n    '#8255: the retained form is the WEAKER honest one — no row truth is readable for a team the user has left')\n  assert.doesNotMatch(rotBody, /ambiguous: `[^`]*shows as revoked/,\n    '#8255: the retained notice must never claim a row state it cannot read')\n  // #8255 (review P2): the clearer is ROW-scoped. The notice names one row, so a\n  // clear that cannot name that same key (or names none) must leave it latched —\n  // an attempt-start, team-wide clear retired the notice for key A when the user\n  // rotated key B, and for outcomes that resolve nothing at all (a 402, or a\n  // definite 4xx that loses the team at its guard). The behaviour pins for all\n  // three cases live in keyRotateEmptyRevealExec.test.js; these are the cheap\n  // shape backstops.\n  assert.match(mainJsx, /if \\(!keyId \\|\\| cur\\.ambiguousKeyId !== keyId\\) return prev/,\n    'the ambiguity clearer must be scoped to the key the notice names (#8255 review P2)')\n  assert.match(rotBody, /ambiguousKeyId: keyId/,\n    'and the latch must write that subject beside the notice')\n  assert.doesNotMatch(rotBody, /clearRotateAmbiguity\\(_teamAtCall\\)/,\n    'no team-wide clear may run at attempt start — nothing is resolved at that point (#8255 review P2)')\n  // #8255 (review P2, second cut): the rule is row-scoped on the WRITE side too.\n  // An unconditional latch overwrote a retained notice naming a DIFFERENT,\n  // still-unresolved row — the same silent retire the clearer was scoped to\n  // stop, reachable without a team switch (two lost responses, two rows).\n  assert.match(rotBody, /if \\(prior\\.ambiguous && prior\\.ambiguousKeyId && prior\\.ambiguousKeyId !== keyId\\) return prev/,\n    'the latch must refuse to overwrite another row’s unresolved notice (#8255 review P2)')\n  assert.match(rotBody, /has already been revoked/, 'the refusal must state the OLD key is already revoked')\n  assert.match(rotBody, /\\[_teamAtCall\\]: \\{ plaintext, expiresAt: \\(mk && mk\\.expires_at\\) \\|\\| null, warning \\}/,\n    'rotate captures the server expiry echo + the partial-state warning into the per-team outcome')\n  assert.match(mainJsx, /expires \\{fmtExpiryDate\\(newKeyExpiresAt\\)\\}/, 'modal card shows the create expiry date')\n  assert.match(mainJsx, /expires \\{fmtExpiryDate\\(rotateOutcome\\.expiresAt\\)\\}/, 'rotate reveal shows the replacement expiry date')\n  assert.match(mainJsx, /never expires/, 'card states Never explicitly')\n})\n\ntest('#2426: rotate re-applies the old row lifetime span + confirm states replacement expiry', () => {\n  assert.match(mainJsx, /function lifetimeDaysFromRow\\(row\\)/, 'lifetime-span helper exists')\n  assert.match(mainJsx, /lifetimeDaysFromRow\\(oldRow\\)/, 'rotate mint passes the span as expires_in')\n  assert.match(mainJsx, /The replacement never expires \\(same as this key\\)\\./, 'Never stays Never in the confirm')\n  assert.match(mainJsx, /The replacement expires \\$/, 'confirm names the replacement expiry date')\n})\n\n// 4. isManagedKey — the CRITICAL pre-existing-bug fix: bootstrap-exclusion\n// ONLY (any expiring durable must stay a table row).\ntest('#2426: isManagedKey excludes bootstrap only — no expires_at exclusion may return', () => {\n  const start = sessionKeyJs.indexOf('export function isManagedKey')\n  const body = sessionKeyJs.slice(start, sessionKeyJs.indexOf('export function', start + 10))\n  assert.ok(!body.includes('expires_at'),\n    `isManagedKey must be bootstrap-exclusion only (an expires_at check would hide every expiring key): ${body}`)\n  assert.match(body, /created_via === 'bootstrap'/, 'bootstrap rows stay excluded')\n  assert.match(body, /return !\\(k\\.created_via === 'bootstrap'\\)/, 'bootstrap-only predicate')\n  // The embed-safe derivations (usableDurableRows / durableConnectKey) keep\n  // their no-expiry filters — the embed surface stays Never-keys-only.\n  //\n  // #8228 RE-PIN, same guarantee. The explicit `!k.expires_at` this assertion\n  // used to read inside `usableDurableRows` moved into the ONE row-aliveness\n  // atom (`rowDeadReason`) that `usableDurableRows` now composes — the #2426\n  // decision is unchanged (an expiring durable is still not routable, still\n  // reported as source 'expiring', still never embed-safe), but the condition\n  // is pinned WHERE IT IS DECLARED plus the composition that carries it into the\n  // routing path. Pinning the consumer's spelling instead would pin duplication,\n  // which is the drift #8228 removed. Both halves are asserted so neither the\n  // atom's arm nor its use by the router can be dropped silently.\n  const atomStart = sessionKeyJs.indexOf('export function rowDeadReason')\n  const atom = sessionKeyJs.slice(atomStart, sessionKeyJs.indexOf('export function rowAlive', atomStart))\n  assert.ok(atomStart > -1 && atom.includes('expires_at'),\n    '#8228: the row-aliveness atom must exist and carry the expiry condition')\n  assert.match(atom, /if \\(row\\.expires_at\\) return 'expiring'/,\n    'the atom excludes expiring rows explicitly (the #2426 Never-only embed policy)')\n  const usableStart = sessionKeyJs.indexOf('export function usableDurableRows')\n  const usable = stripComments(\n    sessionKeyJs.slice(usableStart, sessionKeyJs.indexOf('export function', usableStart + 10)))\n  assert.match(usable, /isManagedKey\\(k\\) && rowAlive\\(k\\)/,\n    'usableDurableRows composes the atom — the routing path cannot lose the expiry arm')\n  assert.doesNotMatch(usable, /revoked_at|expires_at|created_via|enabled/,\n    'usableDurableRows must not re-declare the row-aliveness conditions (#8228)')\n  assert.match(sessionKeyJs, /if \\(dead\\) return \\{ key: '', durable: false, source: dead \\}/,\n    'paste classifier reports the atom\\'s own reason — source expiring stays distinct from bootstrap')\n})\n\n// 5. Wizard embed surface — Never-keys-only policy.\ntest('#2426/#2827: the connect wizard never embeds an expiring key', () => {\n  assert.match(mainJsx, /check\\.source === 'expiring'/, 'paste validation rejects expiring rows')\n  assert.match(mainJsx, /It expires, and a key embedded in an agent must never expire/, 'truthful expiring reason')\n})\n"],"names":[],"mappings":"AAmBA;AACA;AACA;AACA;AACA;AACA;AAxBA,CAAC,CAAC,CAAC,iBAAiB,CAAC,IAAI,CAAC,EAAE,CAAC,CAAC,CAAC,CAAC,IAAI,CAAC,YAAY,CAAC,GAAG,CAAC,GAAG,CAAC,UAAU,CAAC;AACrE,CAAC,CAAC,CAAC,SAAS,CAAC,CAAC,EAAE,CAAC,GAAG,CAAC,GAAG,CAAC,SAAS,CAAC,EAAE,CAAC,KAAK,CAAC,CAAC,IAAI,CAAC,CAAC,CAAC,IAAI,CAAC,IAAI,CAAC,GAAG,CAAC,UAAU,CAAC;AAC7E,CAAC,CAAC,CAAC,GAAG,CAAC,CAAC,IAAI,CAAC,EAAE,CAAC,OAAO,CAAC,KAAK,CAAC,EAAE,CAAC,IAAI,CAAC,GAAG,CAAC,CAAC,SAAS,CAAC,KAAK,CAAC,OAAO,CAAC,CAAC,CAAC,GAAG,CAAC,CAAC;AAC1E,CAAC,CAAC,CAAC,UAAU,CAAC,EAAE,CAAC,CAAC,IAAI,CAAC,UAAU,CAAC,CAAC,IAAI,CAAC,MAAM,CAAC,EAAE,CAAC,UAAU,CAAC,IAAI,CAAC,EAAE,CAAC,CAAC,CAAC,CAAC;AACxE,CAAC,CAAC,CAAC,KAAK,CAAC,KAAK,CAAC,IAAI,CAAC,GAAG,CAAC,OAAO,CAAC,CAAC,CAAC,IAAI,CAAC,OAAO,CAAC,MAAM,CAAC,IAAI,CAAC,WAAW;AACtE,CAAC,CAAC,CAAC,CAAC,CAAC,CAAC,CAAC,CAAC,GAAG,CAAC,MAAM,CAAC,IAAI,CAAC,CAAC,CAAC,MAAM,CAAC,OAAO,CAAC,CAAC,GAAG,CAAC,OAAO,CAAC,CAAC,CAAC,MAAM,CAAC,CAAC,CAAC,KAAK,CAAC;AACvE,CAAC,CAAC,CAAC,CAAC,CAAC,CAAC,CAAC,CAAC,MAAM,CAAC,EAAE,CAAC,UAAU,CAAC,IAAI,CAAC,IAAI,CAAC,CAAC,KAAK,CAAC,GAAG,CAAC,UAAU,CAAC,IAAI,CAAC,KAAK,CAAC;AACxE,CAAC,CAAC,CAAC,CAAC,CAAC,CAAC,CAAC,CAAC,GAAG,CAAC,IAAI,CAAC,KAAK,CAAC,OAAO,CAAC,CAAC,IAAI,CAAC,CAAC,CAAC,MAAM,CAAC,CAAC,CAAC,OAAO,CAAC,CAAC,CAAC,IAAI,CAAC,IAAI,CAAC,CAAC,CAAC,OAAO,CAAC;AAC9E,CAAC,CAAC,CAAC,CAAC,CAAC,CAAC,CAAC,CAAC,MAAM,CAAC,CAAC,GAAG,CAAC,EAAE,CAAC,GAAG,CAAC,SAAS,CAAC,UAAU,CAAC,CAAC,KAAK,CAAC,CAAC,CAAC,KAAK,CAAC,EAAE,CAAC,CAAC,CAAC,IAAI,CAAC;AACzE,CAAC,CAAC,CAAC,CAAC,CAAC,CAAC,CAAC,CAAC,QAAQ,CAAC,OAAO,CAAC,CAAC,CAAC,CAAC,GAAG,CAAC,CAAC,IAAI,CAAC,IAAI,CAAC,IAAI,CAAC,IAAI,CAAC,CAAC,QAAQ,CAAC,IAAI,CAAC,KAAK;AACzE,CAAC,CAAC,CAAC,CAAC,CAAC,CAAC,CAAC,CAAC,KAAK,CAAC,IAAI,CAAC,KAAK,CAAC;AACzB,CAAC,C