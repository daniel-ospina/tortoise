inferred. */\n    takedown?: (\n      path: string, token: string,\n    ) => { quarantine: string; raw: string } | undefined;\n    /** ⛔ TEST SEAM for the OBSTRUCTION CLEAR's window — the same reason `takedown`\n     *  exists above. `clearUnusableClaimPath` takes a `rename` seam already, and a\n     *  test can only stand inside the window that opens between the caller's look\n     *  and the removal by SUPPLYING that seam through `acquireDrainClaim`'s call.\n     *  Without it the primitive can be pinned but the DISPOSITION cannot: the\n     *  `held` arm is the whole difference between \"somebody holds it, do nothing\"\n     *  and \"run the pass UNCLAIMED beside a live claim\", and the Python twin's\n     *  end-to-end test (`test_a_peer_claim_landing_in_the_clear_window_is_NOT_an\n     *  _unclaimed_pass`) had no Pi counterpart (#14480 review, F2). */\n    clearClaimPath?: (path: string) => ClaimPathClear;\n  },\n): DrainClaim | undefined {\n  const ttlMs = opts.ttlMs ?? DRAIN_CLAIM_TTL_MS;\n  const host = opts.host ?? thisHost();\n  const bootId = opts.bootId ?? readBootId();\n  const alive = opts.alive ?? pidAlive;\n  const path = drainClaimPathFor(dir);\n  const markRaced = (): void => {\n    if (opts.state) opts.state.raced = true;\n  };\n  try {\n    mkdirSync(dir, { recursive: true, mode: 0o700 });\n  } catch {\n    // An unmakeable spool root cannot hold a spool entry either, so the pass\n    // about to run can only report the broken spool. Run UNCLAIMED rather than\n    // hide that report (the false-PASS direction is the worse error) — and say\n    // so on the summary.\n    return undefined;\n  }\n  for (let attempt = 0; attempt < 2; attempt += 1) {\n    const nowMs = opts.nowMs ?? Date.now();\n    const token = randomToken();\n    const record: DrainClaimRecord = {\n      version: DRAIN_CLAIM_VERSION,\n      token,\n      leg: opts.leg,\n      pid: process.pid,\n      host,\n      ...(bootId ? { boot_id: bootId } : {}),\n      started_at: nowMs,\n      expires_at: nowMs + ttlMs,\n    };\n    const tmp = join(dir, `${DRAIN_CLAIM_FILE}.tmp-${process.pid}-${token}`);\n    try {\n      writeFileSync(tmp, `${JSON.stringify(record)}\\n`, { mode: 0o600 });\n      linkSync(tmp, path);\n    } catch (err) {\n      const code = (err as NodeJS.ErrnoException)?.code;\n      if (code !== \"EEXIST\") {\n        try { unlinkSync(tmp); } catch { /* best effort */ }\n        return undefined;\n      }\n      try { unlinkSync(tmp); } catch { /* best effort */ }\n      let raw: string | undefined;\n      try {\n        // Same `lstat` gate as `readDrainClaim` (a FIFO would block here too).\n        raw = lstatSync(path).isFile() ? readFileSync(path, \"utf8\") : undefined;\n      } catch {\n        raw = undefined;\n      }\n      let parsed: unknown;\n      try {\n        parsed = raw === undefined ? undefined : JSON.parse(raw);\n      } catch {\n        parsed = undefined;\n      }\n      if (!claimIsStale(parsed, { nowMs, host, bootId, alive })) return undefined;\n      if (raw === undefined) {\n        // The read failed. ⛔ WHAT KIND OF OBJECT IS THERE decides whether we may\n        // delete it: a transient local error (EMFILE, EIO, EACCES after a mode\n        // drift) on a perfectly good REGULAR file is NOT evidence that the file is\n        // junk. The doctrine everywhere else here is \"unprovable reads as ALIVE\",\n        // so a regular claim we could not read is HONOURED (`undefined` = somebody\n        // holds it) and never unlinked — routing it to the clear path deleted a\n        // LIVE claim (review P0).\n        let mode: ReturnType<typeof lstatSync> | undefined;\n        try {\n          mode = lstatSync(path);\n        } catch {\n          mode = undefined;  // it vanished (a peer released); retry the link\n        }\n        if (!mode) { markRaced(); continue; }\n        if (mode.isFile()) return undefined;\n        // A directory, symlink, FIFO/socket or device: corruption, not a holder.\n        // Leaving it would `EEXIST` every future attempt — a permanent block.\n        const cleared = (opts.clearClaimPath ?? clearUnusableClaimPath)(path);\n        if (cleared === \"refused\") {\n          if (opts.state) opts.state.obstruction = path;\n          return undefined;\n        }\n        if (cleared === \"held\") {\n          // A peer's claim appeared in the window and was put back: there IS a\n          // holder, so answer CONTENTION (no obstruction marker). Reporting it as\n          // an obstruction ran the pass UNCLAIMED beside a live claim.\n          //\n          // ⛔ \"HELD\" WITH NOTHING AT THE PATH IS A FAILED RESTORE (review, cycle 16,\n          // P1): the object is the only copy and now sits in the quarantine, so the\n          // caller's `readDrainClaim` arm finds no record and would fall through to\n          // its UNCLAIMED arm. Mark the lost race instead, so the caller fails CLOSED\n          // and does not name a holder it cannot see.\n          if (!existsSync(path)) markRaced();\n          return undefined;\n        }\n        // `gone` / `done`: the path changed, so RETRY — the next tick either installs\n        // our claim or judges whatever a peer put there.\n        // ⛔ AND IT IS A LOST RACE, so it is MARKED like every other one. This was\n        // the only lost-race arm that did not: two exhausted attempts that way left\n        // `state` empty and the path empty, so `flushSpool` read it as \"this root\n        // cannot hold a claim\", ran the whole pass UNCLAIMED, and stamped\n        // `claimUnavailable` with the default reason — \"the spool root cannot hold\n        // a claim\" — which is FALSE (the root is fine; the object moved). The\n        // Python twin fails closed in the same state (`acquire` → `None` →\n        // `held_by_claim`). Reachability is narrow (two consecutive vanishes), which\n        // is why this stayed a P3 rather than a P1 (#14480 review, F4).\n        markRaced();\n        continue;\n      }\n      // ATOMIC TAKEDOWN, then verify in quarantine — see `takedownClaim`.\n      const moved = takedownClaim(path, token);\n      if (!moved) { markRaced(); continue; }  // a peer moved it first; the next attempt decides\n      if (!disposeQuarantine(moved.quarantine, moved.raw, path, raw)) {\n        // We displaced a NEWER claim than the one we judged stale. It is\n        // restored; give up this tick — and this is a LOST RACE, so the path may\n        // be momentarily empty while the winner installs (see `state.raced`).\n        markRaced();\n        return undefined;\n      }\n      // The stale claim IS gone and our own `linkSync` never landed, so the path is\n      // empty for the same reason as every other lost takeover: a peer is\n      // installing. ⛔ THIS ARM WAS MISSED by the first cut of `state.raced`\n      // (#14423 cycle-6 review, P2) — it fell through to the loop-end `undefined`,\n      // which `flushSpool` read as \"the root cannot hold a claim\" and ran the pass\n      // UNCLAIMED beside that peer.\n      markRaced();\n      continue;\n    }\n    try { unlinkSync(tmp); } catch { /* best effort */ }\n    let renewedAt = nowMs;\n    return {\n      token,\n      renew(nowMsArg?: number): boolean {\n        const at = nowMsArg ?? Date.now();\n        // Read the RAW record first: the CAS below compares BYTES, and a\n        // re-serialised object is not proof of what was on disk. lstat-gated, so a\n        // FIFO at the claim path cannot hang the refresh (the Python twin's\n        // `read_claim` had that bug; see `readDrainClaim`).\n        let rawNow: string;\n        try {\n          if (!lstatSync(path).isFile()) return false;\n          rawNow = readFileSync(path, \"utf8\");\n        } catch {\n          return false;\n        }\n        let current: unknown;\n        try {\n          current = JSON.parse(rawNow);\n        } catch {\n          return false;\n        }\n        if (!current || typeof current !== \"object\" || Array.isArray(current)) return false;\n        if ((current as Record<string, unknown>).token !== token) return false;\n        // ⛔ An ALREADY-EXPIRED claim is never resurrected (review finding): a\n        // holder that overran its lease is still the token owner on disk and must\n        // not overwrite the successor a peer legitimately installed.\n        const expires = (current as Record<string, unknown>).expires_at;\n        if (typeof expires === \"number\" && at >= expires) return false;\n        // ⛔ THE REFRESH IS A COMPARE-AND-SWAP ON THE INODE, not a read followed by\n        // a `rename`. The earlier version read, renamed, and then READ BACK to\n        // verify — which reads the bytes this process just wrote, so it always\n        // matched and the guard was vacuous. The race it claimed to cover is real\n        // (a peer whose takeover lands between our read and our rename has its\n        // fresh claim clobbered, and both processes then hold the spool for up to\n        // `ttl/3`), and the trigger is a renewal landing at the deadline. Reusing\n        // `takedownClaim` (the same arbiter `acquire` uses) and installing the\n        // refresh with `linkSync` makes the window a real CAS: `EEXIST` means a\n        // peer claimed in it and THEIR claim stands, which is the safe direction.\n        // The Python twin states the same reasoning; this is one protocol (R6).\n        // ⛔ THE SAME SEAM `release` USES, for the same reason: the CAS's window\n        // (between our takedown and our install) is a fact about ORDER, and without\n        // a way to stand inside it a test can only pin the primitive. The Python\n        // twin's window test monkeypatches `_takedown`; this is the Pi equivalent\n        // (#14423 cycle-7 review, P2 — the earlier Pi test called `linkSync`\n        // directly, so reverting this line to `renameSync` left it green).\n        const moved = (opts.takedown ?? takedownClaim)(path, token);\n        if (!moved) return false;\n        if (moved.raw !== rawNow) {\n          // We displaced a NEWER record than the one we judged — dispose puts it\n          // back, and we are no longer the holder.\n          disposeQuarantine(moved.quarantine, moved.raw, path, rawNow);\n          return false;\n        }\n        const next: DrainClaimRecord = {\n          ...record,\n          started_at: record.started_at,\n          expires_at: at + ttlMs,\n        };\n        const tmpPath = join(dir, `${DRAIN_CLAIM_FILE}.tmp-${process.pid}-${token}`);\n        try {\n          writeFileSync(tmpPath, `${JSON.stringify(next)}\\n`, { mode: 0o600 });\n          try {\n            linkSync(tmpPath, path);  // create-if-absent: a peer's claim is never clobbered\n          } finally {\n            try { unlinkSync(tmpPath); } catch { /* best effort */ }\n          }\n        } catch (err) {\n          if ((err as NodeJS.ErrnoException).code === \"EEXIST\") {\n            // A peer holds the claim now. Their record STANDS; ours is obsolete.\n            disposeQuarantine(moved.quarantine, moved.raw, path, rawNow);\n            return false;\n          }\n          // A failed WRITE is not \"not ours\" (review finding): reporting it as a\n          // lost claim aborts a pass that still owns the spool AND parks the claim\n          // with a live pid, so every later pass reads `heldByClaim` for up to the\n          // full lease while the operator is told a peer took it. Put ours BACK.\n          try { linkSync(moved.quarantine, path); } catch { /* a peer has it */ }\n          try { unlinkSync(moved.quarantine); } catch { /* best effort */ }\n          const still = readDrainClaim(dir);\n          return !!still && still.token === token;\n        }\n        disposeQuarantine(moved.quarantine, moved.raw, path, rawNow);\n        renewedAt = at;\n        return true;\n      },\n      renewIfDue(nowMsArg?: number): boolean {\n        const at = nowMsArg ?? Date.now();\n        if (at - renewedAt < ttlMs / 3) return true;\n        return this.renew(at);\n      },\n      reclaim(nowMsArg?: number): boolean {\n        const at = nowMsArg ?? Date.now();\n        let rawNow: string;\n        try {\n          if (!lstatSync(path).isFile()) return false;\n          rawNow = readFileSync(path, \"utf8\");\n        } catch {\n          return false;\n        }\n        let parsed: unknown;\n        try {\n          parsed = JSON.parse(rawNow);\n        } catch {\n          return false;\n        }\n        if (!parsed || typeof parsed !== \"object\"\n            || (parsed as Record<string, unknown>).token !== token) {\n          return false;  // a peer's record: their claim stands\n        }\n        // The same CAS `renew` uses: move aside, compare the bytes we judged,\n        // install with `link` so a peer that claimed in the window is never clobbered.\n        const moved = takedownClaim(path, token);\n        if (!moved) return false;\n        if (moved.raw !== rawNow) {\n          disposeQuarantine(moved.quarantine, moved.raw, path, rawNow);\n          return false;\n        }\n        const fresh: DrainClaimRecord = {\n          ...record,\n          started_at: record.started_at,\n          expires_at: at + ttlMs,\n        };\n        try {\n          // ⛔ The quarantined bytes are the CAS evidence and the RESTORE source: they\n          // are never rewritten. The fresh record goes to a scratch name and is\n          // installed with `linkSync` (create-if-absent), so a peer that claimed in the\n          // window keeps its claim.\n          const tmpPath = join(dir, `${DRAIN_CLAIM_FILE}.tmp-${process.pid}-${token}`);\n          writeFileSync(tmpPath, `${JSON.stringify(fresh)}\\n`, { mode: 0o600 });\n          try {\n            linkSync(tmpPath, path);\n          } finally {\n            try { unlinkSync(tmpPath); } catch { /* best effort */ }\n          }\n        } catch {\n          // Put back the record we moved aside: never lose a lease to a failed refresh.\n          try { linkSync(moved.quarantine, path); } catch { /* a fourth holder has it */ }\n          try { unlinkSync(moved.quarantine); } catch { /* best effort */ }\n          return false;\n        }\n        try { unlinkSync(moved.quarantine); } catch { /* best effort */ }\n        renewedAt = at;\n        return true;\n      },\n      release(): boolean {\n        // ⛔ A NOT-OURS RELEASE TOUCHES NOTHING — it reads and compares BEFORE it\n        // moves anything (mirror of `tortoise/drain_claim.py`'s `release`, added in\n        // the same review cycle: the two legs must not diverge on the property the\n        // module docstring states). Taking the successor's claim aside first made\n        // this promise false in a THREE-process interleaving: a third process\n        // installing into the momentarily-empty path made the restore `linkSync`\n        // fail `EEXIST`, and the successor's quarantined bytes were then unlinked —\n        // a live claim destroyed by a release that was trying to be polite\n        // (#14423 cycle-6 review, P2; reproduced with these seams).\n        let rawNow: string;\n        try {\n          if (!lstatSync(path).isFile()) return false;\n          rawNow = readFileSync(path, \"utf8\");\n        } catch {\n          return false;  // gone, unreadable, or not a regular file: nothing to release\n        }\n        let parsed: unknown;\n        try {\n          parsed = JSON.parse(rawNow);\n        } catch {\n          return false;\n        }\n        if (!parsed || typeof parsed !== \"object\"\n            || (parsed as Record<string, unknown>).token !== token) {\n          return false;  // not ours: leave it exactly where it is\n        }\n        // Ours. The takedown's quarantine compare is what makes the disposal safe\n        // against a peer that replaces the record between the read above and the\n        // rename below.\n        const moved = (opts.takedown ?? takedownClaim)(path, token);\n        if (!moved) return false;\n        if (moved.raw !== rawNow) {\n          disposeQuarantine(moved.quarantine, moved.raw, path, \"\\u0000<not-ours>\");\n          return false;\n        }\n        try { unlinkSync(moved.quarantine); } catch { /* best effort */ }\n        return true;\n      },\n    };\n  }\n  return undefined;\n}\n\nfunction randomToken(): string {\n  // 16 hex chars, the same width the Python leg mints — an OWNERSHIP value, not\n  // a secret, so `Math.random` would do, but a per-leg-predictable token makes a\n  // confused-deputy delete conceivable for no gain.\n  let out = \"\";\n  for (let i = 0; i < 16; i += 1) {\n    out += Math.floor(Math.random() * 16).toString(16);\n  }\n  return out;\n}\n\n/**\n * #2100: how many entries are PENDING — a READ-ONLY count for the health line.\n *\n * \"Pending\" is what the drain would still try: an entry that is neither\n * TERMINAL (kept forever, never retried — #7708) nor FILED (the server already\n * accepted exactly this content; the entry is kept, not unlinked). Counting raw\n * meta files counts OCCUPANCY, and on a normal box every filed session stays in\n * `entries/` until the count ceiling evicts it — so an occupancy count reads\n * `DRAINING (n)` on a perfectly healthy box, makes `OK (0 queued)`\n * unreachable, and can never self-clear a stale `BLOCKED` marker.\n *\n * Deliberately NOT `listSpoolEntries`: that one is the drain's scanner, and it\n * REPAIRS as it reads (it records `corrupt_entry` discards and quarantines the\n * metas it cannot parse). A status line printed on every `session_start` must\n * not mutate the spool it is describing — a health check that deletes things is\n * its own defect — and it must not append a ledger line per session to a spool\n * it cannot read.\n * @returns the pending count, or `undefined` when the spool cannot be LISTED\n *   (any error other than ENOENT). An unreadable directory is NOT an empty one\n *   — the same rule `listSpoolEntries` follows with `DISCARD_SPOOL_UNREADABLE`,\n *   and the reason it matters here is that a transient EACCES/EMFILE read as\n *   \"nothing pending\" would both print `OK` and let the self-heal OVERWRITE the\n *   durable block marker with `ok` (found in review cycle 2).\n */\nexport function countPendingEntries(dir: string): number | undefined {\n  let names: string[];\n  try {\n    names = readdirSync(entriesDir(dir));\n  } catch (err) {\n    // ENOENT is an absent spool: nothing has been captured, which IS empty.\n    if ((err as NodeJS.ErrnoException | undefined)?.code === \"ENOENT\") return 0;\n    return undefined; // unreadable is not empty\n  }\n  let pending = 0;\n  for (const name of names) {\n    if (!name.endsWith(\".meta.json\")) continue;\n    let meta: SpoolMeta | undefined;\n    try {\n      meta = JSON.parse(readFileSync(join(entriesDir(dir), name), \"utf8\")) as SpoolMeta;\n    } catch {\n      meta = undefined;\n    }\n    // A meta we cannot read is UNKNOWABLE, not absent: count it conservatively\n    // (it may be waiting) and leave the repair to the drain's own scan.\n    if (!meta || typeof meta !== \"object\") {\n      pending += 1;\n      continue;\n    }\n    if (terminalMarker(meta) !== undefined) continue;\n    if (entryFiled(meta)) continue;\n    pending += 1;\n  }\n  return pending;\n}\n\n/** Read the recorded per-box status. Absent/corrupt reads as `undefined` (the\n *  health line then falls back to what the spool itself proves).\n *\n *  ⛔ `lstatSync` FIRST, AND ONLY A REGULAR FILE IS READ — the Python twin\n *  (`capture_spool.read_capture_status`) carries the same gate for the same\n *  reason. This read sits on the DRAIN path: `recordOutcome` calls it while the\n *  one-drainer claim is HELD, and `flushSpool` releases the claim only after\n *  the pass returns, so a FIFO (or a socket) at `status.json` used to block\n *  `open(2)` FOREVER *inside the claimed section* — the spool stayed claimed\n *  until its lease was judged stale, and `captureHealthLine` blocked on the same\n *  path, so the health line hung instead of reporting the box. It is the object\n *  class `readDrainClaim` already gates on the CLAIM file (cycle-5 P1), applied\n *  to the status file this PR is what put on the drain path (#14480 review, P1).\n *\n *  ⚠️ STATED RESIDUAL: `lstatSync` → `readFileSync` is a REPLACE WINDOW, and CERT C\n *  `FIO32` (\"Prevent Blocking on Special Files\") names it — the check and the open\n *  are two syscalls, so an object swapped for a FIFO between them still blocks. The\n *  race-free form is `open(O_RDONLY|O_NONBLOCK)` then `fstat` the FD (what `xz`'s\n *  `file_io.c` does). Not adopted HERE deliberately: `readDrainClaim` gates the CLAIM\n *  file the same way and the two legs of this feature must be one mechanism. The\n *  exposure is a local writer replacing the box's own `status.json` with a FIFO,\n *  which is already a box-takeover primitive. `fifo(7)` and CERT `FIO32` are the\n *  sources.\n */\nexport function readCaptureStatus(dir: string): CaptureStatus | undefined {\n  const path = statusPathFor(dir);\n  try {\n    if (!lstatSync(path).isFile()) return undefined;\n    const parsed = JSON.parse(readFileSync(path, \"utf8\")) as CaptureStatus;\n    return parsed && typeof parsed === \"object\" ? parsed : undefined;\n  } catch {\n    return undefined;\n  }\n}\n\n/** Record the per-box status. Best-effort: local bookkeeping must never fail a\n *  capture path (the same contract as `recordDiscard`). */\nexport function writeCaptureStatus(dir: string, status: CaptureStatus): void {\n  try {\n    mkdirSync(dir, { recursive: true, mode: 0o700 });\n    atomicWrite(statusPathFor(dir), `${JSON.stringify(status, null, 2)}\\n`);\n  } catch {\n    // a health line that cannot be persisted is not a capture failure\n  }\n}\n\n/**\n * #2100: the ONE per-box health line.\n *\n * An operator (or `pr-doctor`, or whoever reads the lane log after it produced\n * 259 B) must be able to tell a BLOCKED box from an idle one. The line is\n * printed once per `session_start` and again whenever a drain discovers a new\n * quota refusal.\n *\n * `queued` is the number of PENDING entries (see `countPendingEntries`) —\n * recomputed from the spool on every call — and the recorded marker is only\n * trusted while entries are still waiting, so a marker left behind by a quota\n * that has since lifted, or by the Python leg draining the same directory,\n * cannot keep claiming a block. Nothing pending is always `ok` (nothing is\n * blocked), and the marker is cleared when that is observed — including when\n * every remaining entry turned TERMINAL, which is a refusal with no quota\n * behind it. A spool that cannot be LISTED is `unreadable` and is never\n * reported as empty, nor healed.\n */\nexport interface CaptureHealth {\n  state: CaptureState;\n  queued: number;\n  status?: number;\n  line: string;\n}\n\n/** Rows in the store-sync backstop's dead-letter substrate. A missing file is\n *  0 (no drops), never an error: the health line must not fail because a\n *  bookkeeping file is absent. */\nexport function countStoreSyncDeadLetters(dir: string): number {\n  try {\n    const path = join(dir, \"dead-letter.jsonl\");\n    if (!existsSync(path)) return 0;\n    return readFileSync(path, \"utf8\").split(\"\\n\").filter((l) => l.trim()).length;\n  } catch {\n    return 0;\n  }\n}\n\n/**\n * The per-box capture health line.\n *\n * `storeSyncDir` names the store-sync cursor store, whose DEAD LETTERS are\n * included in the line: a permanent refusal there crosses a per-file cursor, so\n * those turns can never re-ship — and the count otherwise exists only in the\n * worker's receipt, which the extension throws away (`stdio: \"ignore\"`). A\n * count nothing reads is a silent drop; this is the one line a user sees.\n */\nexport interface SweepStatus {\n  ok: boolean;\n  reason?: string;\n  /** When the record was written (unix seconds). Consumed for PRECEDENCE: a\n   *  record at or after this sweep's spawn time is the CLI's own name for the\n   *  failure, and the extension must not replace it with its exit code. */\n  at?: number;\n}\n\n/**\n * The last sweep's outcome, as the CLI persisted it.\n *\n * The extension spawns the worker with `stdio: \"ignore\"`, so the CLI's stderr —\n * where every post-spawn failure is named (`worker_status`, `no_receipt`, a\n * non-zero exit) — is discarded. Without this the box reports `capture: OK`\n * while the crash/kill recovery is inert: a dead backstop indistinguishable\n * from a working one. `undefined` means \"no sweep has reported yet\", which is\n * NOT a failure and must never be rendered as one.\n */\nexport function readSweepStatus(dir: string): SweepStatus | undefined {\n  try {\n    const path = join(dir, \"sweep-status.json\");\n    if (!existsSync(path)) return undefined;\n    const parsed: unknown = JSON.parse(readFileSync(path, \"utf8\"));\n    if (!parsed || typeof parsed !== \"object\" || Array.isArray(parsed)) return undefined;\n    const rec = parsed as Record<string, unknown>;\n    const ok = rec.ok === true;\n    const reason = typeof rec.reason === \"string\" && rec.reason ? rec.reason : undefined;\n    const at = typeof rec.at === \"number\" && Number.isFinite(rec.at) ? rec.at : undefined;\n    return { ok, reason, at };\n  } catch {\n    return undefined;\n  }\n}\n\n/**\n * Record a sweep failure the CLI could not record itself.\n *\n * `sweep-status.json` is written by the CLI's own `main`, so a failure that\n * happens BEFORE it runs — `node` too old to parse the shipped worker, `node`\n * removed, a truncated artifact — writes NOTHING, and whatever an earlier\n * healthy sweep left stays on disk. That stale `ok: true` would render\n * `capture: OK` over a backstop that just died, which is the exact silent death\n * this seam exists to end. The extension is the only observer of the exit code,\n * so it records the failure rather than merely warning about it.\n *\n * Best-effort by contract: bookkeeping must never fail a sweep.\n */\nexport function recordSweepFailure(storeDir: string, reason: string): void {\n  try {\n    // 0o700/0o600 like every other `~/.tortoise` writer: the directory is\n    // created here on the primary path (the CLI never ran, so it does not exist\n    // yet), and a umask-derived 0755 would be the one place in the tree that is\n    // world-readable.\n    mkdirSync(storeDir, { recursive: true, mode: 0o700 });\n    // `mkdirSync`'s `mode` applies ONLY when it creates the directory. The other\n    // way this directory comes to exist is an EARLIER generation of this\n    // extension, which created it with no mode at all (0755) — so on every\n    // upgraded box the 0700 intent was silently unmet, permanently. Narrow the\n    // existing one too; best-effort, inside the same try.\n    try {\n      chmodSync(storeDir, 0o700);\n    } catch {\n      // Windows / a directory we do not own: the write below still decides.\n    }\n    const payload = { version: 1, ok: false, reason, shipped: 0, at: Date.now() / 1000 };\n    const tmp = join(storeDir, \"sweep-status.json.tmp\");\n    writeFileSync(tmp, JSON.stringify(payload), { mode: 0o600 });\n    renameSync(tmp, join(storeDir, \"sweep-status.json\"));\n  } catch {\n    // Nothing else to do: the health line simply keeps its previous reading.\n  }\n}\n\nexport function captureHealthLine(\n  dir: string,\n  opts: { apiKey?: string; storeSyncDir?: string; bounds?: SpoolBounds } = {},\n): CaptureHealth {\n  const base = spoolHealthLine(dir, opts);\n  // The store is DERIVED from the spool root (both live under `~/.tortoise/`)\n  // rather than from `homedir()`: a caller that hands in a temp spool — every\n  // test does — must not read the machine's real cursor store (#3721).\n  const storeDir = opts.storeSyncDir ?? join(dirname(dir), \"store-sync\");\n  const deadLettered = countStoreSyncDeadLetters(storeDir);\n  const sweep = readSweepStatus(storeDir);\n  const parts: string[] = [];\n  if (deadLettered > 0) parts.push(`${deadLettered} store-sync dead-lettered`);\n  // A sweep that RAN and failed is strictly worse than a dead-letter count: the\n  // backstop is inert. Absence of the file is \"not yet reported\", never a fault.\n  if (sweep && !sweep.ok) {\n    parts.push(`store-sync FAILED${sweep.reason ? ` (${sweep.reason})` : \"\"}`);\n  }\n  if (!parts.length) return base;\n  return { ...base, line: `${base.line}, ${parts.join(\", \")}` };\n}\n\n/** ONE read-only pass over `entries/`: the pending count AND the metas.\n *\n *  A health line needs two answers from the same directory — \"how many captures\n *  would a drain still try?\" (`countPendingEntries`) and \"is the spool at a\n *  ceiling with nothing evictable?\" (`spoolSaturated`) — and asking each with its\n *  own walk parsed every meta twice at the population the cap raise took\n *  1000 → 20 000. One scan, both answers. The Python leg's `_health_scan` is the\n *  twin.\n *\n *  `undefined` means the spool could not be LISTED (the same contract as\n *  `countPendingEntries`): an unreadable directory is not an empty one. A meta we\n *  cannot read still counts as PENDING (it may be waiting) and is EXCLUDED from\n *  the saturation metas — the same asymmetry the two separate walks had.\n */\nfunction healthScan(\n  dir: string,\n): {\n  pending: number;\n  metas: SpoolMeta[];\n  unreadableBytes: number;\n  unreadableCount: number;\n} | undefined {\n  const { metas, discards, unreadable } = listSpoolEntries(dir, { repair: false });\n  if (discards.some((d) => d.reason === DISCARD_SPOOL_UNREADABLE)) return undefined;\n  let onDisk = 0;\n  try {\n    onDisk = readdirSync(entriesDir(dir)).filter((name) => name.endsWith(\".meta.json\")).length;\n  } catch (err) {\n    // ENOENT is an absent spool (0 files); anything else is unreadable.\n    if ((err as NodeJS.ErrnoException | undefined)?.code !== \"ENOENT\") return undefined;\n  }\n  const pending =\n    Math.max(0, onDisk - metas.length) +\n    metas.filter((m) => terminalMarker(m) === undefined && !entryFiled(m)).length;\n  // #12483: the third element is WHY the metas/ceiling asymmetry is no longer a\n  // hole. A meta this leg cannot READ is retained and never evicted, so its\n  // BYTES still count against the byte ceiling — returned here so the health line\n  // reaches the same SATURATED verdict the write path reaches, without a second\n  // walk. A meta it can read but not USE (invalid JSON, no `session_id`) is\n  // COUNTED too (#14347 review F3): `listSpoolEntries` collects those stems\n  // BEFORE its `repair` gate, so a read-only probe still sees the class it would\n  // otherwise drop — and this scan passes `repair: false`, so it quarantines\n  // nothing; the repairing scan (the drain) is what moves such an entry.\n  // Mirrors `capture_spool._health_scan`.\n  //\n  // ⛔ THE COUNT ELEMENT IS THE OTHER HALF (#12483's \"both ceilings\"):\n  // `metas.length` cannot see either unreadable class, so a health line that\n  // counted only parsed metas described a spool of three entries as having none —\n  // and the write path, which counts them, disagreed with it about one directory.\n  return {\n    pending,\n    metas,\n    unreadableBytes: unreadableEntryBytes(dir, unreadable),\n    unreadableCount: unreadable.length,\n  };\n}\n\n/**\n * ⛔ ONLY A PASS THAT **HELD** THE CLAIM MAY **CLEAR** THE DURABLE EXCLUSION FACT —\n * every other write CARRIES IT FORWARD. One function, because the rule is one rule.\n *\n * The rule was written as \"a pass that holds the claim self-heals it\", but the code\n * cleared it on ANY `attempted > 0` write, and the pass that writes most often never\n * asks for the claim at all: a TARGETED (live) pass takes no claim by design, so it\n * reports neither `claimUnavailable` nor `claimHeld`, and its fresh `ok` record — a\n * record with no claim field — DELETED the fact. The record is the SHARED\n * `<spool>/status.json`, so a targeted pass on this leg erased the warning the Python\n * leg's reader renders, reproducing exactly the false PASS the durable field exists to\n * remove (#14480 review, F1).\n *\n * @param next      the record this pass EARNED (quota/capacity/`ok`), or null when it\n *                  earned none — an empty or backoff-only spool writes nothing.\n * @param previous  what is on disk now.\n * @param summary   the pass's own claim observations.\n * @returns the record to write, or null for \"write nothing\".\n */\nexport function applyClaimPolicy(\n  next: CaptureStatus | null,\n  previous: CaptureStatus | undefined,\n  summary: Pick<FlushSummary, \"claimUnavailable\" | \"claimUnavailableReason\" | \"claimHeld\">,\n): CaptureStatus | null {\n  const hadFact = Boolean(\n    previous?.claim_unavailable || previous?.claim_unavailable_reason);\n  if (summary.claimUnavailable) {\n    // ⛔ THE EXCLUSION BEING OFF IS A DURABLE FACT, not a console line — a pass that\n    // ran WITHOUT the one-drainer claim may have filed nothing, so every rule above\n    // can write nothing, and the reason reached only stderr, which the firing path\n    // DISCARDS (`session-start.sh`: `nohup … >/dev/null 2>&1 &`). The box then\n    // reports `capture: OK`/`DRAINING` while N drainers POST into the same ceiling\n    // (#14423 cycle-7 review, P1). Decorated rather than replacing, so a\n    // quota-blocked box with a broken claim path keeps BOTH facts.\n    return {\n      ...(next ?? previous ?? { version: 1, state: \"ok\" }),\n      claim_unavailable: true,\n      claim_unavailable_reason: (summary.claimUnavailableReason\n        || \"the spool root cannot hold a claim\").slice(0, 300),\n      updated_at: new Date().toISOString(),\n    } as CaptureStatus;\n  }\n  if (summary.claimHeld) {\n    // ⛔ A PASS THAT HELD THE CLAIM CLEARS THE FACT EVEN IF IT ATTEMPTED NOTHING.\n    // `attempted > 0` gates the `ok` record (an empty spool must not erase a recorded\n    // refusal), which left the claim fields STRANDED: a pass holding the claim over an\n    // empty/backoff-only spool wrote nothing, so the operator kept reading\n    // `NO drain exclusion (<path>)` for an obstruction already removed (#14423\n    // cycle-8 review, P2 — reproduced). One write, and only when there is something to\n    // clear; `state`/`reason`/`status` are untouched, so quota-survives-an-empty-pass\n    // still holds.\n    if (next === null && hadFact) next = { ...previous } as CaptureStatus;\n    if (hadFact && next) {\n      delete next.claim_unavailable;\n      delete next.claim_unavailable_reason;\n      next.updated_at = new Date().toISOString();\n    }\n    return next;\n  }\n  if (next && hadFact) {\n    // The pass did not ask for the claim (the targeted/live pass) and did not report\n    // the exclusion as unavailable, so it has NO standing to clear the fact: carry it\n    // onto the record it earned. `updated_at` stays this pass's, because the state\n    // half of the record IS this pass's observation.\n    next.claim_unavailable = true;\n    // ⛔ `null` IS CARRIED BY NEITHER LEG: the Python twin tests `is not None`, so a\n    // JSON `null` there is \"no reason\" — testing `!== undefined` here carried it and\n    // made the same shared record render differently on the two legs (#14480 review,\n    // P3).\n    if (previous?.claim_unavailable_reason !== undefined\n      && previous?.claim_unavailable_reason !== null) {\n      next.claim_unavailable_reason = previous.claim_unavailable_reason;\n    }\n  }\n  return next;\n}\n\n/** The operator-line term for the one claim arm that blocks PERMANENTLY — the\n *  Python twin's `_UNREADABLE_CLAIM_TEXT`, byte for byte, because the cross-leg\n *  parity test compares the FULL rendered line. */\nconst UNREADABLE_CLAIM_TEXT = \"a regular file exists but could not be read\";\n\n/** Whether a REGULAR file sits at the claim path that this process cannot READ.\n *\n *  This is the one arm that blocks the drain PERMANENTLY. A regular claim file we\n *  cannot read is HONOURED, never taken over (`acquireDrainClaim`): a transient\n *  local error and a mode-`000` file are indistinguishable, so \"unprovable reads as\n *  ALIVE\" is the fail-closed answer. The consequence is that every pass returns\n *  `heldByClaim` with NO holder identity, nothing is attempted, and the spool stops\n *  moving until a human looks — and until now nothing told the human: the line read\n *  `capture: DRAINING (n queued)`, which describes a WORKING drain (#14480 review,\n *  P2; the Python twin is `drain_claim.claim_path_unreadable`).\n *\n *  ⛔ A LIVE PROBE, NOT A DURABLE FACT. The other claim-axis fact\n *  (`claim_unavailable`) is about a PAST pass, so it has to be recorded; this one is\n *  a property of the spool root at READ time, so the health line can simply ask. A\n *  probe cannot go stale: the term disappears the moment the file is cleaned up or\n *  its mode is fixed, and a dead lock (pid recycled, lease long expired) can never\n *  keep the warning alive.\n *\n *  Only a REGULAR file is opened (`lstatSync` first — opening a FIFO or a socket is\n *  the block this module already removed from the claim read), and `ENOENT` is\n *  answered `false`: a claim released between the two syscalls is not a stall.\n *\n *  ⛔ AND THAT IS A REPLACE WINDOW, NOT AN ABSOLUTE — stated rather than implied,\n *  because the sibling status gate (`readCaptureStatus`) carries the identical\n *  `lstat` → open exposure and states it: an object swapped for a FIFO between the\n *  two syscalls IS opened and this call then blocks. CERT C `FIO32` names exactly\n *  this TOCTOU and prescribes `O_RDONLY|O_NONBLOCK` then `fstat`/`S_ISREG` on the\n *  FD; deliberately not adopted here, so this probe and the status gate stay ONE\n *  mechanism with one stated residual, and because the box owner is by definition\n *  the only writer that could perform the swap (the confirmation review AT `bcb52e1d` —\n *  dated rather than round-cited, because the over-claiming sentence did not exist at any\n *  head cycle 19 reviewed; the earlier wording promised more than two syscalls can).\n */\nexport function claimPathUnreadable(dir: string): boolean {\n  const claimPath = drainClaimPathFor(dir);\n  try {\n    if (!lstatSync(claimPath).isFile()) return false;\n  } catch {\n    return false;\n  }\n  let fd: number;\n  try {\n    fd = openSync(claimPath, \"r\");\n  } catch (err) {\n    return (err as NodeJS.ErrnoException | undefined)?.code !== \"ENOENT\";\n  }\n  try {\n    closeSync(fd);\n  } catch {\n    /* the answer is already known */\n  }\n  return false;\n}\n\n/**\n * Append the claim-axis facts to WHICHEVER verdict was chosen.\n *\n * ⛔ A TERM ON EVERY LINE, NOT A SIXTH PRECEDENCE STATE (#14480 review, F1). The\n * claim axis is a fact about the SPOOL ROOT — true whatever the queue is doing — so\n * a `SATURATED` box whose claim path is broken must read BOTH, exactly as a\n * quota-blocked one must. Applying it only to the final `DRAINING`/`OK` verdict\n * dropped it on the four early returns, and the case the durable fact exists for (a\n * capacity 429 with a backlog: `state: blocked` AND a broken claim path) is one of\n * those early returns. Mirrors `capture_spool._with_claim_term` byte for byte — the\n * cross-leg parity test compares the FULL rendered line.\n *\n * ⛔ TWO TERMS, TWO DIFFERENT KINDS OF FACT, and they must not be merged:\n *\n *  * `NO drain exclusion` — DURABLE and about a PAST pass: a pass ran without the\n *    one-drainer claim, and the reason reaches no one unless it is recorded (the\n *    firing hook discards stderr).\n *  * `drain claim UNREADABLE` — LIVE and about the PRESENT state: every pass honours\n *    a holder it cannot name and attempts nothing, so the spool stops moving until a\n *    human looks. That residual had no surface at all (#14480 review, P2), and it is\n *    probed rather than recorded because a recorded copy could outlive the\n *    condition.\n *\n * Order is fixed so the rendered line is byte-identical on both legs.\n */\nfunction withClaimTerm(\n  health: CaptureHealth,\n  recorded: CaptureStatus | undefined,\n  dir: string,\n): CaptureHealth {\n  const terms: string[] = [];\n  if (recorded?.claim_unavailable) {\n    const reason = recorded.claim_unavailable_reason;\n    // ⛔ BYTE-IDENTICAL TO THE PYTHON LEG'S TERM, for EVERY value the record can\n    // hold — not only for the shapes this leg happens to write. The Python twin\n    // gates on `isinstance(reason, str) and reason`, so a non-string reason (a\n    // hand-edited or foreign `status.json` — the two legs share this file) renders\n    // `…, NO drain exclusion` there and used to render `…, NO drain exclusion (5)` /\n    // `([object Object])` here. This PR's own claim is byte-identical words on both\n    // legs for every verdict (#14480 review, P3).\n    const suffix = typeof reason === \"string\" && reason ? ` (${reason})` : \"\";\n    terms.push(`NO drain exclusion${suffix}`);\n  }\n  if (claimPathUnreadable(dir)) {\n    terms.push(`drain claim UNREADABLE (${UNREADABLE_CLAIM_TEXT})`);\n  }\n  if (!terms.length) return health;\n  return { ...health, line: `${health.line}, ${terms.join(\", \")}` };\n}\n\nfunction spoolHealthLine(\n  dir: string,\n  opts: { apiKey?: string; bounds?: SpoolBounds } = {},\n): CaptureHealth {\n  // ⛔ THE RECORD IS READ BEFORE THE SCAN, so the durable claim fact reaches the\n  // `UNREADABLE` return too: `status.json` sits in the spool ROOT, not in\n  // `entries/`, so a spool whose entries cannot be listed still has a readable\n  // record — and dropping the fact on the one verdict that says \"I cannot even\n  // look\" is the wrong way round (#14480 review, F1).\n  let recorded = readCaptureStatus(dir);\n  const previous = recorded;\n  const scan = healthScan(dir);\n  if (scan === undefined) {\n    // A spool we cannot list is UNKNOWN, not empty. Reporting `OK` here would be\n    // a false pass on the acceptance's own surface, and it would also let the\n    // self-heal below destroy a durable block marker that a later, readable\n    // process still needs.\n    return withClaimTerm({\n      state: \"unreadable\",\n      queued: 0,\n      line: `capture: UNREADABLE (cannot list ${entriesDir(dir)})`,\n    }, recorded, dir);\n  }\n  const queued = scan.pending;\n  if (queued === 0 && recorded && recorded.state !== \"ok\") {\n    // Self-healing: the block is over (or another leg filed everything). Never\n    // keep a stale verdict on disk that no evidence supports.\n    // ⛔ EXCEPT the claim axis: it is a fact about the SPOOL ROOT, not about the\n    // queue, so an empty spool does not make it untrue — erasing it here would make\n    // the next capture on a broken box report a healthy drain.\n    // ⛔ KEY-EXISTENCE, NOT TRUTHINESS — the Python twin's self-heal keeps every\n    // claim-axis key the record CARRIES (`{k: v for k, v in previous.items() if k in\n    // (…)`), whatever the value. Copying only the TRUTHY ones made this leg drop a\n    // `claim_unavailable: false` and a JSON `null` reason that Python keeps, so the\n    // ONE shared `status.json` came out different depending on which leg last ran a\n    // health line (#14480 review, P3 — same class as `withClaimTerm`'s suffix).\n    const keep: Partial<CaptureStatus> = {};\n    if (previous && \"claim_unavailable\" in previous) {\n      keep.claim_unavailable = previous.claim_unavailable;\n    }\n    if (previous && \"claim_unavailable_reason\" in previous) {\n      keep.claim_unavailable_reason = previous.claim_unavailable_reason;\n    }\n    recorded = { version: 1, state: \"ok\", queued: 0, updated_at: new Date().toISOString(), ...keep };\n    writeCaptureStatus(dir, recorded);\n  }\n  // A READ-ONLY question (`repair: false`): a health line must not quarantine,\n  // record or unlink the spool it is describing.\n  // The verdict over the metas this call ALREADY read — no second scan, and the\n  // same arithmetic (`saturatedForMetas`) the write path runs. READ-ONLY by\n  // construction: a health line must not quarantine, record or unlink the spool\n  // it is describing. `bounds` are the ceilings the box actually runs with:\n  // SATURATED is a statement ABOUT them, so a caller (a test, a fleet surface)\n  // that knows the real pair passes it rather than inheriting the module\n  // default. Mirrors the Python leg's `capture_health_line(..., bounds=...)`.\n  const saturated = saturatedForMetas(\n    dir,\n    scan.metas,\n    opts.bounds ?? DEFAULT_BOUNDS,\n    {},\n    scan.unreadableBytes,\n    scan.unreadableCount,\n  );\n  // A marker we cannot UNDERSTAND is not a marker — the same rule this file\n  // applies to `terminal_failure` and to a corrupt backoff window. A hand-edited\n  // or foreign `status.json` carrying `{\"state\": \"blocked\"}` (or a status that\n  // is a JSON string) must not be able to report a block that nothing observed:\n  // the safe reading is \"no recorded block\", which the spool count still\n  // governs. `recordOutcome` always writes a NUMBER, so nothing is lost.\n  const blockedStatus =\n    recorded !== undefined &&\n    recorded.state === \"blocked\" &&\n    typeof recorded.status === \"number\" &&\n    Number.isFinite(recorded.status) &&\n    recorded.status > 0\n      ? recorded.status\n      : undefined;\n  // ⛔ PRECEDENCE — `UNREADABLE` > `BLOCKED` > `SATURATED` > `INACTIVE` >\n  // `DRAINING` > `OK`, and the order of these branches IS the precedence. A\n  // recorded refusal outranks INACTIVE because it names a CAUSE the operator can\n  // act on; SATURATED outranks INACTIVE deliberately, so a keyless box —\n  // precisely the one that saturates — keeps the keyless fact in the SATURATED\n  // line instead of replacing it. Before this branch existed the five states\n  // could not say \"refusing every new capture\": a working backlog read DRAINING,\n  // and a ceiling filled by TERMINAL entries (never retried, never counted) read\n  // `OK (0 queued)` — byte-identical to a healthy box.\n  if (blockedStatus !== undefined && queued > 0) {\n    return withClaimTerm({\n      state: \"blocked\",\n      queued,\n      status: blockedStatus,\n      // #2100: 402 has TWO categories on `/v1/sessions`, and the server says a\n      // caller must not read the spend cap as \"out of plan allowance\"\n      // (`tortoise/cohort_cost.py` — buying a bigger plan would not lift it).\n      // `blocked` alone would name the status and lose the cause, so the\n      // marker's own recorded category is reported when it has one.\n      line: `capture: BLOCKED (${queued} queued, ${blockedStatus} ${refusalLabel(recorded.reason)})`,\n    }, recorded, dir);\n  }\n  if (saturated) {\n    // `queued` is the PENDING count, so a ceiling filled by terminal entries\n    // reads `SATURATED (0 queued, …)` — true on both counts: nothing will be\n    // retried, and nothing new will be admitted. `session drain` names the\n    // terminal count and `--retry-terminal` re-arms them.\n    return withClaimTerm(opts.apiKey === \"\"\n      ? {\n          state: \"saturated\",\n          queued,\n          line: `capture: SATURATED (no TORTOISE_API_KEY, ${queued} queued, refusing new captures)`,\n        }\n      : {\n          state: \"saturated\",\n          queued,\n          line: `capture: SATURATED (${queued} queued, refusing new captures)`,\n        }, recorded, dir);\n  }\n  if (opts.apiKey === \"\") {\n    // The count is NOT dropped here: a keyless box is exactly the box whose\n    // spool grows forever (nothing can file it), so the backlog must stay\n    // visible on the line that explains why.\n    return withClaimTerm({\n      state: \"inactive\",\n      queued,\n      line: `capture: INACTIVE (no TORTOISE_API_KEY, ${queued} queued)`,\n    }, recorded, dir);\n  }\n  const verdict = queued > 0\n    ? { state: \"draining\" as const, queued, line: `capture: DRAINING (${queued} queued)` }\n    : { state: \"ok\" as const, queued, line: \"capture: OK (0 queued)\" };\n  // ⛔ AND THE LINE CARRIES IT, byte-identical to the Python leg's\n  // (`_spool_health_line`): the record is the only place a pass that filed nothing\n  // can be heard, so the one line every operator reads is where it must land. A\n  // divergence here is invisible to everyone but a human who ran the other leg.\n  // It goes through `withClaimTerm` like every earlier verdict: the term is an\n  // ADDED FACT, not a precedence state.\n  return withClaimTerm(verdict, recorded, dir);\n}\n\n/**\n * #2100: the cause word in the BLOCKED line.\n *\n * `quota` is the plain-plan-allowance reading and the string operator docs and\n * this issue's acceptance name, so an unlabelled 402 (or the org's points\n * allowance) stays exactly that. A DIFFERENT recorded category is named as\n * itself — a spend cap reported as \"quota\" sends the owner to buy a plan that\n * cannot lift it.\n *\n * ⛔ THE CAPACITY ARM IS THE PYTHON TWIN'S (`capture_spool._refusal_label`),\n * and its absence here was an R6 divergence over a file both legs write: both\n * legs persist `reason: \"capture_capacity_saturated\"` into the same\n * `<spool>/status.json`, so the health line read\n * `429 capture capacity` on the Python leg and `429 capture_capacity_saturated`\n * on this one — and the PR body's \"Named, durably\" row states the first as the\n * contract (review finding).\n */\nfunction refusalLabel(reason: string | undefined): string {\n  if (!reason || reason === QUOTA_EXCEEDED_CODE || reason === \"402\") return \"quota\";\n  if (reason === CAPTURE_CAPACITY_CODE) return \"capture capacity\";\n  return reason;\n}\n\n/** Read the discard ledger (observable, append-only). */\nexport function readDiscards(dir: string): DiscardRecord[] {\n  const path = discardPath(dir);\n  if (!existsSync(path)) return [];\n  return readFileSync(path, \"utf8\")\n    .split(\"\\n\")\n    .filter((l) => l.trim())\n    .flatMap((l) => {\n      try {\n        return [JSON.parse(l) as DiscardRecord];\n      } catch {\n        // a torn/partial ledger line must not take down the reader\n        return [];\n      }\n    });\n}\n\n// ── Extension wiring ──────────────────────────────────────────────────────\n\nexport interface CaptureDeps {\n  fetchImpl?: FetchLike;\n  /**\n   * Test seam for `resolveConfig`, mirroring `fetchImpl`: the environment and\n   * the config path the resolver reads. Omitted in production (the installer\n   * passes no deps), where `undefined` triggers `resolveConfig`'s own\n   * defaults — `process.env` and `CONFIG_PATH`.\n   *\n   * The behavioral suite MUST inject both (#3721): the extension resolves its\n   * credential from the ambient env / `~/.pi/agent/tortoise-config.json`, so\n   * a developer machine that has either made the suite pass while asserting\n   * the MACHINE, not the extension — and fail on a clean CI runner, where the\n   * empty key short-circuits `post()` before the injected fetch is ever\n   * called. Injecting the resolver's two INPUTS (never a stubbed config) keeps\n   * the real co-source chain in the tested path.\n   */\n  env?: Env;\n  configPath?: string;\n  /**\n   * Spool directory + ceilings. Injected by the behavioral suite so a test can\n   * never touch (or file) the developer machine's real\n   * `~/.tortoise/capture-spool` — the same ambient-state trap as #3721.\n   */\n  spoolDir?: string;\n  bounds?: SpoolBounds;\n  /** Clock seam for backoff-window tests. */\n  now?: () => number;\n  /**\n   * #3515 piece 5: the recovery SWEEP seam. On `session_start` the extension\n   * asks the store-sync backstop to drain Pi's own `.jsonl` files (the death\n   * modes the in-process hook cannot see: SIGKILL, crash, closed terminal).\n   *\n   * Injected so the behavioral suite never spawns a real `tortoise` process,\n   * and so a machine with no Python install reports the skip instead of\n   * pretending the sweep ran. `undefined` in production means the real\n   * detached spawn.\n   */\n  sweepImpl?: (excludeSessionId?: string) => void;\n}\n\nfunction log(message: string): void {\n  // Pi surfaces extension stdout in its session log.\n  console.log(`[tortoise-capture] ${message}`);\n}\n\nfunction warn(message: string): void {\n  console.warn(`[tortoise-capture] ${message}`);\n}\n\n/**\n * Report a flush outcome — success lines on 2xx, every discard named.\n *\n * `continuing` says whether a follow-up pass is actually scheduled. It is a\n * PARAMETER, not a guess: the line is the operator's only account of what the\n * drain will do next, and both `session_shutdown` (the process is exiting) and\n * the last pass of a spent chain schedule nothing — a claim that the drain\n * \"continues in the background\" there is a false statement on exactly the\n * surface #2100 is about.\n */\nfunction reportFlush(\n  summary: FlushSummary,\n  where: string,\n  opts: { continuing?: boolean } = {},\n): void {\n  // Deferrals are reported too: a quota-blocked spool is otherwise a steady\n  // state that logs NOTHING while captures sit unfiled (#4714 review). A\n  // terminal-only spool is the same shape (#7708).\n  if (summary.filed > 0 || summary.deferred > 0 || summary.heldByBackoff > 0 ||\n      summary.terminal > 0 || summary.remaining > 0) {\n    log(\n      `spool flush (${where}): filed ${summary.filed}, deferred ${summary.deferred}, ` +\n        `skipped ${summary.skipped} (${summary.heldByBackoff} waiting on backoff), ` +\n        `held back ${summary.heldBack}, ` +\n        `terminal ${summary.terminal} (kept, not retried; re-file with ` +\n        `'tortoise session drain --retry-terminal')` +\n        // #2100: a bounded pass that left work queued says so, and names why.\n        // A quota stop does NOT continue in the background (there is nothing to\n        // gain from a second refusal), so the line must not claim it does — a\n        // diagnostic that states the wrong next step is worse than a terse one.\n        (summary.remaining > 0\n          ? summary.stopped === \"quota\"\n            ? `, paused ${summary.remaining} (quota refused; not retried in this pass)`\n            // #14350: a CAPACITY stop is the box's, so a follow-up pass would\n            // meet the same ceiling. Named as its own state — and never\n            // described as \"continues in the background\" — for the same reason\n            // as the quota arm.\n            : summary.stopped === \"capacity\"\n              ? `, paused ${summary.remaining} (server at capture capacity; nothing charged to any entry)`\n              : opts.continuing\n                ? `, paused ${summary.remaining} (${summary.stopped ?? \"budget\"}; continues in the background)`\n                : `, paused ${summary.remaining} (${summary.stopped ?? \"budget\"}; left for the next opportunity)`\n          : \"\"),\n    );\n  }\n  // #14350: the two states that are NOT a failure of any entry, reported even\n  // when nothing else happened — a pass that refused to run, and a pass that\n  // could not take the exclusion, are exactly the cases where a silent drain\n  // reads as \"nothing to do\".\n  if (summary.heldByClaim) {\n    log(\n      `${summary.claimHolder ?? \"another drainer holds this spool\"} ` +\n        `— serialized drain: one drainer per box (#14350)`,\n    );\n  }\n  if (summary.claimUnavailable) {\n    warn(\n      summary.claimUnavailableReason\n        ? `spool flush: ${summary.claimUnavailableReason}`\n        : \"spool flush: the drain claim is unavailable (the spool root is not writable) \" +\n          \"— this pass ran WITHOUT the one-drainer exclusion\",\n    );\n  }\n  if (summary.lostClaim) {\n    warn(\n      \"spool flush: this pass no longer held the drain claim (a peer took it over) \" +\n        \"— stopped rather than drain twice\",\n    );\n  }\n  for (const d of summary.discarded) {\n    warn(`spool DISCARD ${d.session_id} — ${d.reason}${d.detail ? ` (${d.detail})` : \"\"}`);\n  }\n}\n\nexport default function tortoiseCapture(pi: ExtensionAPI, deps: CaptureDeps = {}): void {\n  const cfg = resolveConfig(deps.env, deps.configPath ?? CONFIG_PATH);\n  const doFetch: FetchLike = deps.fetchImpl ?? (fetch as unknown as FetchLike);\n  const spoolDir =\n    deps.spoolDir ?? process.env.TORTOISE_CAPTURE_SPOOL_DIR ?? SPOOL_DIR;\n  // Fail-closed isolation guard (#3721 trap, one layer deeper): an extension\n  // under `node --test` that reaches the DEFAULT spool would write — and FILE —\n  // the developer machine's real captures. Tests must inject `spoolDir`.\n  if (\n    !deps.spoolDir &&\n    !process.env.TORTOISE_CAPTURE_SPOOL_DIR &&\n    process.env.NODE_TEST_CONTEXT\n  ) {\n    throw new Error(\n      \"tortoise-capture: tests must inject `spoolDir` (or set \" +\n        \"TORTOISE_CAPTURE_SPOOL_DIR) — refusing to touch the real capture spool\",\n    );\n  }\n  const bounds = deps.bounds ?? DEFAULT_BOUNDS;\n  const clock = (): number => (deps.now ? deps.now() : Date.now());\n  const inFlight = new Set<string>();\n\n  if (!cfg.apiKey) {\n    warn(\n      \"no TORTOISE_API_KEY — capture is INACTIVE. Add it to your shell profile \" +\n        \"and restart Pi from a new terminal (a /reload keeps the old environment).\",\n    );\n  }\n\n  /**\n   * The cheap, frequent half of the cadence (#3963): snapshot the session into\n   * the durable spool. Synchronous by design — a `turn_end` handler that\n   * returned before the write landed would lose the very turn it captured when\n   * the process is killed next. Never touches the network.\n   */\n  const spoolSnapshot = (ctx: {\n    sessionManager?: {\n      getEntries?: () => Array<Record<string, unknown>>;\n      getSessionId?: () => string;\n      getSessionFile?: () => string | undefined;\n    };\n    model?: unknown;\n  }): void => {\n    try {\n      const manager = ctx?.sessionManager;\n      const entries = (manager?.getEntries?.() ?? []) as Array<Record<string, unknown>>;\n      const turns = extractTurns(entries);\n      if (turns.length === 0) return;\n      // #9599: the LOCAL spool key is an identity too. `getSessionId()` handing\n      // back a whitespace-only id is truthy, so two different blank-id sessions\n      // landed in ONE entry (keyed `sha256(\"   \")[:32]`) and the second REPLACED\n      // the first's turns — measured, not theoretical. A blank therefore falls\n      // through to the path-anchored id, exactly as an absent one does on the\n      // Python leg. (The WIRE is normalised separately by `buildCapturePayload`:\n      // it must name no session so the server mints one.)\n      const sessionFile = manager?.getSessionFile?.();\n      const sessionId = normaliseSessionId(manager?.getSessionId?.())\n        ?? localSessionId(sessionFile);\n      if (!sessionId) return;\n      const { discards } = writeSpoolEntry(\n        spoolDir,\n        {\n          sessionId,\n          turns,\n          source: sourceName(sessionFile),\n          machineId: deriveMachineId(),\n          model: modelLabel(ctx?.model),\n          // #3516 §B: this IS the in-process hook, so the entry it spools\n          // claims 'hook' — the drain later forwards it verbatim.\n          captureLane: \"hook\",\n          // #3516 §B / piece 12 row 1: the in-process recorder stamps its OWN\n          // clock at turn observation, and carries NO source — piece 12's row\n          // reads \"none — the recorder always has a clock\". Unix SECONDS, the\n          // unit the floor compares in (`Date.now()` is ms; do not pass it raw).\n          clientCapturedAt: Date.now() / 1000,\n        },\n        bounds,\n      );\n      for (const d of discards) {\n        warn(`spool DISCARD ${d.session_id} — ${d.reason}${d.detail ? ` (${d.detail})` : \"\"}`);\n      }\n    } catch (err) {\n      warn(`spool error: ${err instanceof Error ? err.message : String(err)}`);\n    }\n  };\n\n  // ── #2100: the bounded drain + the per-box health line ────────────────\n\n  /**\n   * Record what a pass observed, and say it out loud when it learned something\n   * the operator needs: a quota refusal turns the box `BLOCKED` (durable, so the\n   * NEXT process — every lane is one — does not have to re-POST to find out),\n   * and any 2xx proves the quota is not refusing, so it clears the marker.\n   *\n   * A marker is only ever `blocked` or `ok`; `draining`/`inactive` are derived\n   * from the spool and the credential on each health line, never stored.\n   */\n  const recordOutcome = (summary: FlushSummary): void => {\n    try {\n      const previous = readCaptureStatus(spoolDir);\n      // ⛔ BUILT, THEN WRITTEN ONCE AT THE TAIL — the Python twin's shape, for the\n      // Python twin's reason (#14480 review, F1). Every arm below used to write the\n      // file immediately, so whether the durable claim fact survived depended on\n      // which arm had run; one of them wrote a record with no claim field at all and\n      // therefore deleted the fact. A single write point is what makes the claim\n      // policy ONE rule instead of a property of four call sites.\n      let next: CaptureStatus | null = null;\n      if (summary.quota) {\n        next = {\n          version: 1,\n          state: \"blocked\",\n          reason: summary.quota.code ?? `${summary.quota.status}`,\n          status: summary.quota.status,\n          ...(summary.quota.detail ? { detail: summary.quota.detail.slice(0, 500) } : {}),\n          updated_at: new Date().toISOString(),\n        };\n      } else if (summary.attempted > 0 && !summary.capacity) {\n        // Some POST was ATTEMPTED and none of them was refused for quota, so the\n        // recorded cause is superseded: the marker is the LAST OBSERVED\n        // 402, not a permanent verdict. Without this, a box that was\n        // quota-blocked yesterday and is now `ECONNREFUSED`/500ing keeps\n        // telling its operator to buy points — the same misdiagnosis as #2100\n        // in mirror image (found in review cycle 2; `updated_at` was written\n        // and never read).\n        //\n        // Note what this does NOT claim: a REPLAY 2xx is accepted without the\n        // points gate (`hosted_api`: `if (not session_existed or\n        // retry_failed_capture) and not store_only`), so a 2xx is evidence the\n        // server accepted a capture, not proof the allowance lifted. The window\n        // is one pass wide: a still-exhausted quota refuses the NEXT attempt\n        // and re-marks it in the same pass that attempted it.\n        next = {\n          version: 1,\n          state: \"ok\",\n          updated_at: new Date().toISOString(),\n        };\n      }\n      if (summary.capacity) {\n        // #14350: the box is at its capture ceiling. Recorded as BLOCKED with the\n        // server's own 429 so `capture: BLOCKED (n queued, 429 capture capacity)`\n        // names the cause — the same durable half the quota arm gets, for the same\n        // reason: the hook that fired this drain threw its stderr away, so a\n        // console line alone leaves the next process to re-POST to find out why\n        // nothing moved. Self-healing: a later pass with a free slot writes `ok`,\n        // and the health line clears it when the queue empties.\n        next = {\n          version: 1,\n          state: \"blocked\",\n          reason: summary.capacity.code ?? `${summary.capacity.status}`,\n          status: summary.capacity.status,\n          ...(summary.capacity.detail\n            ? { detail: summary.capacity.detail.slice(0, 500) }\n            : {}),\n          updated_at: new Date().toISOString(),\n        };\n      }\n      // ⛔ THE CLAIM POLICY IS ONE EXPORTED FUNCTION, not four call sites: see\n      // `applyClaimPolicy` for the rule and for the review finding (F1) that made it\n      // a rule. The build above only decides which STATE the pass earned.\n      next = applyClaimPolicy(next, previous, summary);\n      if (next) writeCaptureStatus(spoolDir, next);\n      // Say the state out loud whenever it MOVED: the start-of-session line was\n      // printed from the marker this pass has just superseded, and leaving that\n      // as the last thing the lane logged is the misdiagnosis the supersede\n      // exists to prevent.\n      if (\n        summary.quota || summary.capacity ||\n        (previous?.state === \"blocked\" && summary.attempted > 0)\n      ) {\n        log(captureHealthLine(spoolDir, { apiKey: cfg.apiKey }).line);\n      }\n    } catch (err) {\n      warn(`spool status error: ${err instanceof Error ? err.message : String(err)}`);\n    }\n  };\n\n  /**\n   * #2100: dispatch ONE bounded drain pass and return immediately.\n   *\n   * NOT awaited by any handler that gates a turn. The pass itself is bounded\n   * (`FLUSH_MAX_ATTEMPTS`, `FLUSH_BUDGET_MS`); what it could not reach stays in\n   * the spool and is continued in the BACKGROUND, on an `unref()`d timer so a\n   * pending continuation can never keep a finished Pi process alive (the\n   * mirror image of the same bug: a capture that pins the event loop open).\n   */\n  const drain = (\n    where: string,\n    filter: { excludeSessionId?: string } = {},\n    chain = 0,\n  ): void => {\n    void flushSpool(cfg, {\n      dir: spoolDir,\n      fetchImpl: doFetch,\n      now: clock(),\n      bounds,\n      inFlight,\n      ...filter,\n    })\n      .then((summary) => {\n        // The report is told whether a continuation is ACTUALLY scheduled — it\n        // runs before the decision, so asking it to guess produced \"continues in\n        // the background\" on the last pass of a spent chain (#2100 review 2).\n        // #14350: a CAPACITY stop is the box's, like a quota stop — chaining\n        // would spend the following passes meeting the same ceiling, so neither\n        // continues in the background.\n        const willChain =\n          summary.remaining > 0 && !summary.quota && !summary.capacity &&\n          chain + 1 < FLUSH_MAX_CHAIN;\n        reportFlush(summary, where, { continuing: willChain });\n        recordOutcome(summary);\n        if (willChain) {\n          const timer = setTimeout(\n            () => drain(where, filter, chain + 1),\n            FLUSH_FOLLOW_UP_DELAY_MS,\n          );\n          timer.unref?.();\n        }\n      })\n      .catch((err) => warn(`spool flush error: ${err instanceof Error ? err.message : String(err)}`));\n  };\n\n  /**\n   * #3515 piece 5 — invoke the store-sync backstop, DETACHED.\n   *\n   * Why a spawn and not an implementation here: the backstop already exists as\n   * `tortoise/pi-hooks/store-sync.ts` (per-file cursor, branch window,\n   * advance-on-2xx) and re-implementing it inside the extension would be the\n   * second capture path this architecture exists to forbid. Why detached and\n   * unref'd: `session_start` is AWAITED by Pi, so the sweep must not be on the\n   * startup path — a network drain there is the #2100 failure (a lane that\n   * looked dead while it drained).\n   *\n   * A machine with no `tortoise` CLI has nothing to sweep with, and says so\n   * ONCE — never silently. (Pi itself always has `node`; a Python CLI is only\n   * present on a machine that installed the package.)\n   */\n  const sweepStoreSync = (excludeSessionId?: string): void => {\n    if (deps.sweepImpl) {\n      try {\n        deps.sweepImpl(excludeSessionId);\n      } catch (err) {\n        warn(`store-sync sweep (injected) failed: ${err instanceof Error ? err.message : String(err)}`);\n      }\n      return;\n    }\n    const storeDir = join(dirname(spoolDir), \"store-sync\");\n    // ONE failure record per sweep, carrying the FIRST reason. A PATH-missing CLI\n    // reports BOTH `error` (ENOENT) and `close` (code -2) and NO `exit` event at\n    // all, so a recorder wired to `exit` alone never fires on the likeliest way\n    // this backstop stops working. Record first, warn second: the warn is\n    // deduplicated per process, the record must not be.\n    const sweepStartedAt = Date.now() / 1000;\n    // ONE tolerance for comparing a persisted `at` (whatever resolution its\n    // writer had) with our millisecond spawn stamp, used by BOTH arms below.\n    // `time.time()` is a float here, but Python documents one-second resolution\n    // on some platforms, and a backwards clock step is possible — so an\n    // exact-to-the-millisecond comparison can read a record THIS sweep wrote as\n    // older. Deriving it once is the point: the two arms drifted apart once\n    // already, and the arm that was left exact reintroduced the gen-11 defect it\n    // was written to prevent.\n    const CLOCK_SLACK_S = 1;\n    let failureRecorded = false;\n    const noteFailure = (reason: string): void => {\n      if (failureRecorded) return;\n      failureRecorded = true;\n      // SUBORDINATE to the CLI's own diagnosis. The CLI writes its\n      // `{ok: false, reason: \"worker_missing\"}` BEFORE it exits non-zero, and\n      // `close` fires after that — so writing unconditionally replaced the one\n      // thing this seam exists to name with an opaque `exit_1` on every GRACEFUL\n      // failure. A record stamped at or after this spawn is this sweep's, and it\n      // wins.\n      const existing = readSweepStatus(storeDir);\n      if (existing && !existing.ok && (existing.at ?? 0) >= sweepStartedAt - CLOCK_SLACK_S) return;\n      recordSweepFailure(storeDir, reason);\n    };\n    try {\n      // `--cursor-dir` is EXPLICIT on purpose: the CLI otherwise defaults to\n      // `$HOME/.tortoise/store-sync` while both legs of the line read\n      // `<spool-parent>/store-sync`, so under the documented\n      // `TORTOISE_CAPTURE_SPOOL_DIR` override the writer and the readers\n      // silently disagreed (the dead-letter count read 0, the failure degraded\n      // to `exit_N`). Naming it makes them agree by construction — and it is a\n      // no-op under the default, where the two paths are the same.\n      const args = [\"store-sync\", \"--no-spool\", \"--cursor-dir\", storeDir];\n      if (excludeSessionId) args.push(\"--exclude-session-id\", excludeSessionId);\n      const child = spawn(CANDIDATE_CLIS[0], args, { detached: true, stdio: \"ignore\" });\n      child.on(\"error\", () => {\n        noteFailure(\"cli_missing\");\n        if (_SWEEP_UNAVAILABLE_WARNED) return;\n        _SWEEP_UNAVAILABLE_WARNED = true;\n        warn(\"store-sync sweep: no `tortoise` CLI on PATH — killed/crashed sessions \"\n          + \"are only caught when it is installed (`tortoise store-sync`)\");\n      });\n      // `close` (not `exit`) is the listener that covers EVERY end: it fires for\n      // a child that ran and failed (`node` too old for the shipped `.ts` worker,\n      // missing artifact, no receipt) AND for one that never started. `signal` is\n      // the only diagnosis for a swept that was KILLED (OOM, shutdown): `code` is\n      // null there, and `exit_null` would throw the reason away exactly where it\n      // matters.\n      child.on(\"close\", (code, signal) => {\n        if (code === 0) {\n          // EXIT 0 IS NOT PROOF THE SWEEP RAN. This seam's whole premise is that\n          // the status file is the truth, and the CLI's own bookkeeping write is\n          // best-effort (`except OSError: pass`) — so a healthy-looking exit can\n          // leave NO record, and the line then renders the PREVIOUS verdict over\n          // a backstop that never swept. A `tortoise` on PATH that is not the\n          // shipped CLI does the same. Corroborate with data already in hand.\n          const after = readSweepStatus(storeDir);\n          // A coarse-but-FRESH record must not read as older, or this branch\n          // OVERWRITES a healthy status and reports `exit_0_without_status` on a\n          // box whose backstop works, every sweep. A record from the previous\n          // sweep is far older than `CLOCK_SLACK_S`, so the tolerance cannot\n          // mask a genuinely stale verdict.\n          if (!after || (after.at ?? 0) < sweepStartedAt - CLOCK_SLACK_S) {\n            noteFailure(\"exit_0_without_status\");\n            if (_SWEEP_UNAVAILABLE_WARNED) return;\n            _SWEEP_UNAVAILABLE_WARNED = true;\n            warn(\"store-sync sweep exited 0 but wrote no fresh status — killed/crashed \"\n              + \"sessions may not be recovered; run `tortoise store-sync --json`\");\n          }\n          return;\n        }\n        const why = code === null ? `signal_${String(signal)}` : `exit_${String(code)}`;\n        noteFailure(why);\n        if (_SWEEP_UNAVAILABLE_WARNED) return;\n        _SWEEP_UNAVAILABLE_WARNED = true;\n        warn(\"store-sync sweep FAILED (\" + why.replace(\"_\", \" \") + \") — killed/crashed \"\n          + \"sessions are not being recovered; run `tortoise store-sync --json`\");\n      });\n      child.unref();\n    } catch {\n      noteFailure(\"spawn_failed\");\n      if (_SWEEP_UNAVAILABLE_WARNED) return;\n      _SWEEP_UNAVAILABLE_WARNED = true;\n      warn(\"store-sync sweep could not be started\");\n    }\n  };\n\n  /** The one health line. Cheap enough to print per session start (a spool scan,\n   *  no network), and the only surface that distinguishes a BLOCKED box from an\n   *  idle one in a lane log that otherwise produced 259 B. */\n  const logHealth = (): void => {\n    try {\n      log(captureHealthLine(spoolDir, { apiKey: cfg.apiKey }).line);\n    } catch (err) {\n      warn(`spool health error: ${err instanceof Error ? err.message : String(err)}`);\n    }\n  };\n\n  // #1727 T2-P1: the SERVER-VISIBLE install signal — the extension-on-load\n  // probe the server's install-probe route documents. Fired per session start\n  // (startup/reload/new/resume/fork), matching Claude's SessionStart hook.\n  //\n  // #3963: `session_start` is also the REPLAY OPPORTUNITY. A prior session that\n  // was interrupted (SIGINT, laptop closed, a cancelled shutdown hook) left its\n  // turns in the spool; they are filed here — cleanly, before this session has\n  // produced a turn of its own.\n  //\n  // FIRE-AND-FORGET: Pi AWAITS this handler (AgentSession.bindExtensions →\n  // `await emit(\"session_start\")`), so awaiting the network would stall startup\n  // on a blackholed endpoint. Both the probe and the replay are dispatched with\n  // bounded budgets and report when they land.\n  //\n  // #2100: and the REPLAY ITSELF MOVES OFF THIS TICK. An `async` function runs\n  // its body synchronously up to its first `await`, and `flushSpool` scans the\n  // spool and reads turn logs before that point — so `void flush(...)` was still\n  // charging a 320-entry spool to the handler Pi awaits. `setImmediate` is what\n  // makes \"never blocks turn start\" true for the SYNC half too, not just for\n  // the network half.\n  pi.on(\"session_start\", (_event, ctx) => {\n    void postInstallProbe(cfg, doFetch)\n      .then((res) => {\n        if (res.ok) {\n          log(`install probe recorded (harness=${HARNESS})`);\n        } else if (res.detail === \"no TORTOISE_API_KEY configured\") {\n          // Already warned at load; the probe is best-effort install telemetry.\n        } else {\n          warn(`install probe failed (${res.detail ?? res.status}) — capture status may stay \"not yet observed\"`);\n        }\n      })\n      .catch((err) => {\n        warn(`install probe error: ${err instanceof Error ? err.message : String(err)}`);\n      });\n    // EXCLUDE THE LIVE SESSION. On `/reload` Pi emits\n    // `session_shutdown{reason:\"reload\"}` (skipped — see below) THEN\n    // `session_start{reason:\"reload\"}` for the SAME session, which `turn_end`\n    // has already spooled. Filing it here would make the server replay it\n    // (`session_existed` → extraction skipped) and `filed_key` would mark it\n    // done — so every post-reload decision is stored but NEVER extracted. The\n    // replay opportunity is for sessions that are no longer live.\n    const current = (ctx.sessionManager?.getSessionId?.() ?? \"\") as string;\n    setImmediate(() => {\n      logHealth();\n      drain(\"session_start\", { excludeSessionId: current || undefined });\n      // #3515 piece 5: the recovery sweep over Pi's OWN session log. It runs\n      // here because this is the one moment the product is guaranteed to be\n      // alive and idle — and it is a SPAWN, not a scheduler: fires once per\n      // start, detached, and never awaited (Pi awaits `session_start`, so a\n      // sweep in the handler would put a network drain on the startup path).\n      // `excludeSessionId` is load-bearing for the same reason the spool drain\n      // excludes the live session: filing THIS session now would make the\n      // server skip extraction for every turn after this point.\n      sweepStoreSync(current || undefined);\n    });\n  });\n\n  // The cheap capture cadence (#3963): after EVERY turn, extend the spool. This\n  // is what survives an interrupt — the turn is durable before the next one\n  // starts, so a kill can lose at most the in-flight turn.\n  pi.on(\"turn_end\", (_event, ctx) => {\n    spoolSnapshot(ctx as never);\n  });\n\n  // An agent run ENDED: snapshot it, and drain any OTHER session still waiting\n  // in the spool. The live session is deliberately excluded — the server\n  // replays a succeeded `session_id` as a no-op, so filing a still-growing\n  // conversation would freeze the capture at that snapshot and silently drop\n  // every later turn.\n  // #2100: `agent_end` is awaited by Pi too (`agent-session.js` → `await\n  // emit('agent_end')`), and `flushSpool`'s body runs SYNCHRONOUSLY up to its\n  // first `await` — the spool scan, the sort and the first turn read all happen\n  // on the handler's own tick. `setImmediate` is what makes \"this handler never\n  // blocks a turn\" true for that sync half as well (measured: ~23 ms for a\n  // 320-entry spool). The snapshot above stays INLINE — that is the durability\n  // guarantee this handler exists for.\n  pi.on(\"agent_end\", (_event, ctx) => {\n    spoolSnapshot(ctx as never);\n    const current = (ctx.sessionManager?.getSessionId?.() ?? \"\") as string;\n    setImmediate(() => drain(\"agent_end\", { excludeSessionId: current || undefined }));\n  });\n\n  // The session is ending: snapshot the FINAL turns (durability even if Pi is\n  // killed mid-handler), then — for a real end — attempt the filing as the\n  // final flush. On `/reload` the SAME session stays alive, so we spool but do\n  // not file: a premature file would freeze the capture (see `agent_end`).\n  //\n  // #2100: this one IS awaited (Pi runs shutdown handlers before exit), so it is\n  // the pass where the bounds matter most — an unbounded drain here held a\n  // finishing process open for one POST timeout per queued entry.\n  pi.on(\"session_shutdown\", async (event, ctx) => {\n    spoolSnapshot(ctx as never);\n    if (event.reason === \"reload\") return;\n    try {\n      // #2100: THE LIVE SESSION GOES FIRST. `flushSpool` ranks oldest-first, so\n      // a bounded pass over a spool holding >= FLUSH_MAX_ATTEMPTS older entries\n      // never reaches the one session that ONLY shutdown can file — it stays\n      // spooled, which is fine on a persistent box and a LOSS on an ephemeral\n      // cell whose spool dies with it. One `onlySessionId` pass files it first;\n      // the bounded pass then drains the rest as before.\n      const live = (ctx.sessionManager?.getSessionId?.() ?? \"\") as string;\n      const liveSummary = live\n        ? await flushSpool(cfg, {\n            dir: spoolDir,\n            fetchImpl: doFetch,\n            now: clock(),\n            bounds,\n            inFlight,\n            onlySessionId: live,\n          })\n        : null;\n      const summary = await flushSpool(cfg, {\n        dir: spoolDir,\n        fetchImpl: doFetch,\n        now: clock(),\n        bounds,\n        inFlight,\n      });\n      const filedTotal = summary.filed + (liveSummary?.filed ?? 0);\n      if (filedTotal > 0) {\n        log(`captured session(s) → ${cfg.apiUrl} (filed ${filedTotal})`);\n      }\n      if (liveSummary) reportFlush(liveSummary, \"session_shutdown (live session)\", { continuing: false });\n      // No continuation exists on this path — the process is exiting, so the\n      // un-attempted entries are left for the NEXT session, and the line says so.\n      reportFlush(summary, \"session_shutdown\", { continuing: false });\n      // The general pass is the LATER evidence, so it writes last (a quota\n      // refusal it saw must win over the live session's 2xx).\n      // The targeted (live) pass takes NO claim by design, so it cannot CLEAR a\n      // recorded exclusion — and that is now ENFORCED by `applyClaimPolicy` (the fact\n      // is carried forward), not merely implied by this write ORDER: the general pass\n      // below usually overwrites the record afterwards, but a claim-less leg with a\n      // general pass that writes nothing would have left the erasure standing\n      // (#14480 review, F1).\n      if (liveSummary) recordOutcome(liveSummary);\n      recordOutcome(summary);\n    } catch (err) {\n      warn(`capture error: ${err instanceof Error ? err.message : String(err)}`);\n    }\n  });\n}\n"],"file":"/tortoise/pi-hooks/tortoise-capture.ts"}