# Tortoise Hosted API — Docker image for Fly.io
# Uses bookworm variant to avoid Docker Hub anonymous rate limits
FROM python:3.12-slim-bookworm

WORKDIR /app

RUN apt-get update && apt-get install -y --no-install-recommends \
    curl build-essential \
    && rm -rf /var/lib/apt/lists/*

# Layer 0: production dependencies — ONE install command (#494).
# requirements.txt is GENERATED from pyproject.toml → uv.lock
# (`uv export --frozen --no-dev --no-editable`) and pinned with == + hashes
# (pip verifies the hashes at install). Never hand-edit it — the
# deploy-hosted.yml parity gate fails the deploy if it drifts from the lock.
COPY requirements.txt .
RUN pip install --no-cache-dir -r requirements.txt

# CPU-only torch (#7473), its own layer between the lock-pinned requirements and
# the extras: installing the extras' `torch` from PyPI means the CUDA build,
# which declares ~3.2 GB of `nvidia_*` runtime wheels as dependencies, on a host
# that has no GPU (fly.toml sizes it around "torch + sentence-transformers + the
# 90MB model"). `--index-url` keeps it unambiguous — the `+cpu` specifier exists
# only on PyTorch's index, so PyPI's CUDA build cannot shadow it. Placed HERE, on
# nothing but the base image and its own pin, so neither a pyproject.toml edit
# nor a source change invalidates this layer. Keep the version in step with
# uv.lock's `torch` pin (currently 2.13.0) — the point is to swap the BUILD, not
# the release — and with the pin in .github/actions/install-cpu-torch/action.yml,
# which carries the same version plus a guard that fails when the lock moves.
# NOT applied to Dockerfile.selfhost: a self-hosting operator may have a GPU, so
# that image keeps the CUDA-capable default (it still runs on CPU).
RUN pip install --no-cache-dir --index-url https://download.pytorch.org/whl/cpu \
    'torch==2.13.0+cpu'

# Layer 1: bake the embedding model (~130MB bge-small, #1349) — cached
# unless the layer inputs change (pyproject.toml here, or any earlier layer:
# requirements.txt, base image). Source-only changes reuse the cache, making
# deploys incremental.
#
# DOCUMENTED DRIFT DECISION (#494): the [embeddings]/[backups] extras resolve
# against the live index at build time (not the lock), and a future extras
# release COULD pull a main dep past its lock pin (the parity gate compares
# requirements.txt vs the lock — it cannot see inside the built image).
# Accepted for now: sentence-transformers is upper-bounded (<6), the bake is
# cached across deploys, and the extras are deliberately NOT in
# requirements.txt (deploy-slim intent). Lock-pinning the extras too is a
# separate follow-up if the index drift ever bites.
COPY pyproject.toml .
RUN pip install --no-cache-dir '.[embeddings]' '.[backups]' '.[postgres]' \
    # Both HF_HOME and SENTENCE_TRANSFORMERS_HOME must point at /app/model so
    # the build-time download lands EXACTLY where runtime looks: ST uses
    # SENTENCE_TRANSFORMERS_HOME directly as its cache dir
    # (/app/model/models--BAAI--bge-small-en-v1.5), NOT the HF_HOME/hub path
    # (fix #160-followup — image booted with a missing cache and entrypoint
    # exited 1). #1349: bake must match tortoise/embeddings.py EMBEDDING_MODEL
    # (the org-qualified cache dir is models--BAAI--bge-small-en-v1.5).
    && HF_HOME=/app/model SENTENCE_TRANSFORMERS_HOME=/app/model python -c "from sentence_transformers import SentenceTransformer; SentenceTransformer('BAAI/bge-small-en-v1.5', revision='5c38ec7c405ec4b44b94cc5a9bb96e735b38267a')" \
    && test -d /app/model/models--BAAI--bge-small-en-v1.5 \
        || (echo 'FATAL: embedding model cache not at /app/model/models--BAAI--bge-small-en-v1.5' >&2; exit 1)

# #7473: the extras install above is the step that could silently put PyPI's
# CUDA torch back on top of the CPU one (if the extras ever raise their torch
# floor). Separate from the chain above on purpose — that chain's `||` would
# report a misleading model-cache failure for a torch problem.
RUN python -c "import torch; assert torch.version.cuda is None, f'torch {torch.__version__} was built with CUDA - the CPU-only install did not take'"

# Layer 2: source code (fast, no model download — reuses Layer 1 cache)
# --no-deps: package-only install. Dependencies were already installed
# lock-pinned in Layer 0 — this must NOT re-resolve anything (#494).
ARG CACHEBUST=1
COPY tortoise/ tortoise/
# #1929 (G1 fix): the expansion-pack catalog must ship in the image — the
# editable install at /app resolves `default_packs_dir()`'s repo-root leg to
# /app/packs. The sample transcript ships too (documented mine-conversation
# example + `tortoise demo` work in-container, CWD /app).
COPY packs/ packs/
COPY tests/sample_transcript.txt tests/
COPY product/pricing.json product/pricing.json
RUN pip install --no-cache-dir -e . --no-deps

# Embedding model cache — BAAI/bge-small-en-v1.5 is pre-downloaded to
# /app/model at build time (above) so runtime loading is pure local I/O with
# no HuggingFace network access (the runtime download in 69aefae hung in
# Fly's sandboxed network and was reverted in 0da50a0).
ENV HF_HOME=/app/model
ENV SENTENCE_TRANSFORMERS_HOME=/app/model
# Offline mode: never phone home for the model at runtime — the cache is
# baked into the image at build time (code-review P2, #160). Fail fast with
# a clean error if the cache is missing, instead of hanging on the network.
ENV HF_HUB_OFFLINE=1

COPY entrypoint.sh /entrypoint.sh
RUN chmod +x /entrypoint.sh

EXPOSE 8000

ENTRYPOINT ["/entrypoint.sh"]
# `--timeout-graceful-shutdown` (#3087 item 1): uvicorn's default here is to
# wait INDEFINITELY for in-flight requests on SIGTERM, which is longer than
# any kill window and so turns a rolling deploy into a SIGKILL. Bound it below
# fly.toml's `kill_timeout` (30s) so the web server drains first and Fly's
# window covers only the residual.
# NOTE: this bounds uvicorn's OWN drain only. It cannot bound the later
# `threading._shutdown` join on a capture worker already running an extraction
# — that term is bounded by the worker's own deadline, which must stay below
# `kill_timeout` for a mid-write SIGKILL to be avoidable.
CMD ["uvicorn", "tortoise.hosted_api:app", "--host", "0.0.0.0", "--port", "8000", "--timeout-graceful-shutdown", "20"]
