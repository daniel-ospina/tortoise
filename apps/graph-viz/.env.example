# Tortoise — zero-config startup + agent discovery
# Copy to .env and adjust only if you need non-default settings.

# ── Agent discovery ──
# Agents find Tortoise at http://localhost:8000 by default.
# Override if the backend runs on a different host/port:
# TORTOISE_HOST=http://192.168.1.5:8000

# ── FalkorDB connection (defaults work on any new machine) ──
# Start FalkorDB with: docker compose up -d
# Then: python3 server/main.py
FALKORDB_HOST=localhost
FALKORDB_PORT=16379
FALKORDB_PASSWORD=
FALKORDB_GRAPH=tortoise

# ── For connecting to an existing remote instance ──
# FALKORDB_HOST=100.123.148.23
# FALKORDB_PORT=16379  # override default

# ── Test/dev instance ──
# FALKORDB_HOST=127.0.0.1
# FALKORDB_PORT=6379
# FALKORDB_PASSWORD=falkordb
