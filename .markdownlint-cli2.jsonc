{
  "config": {
    "default": true,
    // Disable line-length — prose documents shouldn't enforce hard wraps
    "MD013": false,
    // Allow duplicate headings in sibling sections (common in docs/)
    "MD024": { "siblings_only": true },
    // Allow inline HTML (used for docs annotations, sup/sub, etc.)
    "MD033": false,
    // Don't require first line to be h1 (frontmatter comes first)
    "MD041": false
  }
}
