{
  "services": [
    {
      "id": "twenty-crm",
      "name": "Twenty CRM",
      "icon": "🏢",
      "description": "Self-hosted CRM — contacts, deals, pipeline",
      "check": {"type": "http", "url": "http://localhost:3001"},
      "launch": {"type": "docker-compose", "dir": "~/premise-labs/integrations/crm/twenty"},
      "stop": {"type": "docker-compose-down", "dir": "~/premise-labs/integrations/crm/twenty"},
      "url": "http://localhost:3001"
    },
    {
      "id": "minutes-mcp",
      "name": "Minutes MCP",
      "icon": "🎙️",
      "description": "Meeting recorder — local transcription + diarization",
      "check": {"type": "process", "name": "minutes-mcp"},
      "launch": {"type": "shell", "command": "nohup npx minutes-mcp > /tmp/minutes-mcp.log 2>&1 &"},
      "stop": {"type": "shell", "command": "pkill -f minutes-mcp"}
    },
    {
      "id": "cal-trigger",
      "name": "Cal Trigger",
      "icon": "📅",
      "description": "Auto-records meetings from Apple Calendar",
      "check": {"type": "launchctl", "name": "com.minutes.cal-trigger"},
      "launch": {"type": "shell", "command": "launchctl load ~/Library/LaunchAgents/com.minutes.cal-trigger.plist"},
      "stop": {"type": "shell", "command": "launchctl unload ~/Library/LaunchAgents/com.minutes.cal-trigger.plist"}
    },
    {
      "id": "bridge-watchdog",
      "name": "Bridge Watchdog",
      "icon": "🔗",
      "description": "Auto-pushes meeting notes to CRM + Tortoise",
      "check": {"type": "launchctl", "name": "com.minutes.bridge"},
      "launch": {"type": "shell", "command": "launchctl load ~/Library/LaunchAgents/com.minutes.bridge.plist"},
      "stop": {"type": "shell", "command": "launchctl unload ~/Library/LaunchAgents/com.minutes.bridge.plist"}
    },
    {
      "id": "tortoise",
      "name": "Tortoise",
      "icon": "🐢",
      "description": "Epistemic graph — belief propagation + evidence",
      "check": {"type": "tcp", "host": "localhost", "port": 6379},
      "launch": {"type": "docker-compose", "dir": "~/eldato-epistemic"},
      "stop": {"type": "docker-compose-down", "dir": "~/eldato-epistemic"},
      "url": "redis://localhost:6379"
    }
  ]
}
