# #1148: dashboard build artifacts. (#3768: node_modules was TRACKED until it was
# untracked; it is ignored, not tracked, so a fresh clone installs from the lockfile.)
website/apps/dashboard/node_modules/
website/apps/blog-admin/node_modules/

# #9475: the repo-root `scripts` pointer is MACHINE-LOCAL, ignored, never tracked. A git symlink
# blob cannot hold `$AGENT_INFRA_PATH`, so the committed one pinned the committer's absolute path
# and dangled on every other machine — every documented `scripts/<tool>.sh` died with "No such
# file or directory". Materialise it per machine with `tools/link_agent_infra_scripts.py` (what
# `agent-infra init`/`update` also does); `--check` asserts it.
/scripts
# #4311: the pinned TypeScript toolchain for `website/functions/**` (tsconfig +
# lockfile live here because a file under website/ is staged for public upload).
tools/ts/node_modules/
.venv/

# #3775: the dashboard bundle is GENERATED, not source. Vite builds it from
# `src/` + `public/` (public/ is the hand-authored source vite copies verbatim;
# the only dist-only files are the 3 vite outputs — index.html,
# assets/index-*.js, assets/index-*.css). Tracking it made every dashboard PR
# rewrite a shared binary-ish hot file: 12 of 21 dashboard PR pairs conflicted
# on it. Both deploy paths build immediately before upload
# (website/apps/dashboard/deploy.sh and deploy-pages.yml's deploy-dashboard
# job), and CI builds it for dashboard-js-tests / dashboard-e2e. Path-anchored
# to the dashboard app — it does NOT match website/apps/blog-admin/dist/
# (still tracked) nor any node_modules/**/dist/.
website/apps/dashboard/dist/

# Issue #316 benchmark outputs (regenerated per run)
benchmarks/reports/

# #526: tortoise-client build artifacts (client/build_client.sh output)
dist-client/
client/build/

# #1929: wheel/sdist build artifacts from `python -m build` (root-anchored —
# no nested dist/, e.g. website/apps/blog-admin/dist, may match).
/dist/
/build/


# Issue #1144 retrieval eval outputs (regenerated per run)
tests/eval/retrieval/reports/
