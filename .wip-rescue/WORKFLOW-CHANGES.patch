--- a/.github/workflows/python-ci.yml
+++ b/.github/workflows/python-ci.yml
@@ -469,6 +469,71 @@ jobs:
         # check. Exit 2 = could not measure, which is NOT a pass.
         run: python3 .github/scripts/check-required-set.py
 
+      - name: "Harness single source — operations/orchestrator-harness/ is a POINTER (#8246)"
+        # `operations/orchestrator-harness/` was retired to a pointer at
+        # agent-infra/scripts/orchestrator-harness/ (see its README). Measured 2026-10-19, before
+        # consolidation, the SAME eight files existed in three copies that had all diverged — this
+        # repo's was behind on five and AHEAD on `lane.sh`, and every fix had to be hand-applied in
+        # 3-4 places.
+        #
+        # ⛔ ENFORCED HERE, NOT IN A WORKFLOW OF ITS OWN (review finding — the fail-open). The guard
+        # used to live in `.github/workflows/harness-single-source.yml`, which was wrong on two
+        # counts: (1) a PATH-SCOPED workflow can never be a required context — it does not run at
+        # all on a PR that touches none of its paths, so a `check-success=` gate on it would block
+        # every unrelated merge, which is why it was in neither branch protection nor `.mergify.yml`
+        # and a red on it blocked nothing; and (2) a new workflow also moves
+        # `tools/mergify_config_guard.py`'s gate digest for no enforcement gain. Hosted in THIS job
+        # for the same reason the required-set sync above is: it is a cheap, unconditional,
+        # fail-closed assertion about repo state whose red must block a merge, and it rides the
+        # aggregate (`python-ci-gate`) that is already required. No branch-protection change, no new
+        # required context, no new workflow.
+        #
+        # The NON-VACUITY arms are not decoration: a guard nobody has seen fire is indistinguishable
+        # from a guard that cannot fire, and this one had a real fail-open (a failed `git ls-files`
+        # read as an empty directory and printed "ok"). Each arm below exits 2 today if the guard
+        # regresses to its pre-fix behaviour, so the arms are pinned from both sides.
+        run: |
+          set -euo pipefail
+          # 1) The intended state.
+          bash tools/check-harness-fork.sh operations/orchestrator-harness
+
+          # 2) A planted script is REFUSED (1).
+          printf '#!/bin/sh\n' > operations/orchestrator-harness/lane.sh
+          rc=0
+          bash tools/check-harness-fork.sh operations/orchestrator-harness || rc=$?
+          rm -f operations/orchestrator-harness/lane.sh
+          [ "$rc" -eq 1 ] || { echo "FAIL: a reappearing harness script must exit 1, got $rc"; exit 1; }
+
+          # 3) A missing pointer directory is UNKNOWN (2), not a pass.
+          rc=0
+          bash tools/check-harness-fork.sh /nonexistent-retired-path || rc=$?
+          [ "$rc" -eq 2 ] || { echo "FAIL: an uncheckable location must exit 2, got $rc"; exit 1; }
+
+          # 4) AN UNREADABLE INDEX IS UNKNOWN (2), NOT AN EMPTY DIRECTORY. This is the fail-open the
+          #    review reproduced: `git ls-files … 2>/dev/null` with the exit status ignored printed
+          #    "ok: … a pointer, not a copy" and exited 0 over a directory full of harness scripts.
+          printf 'garbage' > /tmp/harness-guard-index
+          rc=0
+          GIT_INDEX_FILE=/tmp/harness-guard-index bash tools/check-harness-fork.sh \
+            operations/orchestrator-harness || rc=$?
+          [ "$rc" -eq 2 ] || { echo "FAIL: a broken index must exit 2 (never a pass), got $rc"; exit 1; }
+
+          # 5) NON-CANONICAL SPELLINGS of the same CLEAN directory must not read as a fork. Each of
+          #    these exited 1 before the normalisation, naming the deliberately allowed
+          #    `merge-one.sh` as a fork — a false block an operator typing a trailing slash would hit.
+          for d in ./operations/orchestrator-harness operations/orchestrator-harness/ \
+                   "$PWD/operations/orchestrator-harness"; do
+            rc=0
+            bash tools/check-harness-fork.sh "$d" || rc=$?
+            [ "$rc" -eq 0 ] || { echo "FAIL: '$d' is the clean pointer but exited $rc"; exit 1; }
+          done
+
+          # 6) The pointer still names a LIVE location, so a rename of the canonical path is caught
+          #    here instead of by a confused operator. Not a content comparison — tortoise CI has no
+          #    business cloning agent-infra on every PR.
+          grep -q 'agent-infra.*scripts/orchestrator-harness' operations/orchestrator-harness/README.md \
+            || { echo "FAIL: the pointer no longer names agent-infra/scripts/orchestrator-harness/"; exit 1; }
+
   test:
     # #880: split into parallel shards (matrix). #6135: the COUNT is
     # `config/ci-surfaces.yml::fast_shards` and the shape is the selector's
@@ -3240,15 +3305,7 @@ jobs:
           RESULTS="${{ join(needs.*.result, ' ') }}"
           echo "matrix results: $RESULTS"
 
-          # 1. Any declared need that failed or was cancelled blocks the merge.
-          #    `join(needs.*.result)` covers EVERY entry in `needs:`, so no leg
-          #    escapes the red check by accident of ordering or naming.
-          if echo "$RESULTS" | grep -qE 'failure|cancelled'; then
-            echo "::error::matrix leg failed or was cancelled — merge blocked"
-            exit 1
-          fi
-
-          # 2. `skipped` is NOT a pass by default. A docs-only diff legitimately
+          #    `skipped` is NOT a pass by default. A docs-only diff legitimately
           #    skips the matrix, so a leg the SELECTOR declined may skip — but a
           #    shard the selector DID select that reports `skipped` is a lost
           #    shard, and this REQUIRED check must not certify it (#5219).
@@ -3258,16 +3315,29 @@ jobs:
           #    `-` means the leg has no diff gate and must therefore always be
           #    SUCCESS (the surface guard's original explicit assertion, applied
           #    to every always-run leg).
-          while IFS='|' read -r leg result selected; do
-            if [ -z "$leg" ]; then continue; fi
-            if [ "$result" = "success" ]; then continue; fi
-            if [ "$result" = "skipped" ] && [ "$selected" = "false" ]; then
-              echo "  $leg: skipped by the selector (not selected for this diff)"
-              continue
-            fi
-            echo "::error::$leg reported '$result' and the selector did not decline it (selected='$selected') — merge blocked"
-            exit 1
-          done <<'LEGS'
+          #
+          #    THIS TABLE NOW RUNS FIRST. It used to be dead code for the red
+          #    class that dominates: a bare `grep -qE 'failure|cancelled'` bail
+          #    sat ABOVE it and exited first, so a `failure` or `cancelled` leg
+          #    reported only "matrix leg failed or was cancelled — merge blocked"
+          #    and never its name. Narrower than "on every red": the table's own
+          #    line (in the form `::error::$leg reported ...`) was REACHED for a
+          #    `skipped`-while-selected leg and for the empty (#5219) missing-leg
+          #    row, because neither matches that sweep — so those two classes
+          #    were already named pre-fix. The two above were not, and they are
+          #    what an operator sees on a normal red (agent-infra#2148 sibling).
+          #    Measured 2026-10-19: 11 open PRs red on this required check, every
+          #    one reporting only the bare sentence while a red shard sat
+          #    un-named.
+          #
+          #    Fail-closed is preserved and made explicit per class:
+          #      failure          -> red, named
+          #      cancelled        -> red, named (a cancelled leg certifies nothing)
+          #      empty (#5219)    -> red, named (a missing leg is not a pass)
+          #      skipped+selected -> red, named (a lost shard is not a pass)
+          #      skipped+declined -> pass (the selector declined this leg)
+          LEGS_FILE="$(mktemp)"
+          cat > "$LEGS_FILE" <<'LEGS'
           changes|${{ needs.changes.result }}|-
           manifest-integrity|${{ needs.manifest-integrity.result }}|-
           workflow-lint|${{ needs.workflow-lint.result }}|-
@@ -3280,4 +3350,67 @@ jobs:
           test-d14-hosted-api|${{ needs.test-d14-hosted-api.result }}|-
           surface-guard|${{ needs.surface-guard.result }}|-
           LEGS
+
+          # Fail closed by construction, and NAME the leg while doing it: every
+          # row class that is not a pass is recorded and reds the step, reported
+          # as "leg 'X' reported '...'" rather than as a bare "merge blocked".
+          # FAILED_LEGS accumulates NAMES (not a counter) so the summary counts a
+          # leg once even if a copy-pasted duplicate row makes the loop inspect it
+          # twice; the loop itself never skips a red row, so a duplicate cannot
+          # mask one.
+          FAILED_LEGS=""
+          while IFS='|' read -r leg result selected; do
+            if [ -z "$leg" ]; then
+              continue
+            fi
+            case "$result" in
+              success)
+                continue
+                ;;
+              skipped)
+                if [ "$selected" = "false" ]; then
+                  echo "  $leg: skipped by the selector (not selected for this diff)"
+                  continue
+                fi
+                echo "::error::leg '$leg' is SKIPPED although the selector selected it (selected='$selected') — a lost shard is not a pass (#5219); merge blocked"
+                FAILED_LEGS="$FAILED_LEGS$leg "
+                ;;
+              cancelled)
+                echo "::error::leg '$leg' was CANCELLED (selector: selected='$selected') — a cancelled leg certifies nothing; merge blocked"
+                FAILED_LEGS="$FAILED_LEGS$leg "
+                ;;
+              '')
+                echo "::error::leg '$leg' reported NO RESULT (empty) — the #5219 missing-leg shape is not a pass; merge blocked"
+                FAILED_LEGS="$FAILED_LEGS$leg "
+                ;;
+              *)
+                echo "::error::leg '$leg' reported '$result' (selector: selected='$selected') — merge blocked"
+                FAILED_LEGS="$FAILED_LEGS$leg "
+                ;;
+            esac
+          done < "$LEGS_FILE"
+
+          if [ -n "$FAILED_LEGS" ]; then
+            # $FAILED_LEGS is DELIBERATELY unquoted: the word-split is what puts
+            # one leg per line for `sort -u`. `wc` pads its output, so strip the
+            # spaces rather than printing them.
+            FAILED=$(printf '%s\n' $FAILED_LEGS | sort -u | wc -l | tr -d ' ')
+            echo "❌ $FAILED leg(s) did not pass — the ::error:: lines above name each one (GitHub shows at most 10 annotations per step; the log carries them all)"
+            rm -f "$LEGS_FILE"
+            exit 1
+          fi
+
+          # Defence in depth (#5219): the plain sweep over `needs.*.result` is
+          # identity-BLIND — it cannot say WHICH leg — so it is the last resort for
+          # a failing/cancelled result that reached `needs:` with no row at all.
+          # The invariant itself is owned by `.github/scripts/check-required-set.py
+          # ::check_gate_legs` (run inside `manifest-integrity`, whose failure the
+          # loop above already reports by name) and by
+          # `tests/test_required_set_sync.py` at test time; this is the narrowest
+          # third layer, and the only one still reachable if that guard is itself
+          # what drifted (pinned by tests/test_ci_selection.py).
+          if echo "$RESULTS" | grep -qE 'failure|cancelled'; then
+            echo "::error::a need reported failure-or-cancelled but no leg row named it — the leg table above has drifted from needs:; merge blocked"
+            exit 1
+          fi
           echo "✅ every declared leg ran to success, or was declined by the selector"
