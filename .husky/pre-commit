#!/usr/bin/env sh
. "$(dirname -- "$0")/_/husky.sh"

# agent-infra version gate — block commits if .agent-infra-version is behind
AGENT_INFRA_MANIFEST="${AGENT_INFRA_PATH:-}/manifest.json"
VERSION_FILE=".agent-infra-version"

check_version() {
  if [ -z "${AGENT_INFRA_PATH:-}" ]; then
    echo "[agent-infra] AGENT_INFRA_PATH not set — skipping version gate"
    return 0
  fi
  if [ ! -f "$AGENT_INFRA_MANIFEST" ]; then
    echo "[agent-infra] manifest.json not found at $AGENT_INFRA_MANIFEST — skipping version gate"
    return 0
  fi
  if [ ! -f "$VERSION_FILE" ]; then
    echo "[agent-infra] .agent-infra-version not found — skipping version gate (first time?)"
    return 0
  fi

  PINNED=$(cat "$VERSION_FILE" | tr -d '[:space:]')
  CURRENT=$(node -e "console.log(require('$AGENT_INFRA_MANIFEST').version)" | tr -d '[:space:]')

  if [ "$PINNED" != "$CURRENT" ]; then
    echo ""
    echo "⛔ [agent-infra] Version mismatch!"
    echo "   Pinned (.agent-infra-version): $PINNED"
    echo "   Current (manifest.json):       $CURRENT"
    echo "   Run: cd $AGENT_INFRA_PATH && node bin/agent-infra.js update"
    echo "   Or update .agent-infra-version to match."
    echo ""
    exit 1
  fi
  echo "[agent-infra] Version gate: $CURRENT ✓"
}

check_version

# #841 — builtin-writer SIGPIPE false-negative guard (agent-infra's). `printf`/`echo`
# piped into a quiet `grep` under `pipefail` can report "not found" for a match that IS
# present (the writer takes SIGPIPE once grep exits early on a multiline payload),
# silently turning a fail-closed check into a pass. Offline and fast.
#
# This is the DEPLOYMENT half of the gap recorded on tortoise#7588: the guard existed and
# was wired in agent-infra, but was never invoked HERE — so the sites it covers shipped.
# It does NOT close #7588: that issue's own sites (`printf | sed | head -n1` in
# `.github/scripts/availability-liveness.sh`) are a different producer/consumer shape the
# guard does not match. Refs, not Closes.
#
# Two things this wiring needs that agent-infra's own hook does not:
#   · `--dirs` — the guard's default scan set is agent-infra's layout, and `scripts/`
#     here IS the symlink back to agent-infra, so without the flag it scans the wrong
#     tree and prints a clean run. That flag ships in agent-infra#1643; this hook
#     therefore lands AFTER it (until then the guard exits 2 on an unknown argument).
#   · a missing guard WARNS instead of skipping silently. A silent skip is the very
#     failure this guard exists to catch (#6937 P2-3), and `scripts/` is a machine-local
#     symlink that can dangle; the `sigpipe-guard` CI job runs it unconditionally.
if [ -f scripts/check-no-sigpipe-grep.sh ]; then
  bash scripts/check-no-sigpipe-grep.sh \
    --dirs '.github/scripts .github/actions .husky tools .ci-checks client integrations tortoise supabase docs entrypoint.sh' || exit 1
else
  echo "[sigpipe-guard] scripts/check-no-sigpipe-grep.sh not found — NOT checked locally." >&2
  echo "   Fix: set AGENT_INFRA_PATH and re-link scripts/. CI runs this guard regardless" >&2
  echo "   (job: sigpipe-guard), so this warning is not a pass for the committed tree." >&2
fi

# Test-surface auto-registration (#1429) — new tests/test_*.py must be in
# config/ci-surfaces.yml or they silently drop out of CI selection (the
# #1262 drift trap, which recurred 4× in a week). Auto-register at COMMIT
# time so the drift never reaches main; the CI integrity gate stays as the
# safety net for squash/--no-verify paths. Default surface is core — review
# the output; move the file in the manifest if another surface fits better
# (the shared/unknown-path rules still expand selection to the full matrix
# for broad changes). Only triggers on STAGED tests/ changes, and only
# stages the manifest when it actually changed.
#
# #5128: `tools/ci_selection.py` now carries the inline >=3.12 interpreter
# guard, so bare `python3` (3.9 via Apple CLT on this host) would REFUSE
# instead of running — and the `2>/dev/null` on the dry-run below would swallow
# that refusal and silently skip the #1429 test-surface auto-registration. So
# resolve and VALIDATE the interpreter ONCE, up front: the worktree's venv when
# it is there, else `uv run` (which finds the pinned 3.12). Nothing is silent —
# if neither path yields >=3.12 the registration FAILS LOUDLY instead of being
# skipped (that silent skip is the exact bug this hook exists to prevent), and
# the dry-run's OWN failure fails loudly too (#6937 P2-3). Mirrors
# tools/install-reaper-schedule.sh's $REPO/.venv/bin/python resolution.
PY_TOOL=""
if [ -x .venv/bin/python ] && .venv/bin/python -c 'import sys; sys.exit(0 if sys.version_info >= (3, 12) else 1)' 2>/dev/null; then
  PY_TOOL="venv"
elif command -v uv >/dev/null 2>&1 && uv run python -c 'import sys; sys.exit(0 if sys.version_info >= (3, 12) else 1)' 2>/dev/null; then
  PY_TOOL="uv"
fi
py_tool() {
  if [ "$PY_TOOL" = "venv" ]; then
    .venv/bin/python "$@"
  else
    uv run python "$@"
  fi
}
if git diff --cached --name-only | grep -qE '^tests/.*\.py$'; then
  if [ -z "$PY_TOOL" ]; then
    echo "⛔ [hooks] no Python >=3.12 interpreter (.venv/bin/python or uv run python)." >&2
    echo "   The #1429 test-surface auto-registration cannot run, and skipping it" >&2
    echo "   silently is the drift trap this hook exists to close. Install uv (or" >&2
    echo "   create .venv with >=3.12) and re-run the commit." >&2
    exit 1
  fi
  # #6937 P2-3: capture the tool's OWN exit status before matching the output.
  # Piping straight into `grep` made the `if` take GREP's status, so any dry-run
  # FAILURE (a YAML error, a crash, a refusal) was indistinguishable from the
  # benign "nothing to register" non-match: stderr was in the 2>/dev/null
  # bucket, stdout was empty, grep found nothing, the `if` was skipped, and the
  # hook still PASSED with the #1429 registration silently dropped. The up-front
  # interpreter validation above closes the refusal-swallowed case only.
  if ! DRY_RUN="$(py_tool tools/ci_selection.py --register --dry-run 2>&1)"; then
    echo "⛔ [hooks] tools/ci_selection.py --register --dry-run FAILED — the #1429" >&2
    echo "   test-surface auto-registration did not run, and a failed dry-run must" >&2
    echo "   never read as 'nothing to register'. Output follows:" >&2
    printf '%s\n' "$DRY_RUN" >&2
    exit 1
  fi
  # POSIX sh: no here-string, so match with `case` on the captured value (the
  # remedy the #841 guard documents for `.husky/` hooks). A pipeline into a
  # quiet grep takes the ELSE branch under pipefail when the producer keeps
  # writing — this hook's own failure mode, silently skipping the registration.
  WOULD_REGISTER=0
  case "$DRY_RUN" in *"would register"*) WOULD_REGISTER=1 ;; esac
  if [ "$WOULD_REGISTER" -eq 1 ]; then
    # #6937 P2-3 (review round 1): the dry-run was only HALF the hole. The real
    # registration and its staging sat unguarded in this same block, so a
    # `--register` failure (or a failed `git add`) still let the commit through
    # with the #1429 surface half-written or un-staged — the SAME swallow, one
    # line lower. `py_tool` is not `set -e`-protected here, so both are checked.
    if ! py_tool tools/ci_selection.py --register; then
      echo "⛔ [hooks] tools/ci_selection.py --register FAILED — config/ci-surfaces.yml" >&2
      echo "   was NOT updated (or was left half-written). Committing now would ship a" >&2
      echo "   test surface that disagrees with the tests on disk (#1429)." >&2
      exit 1
    fi
    if ! git add config/ci-surfaces.yml; then
      echo "⛔ [hooks] could not stage config/ci-surfaces.yml after --register; the" >&2
      echo "   registration exists on disk but not in this commit (#1429)." >&2
      exit 1
    fi
  fi
fi

# AGENTS.md materialization gate (#600): stage-guard BEFORE spawning the
# checker — one cheap git call on commits that don't touch AGENTS.md; the
# full check runs only when AGENTS.md is staged. Resolve checker via
# scripts/ symlink OR $AGENT_INFRA_PATH (repos whose real scripts/ dir
# lacks it, e.g. swarm).
if git diff --cached --name-only -- AGENTS.md 2>/dev/null | grep -q .; then
  CHECKER="scripts/check-agents-materialized.sh"
  if [ ! -f "$CHECKER" ] && [ -n "${AGENT_INFRA_PATH:-}" ] && [ -f "$AGENT_INFRA_PATH/scripts/check-agents-materialized.sh" ]; then
    CHECKER="$AGENT_INFRA_PATH/scripts/check-agents-materialized.sh"
  fi
  if [ -f "$CHECKER" ]; then
    bash "$CHECKER" || exit 1
  fi
fi

# Only run lint-staged if this is a Node.js project (has package.json)
if [ -f package.json ] && command -v npx >/dev/null 2>&1; then
  npx lint-staged
fi
