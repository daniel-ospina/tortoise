# Twenty CRM Configuration
# Copy this to .env and fill in your values

# API Key — get from Twenty UI: Settings → Developers → API Keys
TWENTY_API_KEY=

# Database credentials (required — no defaults for security)
PG_USER=twenty
PG_PASSWORD=
REDIS_PASSWORD=

# App secret for JWT signing and session encryption
# Generate with: openssl rand -hex 32
APP_SECRET=

# Twenty server URL (localhost by default)
TWENTY_BASE_URL=http://localhost:3001

# Twenty REST API base path
TWENTY_REST_PATH=/rest

# Review queue path (unmatched speakers queued here)
REVIEW_QUEUE_PATH=~/.minutes/review_queue.json
